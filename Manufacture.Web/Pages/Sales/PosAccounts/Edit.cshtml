@page "{id:int?}"
@model Manufacture.Pages.Sales.PosAccounts.EditModel
@{
    ViewData["Title"] = $"Manage Supermarket: {Model.Account.AccountName}";
    var acc = Model.Account;
    var utilPercent = acc.CreditLimit > 0 ? (acc.CurrentOutstandingCredit / acc.CreditLimit) * 100 : 0;
    var isHighRisk = utilPercent >= 80;
    var availableCredit = Math.Max(0m, acc.CreditLimit - acc.CurrentOutstandingCredit);
}

<div class="space-y-6 w-full pb-12">
    <!-- Header & Breadcrumbs -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="breadcrumbs text-sm mb-1 text-base-content/70">
                <ul>
                    <li><a asp-page="/Sales/Index" class="hover:text-primary">Sales & POS</a></li>
                    <li><a asp-page="/Sales/PosAccounts/Index" class="hover:text-primary">Supermarket Accounts</a></li>
                    <li class="font-semibold text-base-content">Manage Account</li>
                </ul>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <h1 class="text-3xl font-extrabold tracking-tight text-base-content flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    @acc.AccountName
                </h1>
                @if (acc.IsActive)
                {
                    <span class="badge badge-success badge-sm font-semibold">Active Supermarket</span>
                }
                else
                {
                    <span class="badge badge-error badge-sm font-semibold">Suspended Account</span>
                }
                @if (isHighRisk)
                {
                    <span class="badge badge-error badge-outline badge-sm font-bold animate-pulse">High Credit Risk</span>
                }
            </div>
            <p class="text-sm text-base-content/70 mt-1">
                Edit store details, reassign sales representatives, update credit limits, and adjust institutional contracted SKU prices.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a asp-page="/Sales/PosAccounts/Supply" asp-route-id="@acc.Id" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Direct Supply
            </a>
            <a asp-page="/Sales/PosAccounts/Payment" asp-route-id="@acc.Id" class="btn btn-outline btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Pay Credit
            </a>
            <a asp-page="/Sales/PosAccounts/Index" class="btn btn-outline btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                Back to Directory
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@Model.SuccessMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>@Model.ErrorMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left Column: Manage Details & Custom Pricing Matrix (8 Cols) -->
        <div class="lg:col-span-8 space-y-6">

            <!-- Supermarket Store Details Form -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
                <div class="card-body p-6 space-y-5">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </div>
                            <span>Edit Supermarket Store & Account Profile</span>
                        </div>
                        <span class="text-xs text-base-content/50 font-mono">Account #@acc.Id</span>
                    </div>

                    <form method="post" asp-page-handler="SaveAccount" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Account.Id" />
                        <input type="hidden" asp-for="Account.CustomerId" />
                        <input type="hidden" asp-for="Account.CurrentOutstandingCredit" />

                        <!-- Store Name -->
                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Supermarket / Company Name *</span></label>
                            <input type="text" asp-for="Account.AccountName" class="input input-bordered input-sm w-full font-bold" required placeholder="e.g. Hubmart Stores Lekki" />
                            <span class="text-[11px] text-base-content/50 mt-1">Updates both the POS supermarket profile and linked customer ledger record.</span>
                        </div>

                        <!-- Contact & Phone -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="form-control">
                                <label class="label"><span class="label-text font-semibold text-xs">Contact Person / Store Manager</span></label>
                                <input type="text" asp-for="Account.ContactPerson" class="input input-bordered input-sm w-full" placeholder="e.g. Mrs. Ngozi Okafor" />
                            </div>
                            <div class="form-control">
                                <label class="label"><span class="label-text font-semibold text-xs">Phone Number</span></label>
                                <input type="text" asp-for="Account.PhoneNumber" class="input input-bordered input-sm w-full font-mono" placeholder="+234 803 111 2200" />
                            </div>
                        </div>

                        <!-- Physical Address -->
                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Physical Delivery Address</span></label>
                            <input type="text" asp-for="Account.Address" class="input input-bordered input-sm w-full" placeholder="Plot 14 Admiralty Way, Lekki Phase 1, Lagos" />
                            <span class="text-[11px] text-base-content/50 mt-1">Location used by sales van drivers on daily dispatch routes.</span>
                        </div>

                        <!-- Credit Limit & Terms -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="form-control">
                                <label class="label"><span class="label-text font-semibold text-xs">Approved Credit Facility Limit (₦) *</span></label>
                                <input type="number" step="5000" min="0" asp-for="Account.CreditLimit" class="input input-bordered input-sm w-full font-mono font-bold text-primary" required />
                                <span class="text-[11px] text-base-content/50 mt-1">Maximum outstanding goods allowed before sales hold.</span>
                            </div>

                            <div class="form-control">
                                <label class="label"><span class="label-text font-semibold text-xs">Payment Settlement Terms</span></label>
                                <select asp-for="Account.PaymentTerms" class="select select-bordered select-sm w-full font-medium">
                                    <option value="Net 7 Days">Net 7 Days</option>
                                    <option value="Net 14 Days">Net 14 Days</option>
                                    <option value="Net 15 Days">Net 15 Days</option>
                                    <option value="Net 30 Days">Net 30 Days</option>
                                    <option value="Payment on Next Delivery">Payment on Next Delivery</option>
                                </select>
                            </div>
                        </div>

                        <!-- Rep Assignment & Operational Status -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="form-control">
                                <label class="label"><span class="label-text font-semibold text-xs">Assigned Route Sales Representative *</span></label>
                                <select asp-for="Account.AssignedRepId" class="select select-bordered select-sm w-full">
                                    @foreach (var rep in Model.SalesReps)
                                    {
                                        <option value="@rep.Id">@rep.FullName (@rep.VehicleRegistration - @rep.RouteName)</option>
                                    }
                                </select>
                                <span class="text-[11px] text-base-content/50 mt-1">The sales rep whose van delivers and oversees this supermarket.</span>
                            </div>

                            <div class="form-control">
                                <label class="label"><span class="label-text font-semibold text-xs">Account Status</span></label>
                                <select asp-for="Account.IsActive" class="select select-bordered select-sm w-full font-bold">
                                    <option value="true">Active & Ready For Route Delivery</option>
                                    <option value="false">Suspended / Inactive</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-4 border-t border-base-200">
                            <a asp-page="/Sales/PosAccounts/Index" class="btn btn-ghost btn-sm">Discard</a>
                            <button type="submit" class="btn btn-primary btn-sm px-6">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Save Supermarket Details
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Custom Agreed SKU Pricing Matrix -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
                <div class="card-body p-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-base-200 pb-3">
                        <div>
                            <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                                <div class="w-8 h-8 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center font-bold">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                    </svg>
                                </div>
                                <span>Contracted Custom Agreed SKU Pricing Matrix</span>
                            </div>
                            <p class="text-xs text-base-content/60 mt-1">
                                When this store is supplied on route, these negotiated rates automatically override the master catalog price. Leave empty or 0 for standard price.
                            </p>
                        </div>
                        <span class="badge badge-secondary badge-sm font-semibold">
                            @acc.CustomAgreedPrices.Count Custom Overrides
                        </span>
                    </div>

                    <form method="post" asp-page-handler="SavePrices">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="accountId" value="@acc.Id" />

                        <div class="overflow-x-auto">
                            <table class="table table-sm w-full">
                                <thead>
                                    <tr class="bg-base-200/50 text-base-content text-xs">
                                        <th>SKU Product</th>
                                        <th>Category</th>
                                        <th class="text-right">Standard Master Price</th>
                                        <th class="text-right w-44">Agreed Unit Price (₦)</th>
                                        <th class="text-right">Margin / Discount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sku in Model.CatalogSkus)
                                    {
                                        var hasCustom = acc.CustomAgreedPrices.TryGetValue(sku.Id, out var customPrice);
                                        var activePrice = hasCustom ? customPrice : sku.Price;
                                        var diff = sku.Price - activePrice;
                                        var discountPct = sku.Price > 0 ? (diff / sku.Price) * 100m : 0m;

                                        <tr class="hover:bg-base-200/30">
                                            <td>
                                                <div class="font-bold text-sm text-base-content">@sku.Name</div>
                                                <div class="text-[11px] font-mono text-base-content/50">@sku.Code</div>
                                            </td>
                                            <td>
                                                <span class="badge badge-ghost badge-sm font-semibold">@sku.Category</span>
                                            </td>
                                            <td class="text-right font-mono text-sm font-medium">
                                                ₦@sku.Price.ToString("N2")
                                            </td>
                                            <td class="text-right">
                                                <div class="flex items-center justify-end gap-1">
                                                    <span class="text-xs font-mono text-base-content/50">₦</span>
                                                    <input type="number" 
                                                           step="0.01" 
                                                           min="0" 
                                                           name="prices[@sku.Id]" 
                                                           value="@(hasCustom ? customPrice.ToString("F2") : "")" 
                                                           placeholder="@sku.Price.ToString("F2")" 
                                                           class="input input-bordered input-xs w-28 text-right font-mono font-bold text-primary focus:border-primary" />
                                                </div>
                                            </td>
                                            <td class="text-right">
                                                @if (hasCustom && diff > 0)
                                                {
                                                    <span class="badge badge-success badge-sm font-semibold text-xs">
                                                        -₦@diff.ToString("N0") (@discountPct.ToString("F1")%)
                                                    </span>
                                                }
                                                else if (hasCustom && diff < 0)
                                                {
                                                    <span class="badge badge-warning badge-sm font-semibold text-xs">
                                                        +₦@Math.Abs(diff).ToString("N0") (+@Math.Abs(discountPct).ToString("F1")%)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-ghost badge-sm text-xs text-base-content/60">Standard</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="flex items-center justify-end gap-3 pt-4 border-t border-base-200 mt-4">
                            <a asp-page="/Sales/PosAccounts/Edit" asp-route-id="@acc.Id" class="btn btn-ghost btn-sm">Discard</a>
                            <button type="submit" class="btn btn-secondary btn-sm px-6">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                                Save Contracted SKU Pricing
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>

        <!-- Right Column: Credit Headroom, Status & Rep Details (4 Cols) -->
        <div class="lg:col-span-4 space-y-6">

            <!-- Credit Facility Snapshot Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <h3 class="font-bold text-sm text-base-content flex items-center gap-2">
                        <div class="w-7 h-7 rounded-lg bg-info/10 text-info flex items-center justify-center font-bold">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <span>Credit Facility Status</span>
                    </h3>
                    <span class="badge @(isHighRisk ? "badge-error" : "badge-success") badge-sm font-semibold">
                        @(isHighRisk ? "High Risk" : "Healthy")
                    </span>
                </div>

                <div class="space-y-3">
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-base-content/70">Approved Credit Limit:</span>
                        <span class="font-bold font-mono text-base-content">₦@acc.CreditLimit.ToString("N0")</span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-base-content/70">Current Outstanding Credit:</span>
                        <span class="font-bold font-mono text-error">₦@acc.CurrentOutstandingCredit.ToString("N0")</span>
                    </div>
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-base-content/70">Available Credit Headroom:</span>
                        <span class="font-bold font-mono text-success">₦@availableCredit.ToString("N0")</span>
                    </div>

                    <div class="pt-2 border-t border-base-200">
                        <div class="flex justify-between text-xs text-base-content/60 mb-1">
                            <span>Credit Utilization</span>
                            <span class="font-bold @(isHighRisk ? "text-error" : "text-base-content")">@utilPercent.ToString("F1")%</span>
                        </div>
                        <progress class="progress @(isHighRisk ? "progress-error" : (utilPercent > 60 ? "progress-warning" : "progress-primary")) w-full" value="@utilPercent" max="100"></progress>
                    </div>

                    @if (isHighRisk)
                    {
                        <div class="p-3 bg-error/10 border border-error/20 rounded-xl text-xs text-error space-y-1">
                            <strong class="font-bold flex items-center gap-1">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                                Over 80% Credit Utilized
                            </strong>
                            <p class="text-[11px] leading-tight">
                                Recommended to record a payment credit before approving major new route deliveries.
                            </p>
                        </div>
                    }
                </div>

                <div class="grid grid-cols-2 gap-2 pt-2">
                    <a asp-page="/Sales/PosAccounts/Supply" asp-route-id="@acc.Id" class="btn btn-primary btn-sm text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Direct Supply
                    </a>
                    <a asp-page="/Sales/PosAccounts/Payment" asp-route-id="@acc.Id" class="btn btn-outline btn-sm text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        Pay Credit
                    </a>
                </div>
            </div>

            <!-- Quick Status Toggle Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-3">
                <h3 class="font-bold text-sm text-base-content flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-warning/10 text-warning flex items-center justify-center font-bold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                    </div>
                    <span>Account Status Action</span>
                </h3>

                <p class="text-xs text-base-content/70 leading-relaxed">
                    @if (acc.IsActive)
                    {
                        <span>This account is active and will appear on sales dispatch route sheets for store delivery orders.</span>
                    }
                    else
                    {
                        <span>This account is currently suspended. Dispatches and credit billing are temporarily disabled.</span>
                    }
                </p>

                <form method="post" asp-page-handler="ToggleStatus">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@acc.Id" />
                    @if (acc.IsActive)
                    {
                        <button type="submit" class="btn btn-warning btn-sm w-full gap-2 font-semibold">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                            </svg>
                            Suspend Supermarket Account
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-success btn-sm w-full gap-2 font-semibold text-success-content">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Re-activate Supermarket Account
                        </button>
                    }
                </form>
            </div>

            <!-- Dedicated Route Sales Rep Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-3">
                <h3 class="font-bold text-sm text-base-content flex items-center gap-2">
                    <div class="w-7 h-7 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                    </div>
                    <span>Assigned Sales Representative</span>
                </h3>

                @if (Model.AssignedRep != null)
                {
                    <div class="bg-base-200/50 p-3.5 rounded-xl space-y-2 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="text-base-content/60">Representative:</span>
                            <span class="font-bold text-base-content">@Model.AssignedRep.FullName</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-base-content/60">Assigned Route:</span>
                            <span class="font-semibold text-primary">@Model.AssignedRep.RouteName</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-base-content/60">Vehicle Van:</span>
                            <span class="font-mono text-base-content">@Model.AssignedRep.VehicleRegistration</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-base-content/60">Phone Contact:</span>
                            <span class="font-mono text-base-content">@Model.AssignedRep.PhoneNumber</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-base-content/60">Product Lines:</span>
                            <span class="font-semibold text-secondary">@Model.AssignedRep.ProductFocus</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-xs text-base-content/60 italic">
                        No sales rep assigned yet. Choose a rep in the form on the left.
                    </div>
                }
            </div>

            <!-- Quick Navigation Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-3">
                <h3 class="font-bold text-sm text-base-content">Quick Navigation</h3>
                <div class="space-y-2">
                    <a asp-page="/Sales/PosAccounts/Index" class="btn btn-outline btn-sm w-full justify-start text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                        </svg>
                        All Supermarkets & Depots
                    </a>
                    <a asp-page="/Sales/Dispatch/Index" class="btn btn-outline btn-sm w-full justify-start text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        Daily Dispatch Bay
                    </a>
                    <a asp-page="/Sales/Index" class="btn btn-outline btn-sm w-full justify-start text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        Sales & POS Hub
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
