@page
@model Manufacture.Pages.Sales.PosAccounts.CreateModel
@{
    ViewData["Title"] = "Register New Supermarket Account";
}

<div class="space-y-6 w-full pb-12">
    <!-- Header & Breadcrumbs -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="breadcrumbs text-sm mb-1 text-base-content/70">
                <ul>
                    <li><a asp-page="/Sales/Index" class="hover:text-primary">Sales & POS</a></li>
                    <li><a asp-page="/Sales/PosAccounts/Index" class="hover:text-primary">Supermarket Accounts</a></li>
                    <li class="font-semibold text-base-content">Register New Supermarket</li>
                </ul>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-base-content flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                Register New Supermarket Account
            </h1>
            <p class="text-sm text-base-content/70">
                Set up an institutional client profile, assign credit limits and payment terms, and designate a dedicated route sales representative.
            </p>
        </div>
        <div>
            <a asp-page="/Sales/PosAccounts/Index" class="btn btn-sm btn-outline gap-1.5 font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Back to Supermarkets
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Model.ErrorMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    <!-- 2-Column Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        @Html.AntiForgeryToken()

        <!-- Left Column: Primary Fields (8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            
            <!-- Store Profile & Contact Details -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
                <div class="card-body p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-sm font-bold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                            </div>
                            <span>Supermarket Entity & Location Details</span>
                        </div>
                        <span class="badge badge-primary badge-sm font-semibold">Step 1: Entity</span>
                    </div>

                    <div class="form-control">
                        <label class="label"><span class="label-text font-semibold text-xs">Supermarket / Company Name *</span></label>
                        <input type="text" asp-for="Account.AccountName" class="input input-bordered input-sm w-full font-bold" required placeholder="e.g. Hubmart Stores Lekki Phase 1" />
                        <span class="text-[11px] text-base-content/50 mt-1">Official store, depot, or customer trading name.</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Contact Person / Store Manager</span></label>
                            <input type="text" asp-for="Account.ContactPerson" class="input input-bordered input-sm w-full" placeholder="e.g. Mrs. Ngozi Okafor" />
                        </div>
                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Phone Number</span></label>
                            <input type="text" asp-for="Account.PhoneNumber" class="input input-bordered input-sm w-full font-mono" placeholder="+234 803 111 2200" />
                        </div>
                    </div>

                    <div class="form-control">
                        <label class="label"><span class="label-text font-semibold text-xs">Physical Store Address</span></label>
                        <input type="text" asp-for="Account.Address" class="input input-bordered input-sm w-full" placeholder="e.g. Plot 14 Admiralty Way, Lekki Phase 1, Lagos" />
                        <span class="text-[11px] text-base-content/50 mt-1">Used by van drivers for dispatch navigation and proof of delivery waybills.</span>
                    </div>
                </div>
            </div>

            <!-- Commercial Credit & Territory Assignment -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
                <div class="card-body p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-8 h-8 rounded-lg bg-info/10 text-info flex items-center justify-center text-sm font-bold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
                            </div>
                            <span>Credit Facility & Dedicated Sales Representative</span>
                        </div>
                        <span class="badge badge-info badge-sm font-semibold">Step 2: Credit Terms</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Approved Credit Limit (₦) *</span></label>
                            <input type="number" step="5000" min="0" asp-for="Account.CreditLimit" class="input input-bordered input-sm w-full font-mono font-bold text-primary" required />
                            <span class="text-[11px] text-base-content/50 mt-1">Maximum outstanding goods allowed before sales hold.</span>
                        </div>

                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Payment Settlement Terms</span></label>
                            <select asp-for="Account.PaymentTerms" class="select select-bordered select-sm w-full font-medium">
                                <option value="Net 7 Days">Net 7 Days</option>
                                <option value="Net 14 Days">Net 14 Days</option>
                                <option value="Net 15 Days" selected>Net 15 Days</option>
                                <option value="Net 30 Days">Net 30 Days</option>
                                <option value="Payment on Next Delivery">Payment on Next Delivery</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Assigned Route Sales Rep *</span></label>
                            <select asp-for="Account.AssignedRepId" class="select select-bordered select-sm w-full">
                                @foreach (var rep in Model.SalesReps)
                                {
                                    <option value="@rep.Id">@rep.FullName (@rep.VehicleRegistration - @rep.RouteName)</option>
                                }
                            </select>
                            <span class="text-[11px] text-base-content/50 mt-1">Dedicated sales van delivering orders to this supermarket.</span>
                        </div>

                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Operational Status</span></label>
                            <select asp-for="Account.IsActive" class="select select-bordered select-sm w-full font-bold">
                                <option value="true" selected>Active & Ready For Route Delivery</option>
                                <option value="false">Suspended / Inactive</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Initial Contracted Pricing (Optional Custom Rates) -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
                <div class="card-body p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div>
                            <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                                <div class="w-8 h-8 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center text-sm font-bold">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                                </div>
                                <span>Initial Agreed Custom SKU Pricing (Optional Overrides)</span>
                            </div>
                            <p class="text-xs text-base-content/60 mt-1">Leave blank to use the master catalog price. Enter a custom price to contract a discounted unit rate for this supermarket.</p>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="table table-sm w-full">
                            <thead>
                                <tr class="bg-base-200/50 text-base-content text-xs">
                                    <th>SKU Product</th>
                                    <th>Category</th>
                                    <th class="text-right">Master Catalog Price</th>
                                    <th class="text-right w-40">Contracted Rate (₦)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sku in Model.CatalogSkus)
                                {
                                    <tr class="hover:bg-base-200/30">
                                        <td>
                                            <div class="font-bold text-sm text-base-content">@sku.Name</div>
                                            <div class="text-[11px] font-mono text-base-content/50">@sku.Code</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-ghost badge-sm font-semibold">@sku.Category</span>
                                        </td>
                                        <td class="text-right font-mono text-xs font-semibold">
                                            ₦@sku.Price.ToString("N2")
                                        </td>
                                        <td class="text-right">
                                            <div class="flex items-center justify-end gap-1">
                                                <span class="text-xs font-mono opacity-50">₦</span>
                                                <input type="number" 
                                                       step="0.01" 
                                                       min="0" 
                                                       name="InitialPrices[@sku.Id]" 
                                                       placeholder="@sku.Price.ToString("F2")" 
                                                       class="input input-bordered input-xs w-28 text-right font-mono font-bold text-primary focus:border-primary" />
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="flex items-center justify-end gap-3 pt-4 border-t border-base-200">
                        <a asp-page="/Sales/PosAccounts/Index" class="btn btn-ghost btn-sm">Discard</a>
                        <button type="submit" class="btn btn-primary btn-sm px-6">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            Register Supermarket Account
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Info & Operational Notes (4 Cols) -->
        <div class="lg:col-span-4 space-y-6">
            
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-4">
                <h3 class="font-bold text-sm text-base-content flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    B2B Institutional Supply Policies
                </h3>
                <p class="text-xs text-base-content/70 leading-relaxed">
                    Supermarkets and wholesale depot accounts operate under credit facilities tied to route sales representatives:
                </p>

                <div class="space-y-3 text-xs">
                    <div class="p-3 bg-base-200/50 rounded-xl space-y-1">
                        <strong class="text-base-content font-bold">1. Contracted SKU Overrides</strong>
                        <p class="text-base-content/70">
                            Custom agreed prices take precedence over standard master prices whenever the supermarket is supplied by a sales rep or invoiced.
                        </p>
                    </div>

                    <div class="p-3 bg-base-200/50 rounded-xl space-y-1">
                        <strong class="text-base-content font-bold">2. Credit Facility Monitoring</strong>
                        <p class="text-base-content/70">
                            Accounts exceeding 80% utilization will trigger automated risk badges on route sheets to prevent bad debt exposure.
                        </p>
                    </div>

                    <div class="p-3 bg-base-200/50 rounded-xl space-y-1">
                        <strong class="text-base-content font-bold">3. Reassignment Flexibility</strong>
                        <p class="text-base-content/70">
                            You can easily reassign territories or edit store details anytime if phone, address, or manager details change.
                        </p>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-3">
                <h3 class="font-bold text-sm text-base-content">Navigation</h3>
                <div class="space-y-2">
                    <a asp-page="/Sales/PosAccounts/Index" class="btn btn-outline btn-sm w-full justify-start text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
                        All Supermarkets & Depots
                    </a>
                    <a asp-page="/Sales/Index" class="btn btn-outline btn-sm w-full justify-start text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                        Sales & POS Hub
                    </a>
                </div>
            </div>

        </div>
    </form>
</div>
