@page
@model Manufacture.Pages.Sales.PosAccounts.IndexModel
@{
    ViewData["Title"] = "Supermarket POS Accounts & Custom Price Directory";
    var sel = Model.SelectedAccount;
}

<div class="space-y-6 w-full pb-12">
    <!-- Header & Breadcrumbs -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="breadcrumbs text-sm mb-1 text-base-content/70">
                <ul>
                    <li><a asp-page="/Sales/Index" class="hover:text-primary">Sales & POS</a></li>
                    <li>Supermarket Accounts</li>
                    <li class="font-semibold text-base-content">Custom Pricing & Credit Directory</li>
                </ul>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-base-content flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                Supermarket POS Accounts & Pricing
            </h1>
            <p class="text-sm text-base-content/70">
                Manage B2B supermarket accounts, agreed institutional SKU pricing contracts, and credit balance reconciliation.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a asp-page="/Sales/Dispatch/Index" class="btn btn-outline btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                Daily Dispatch Bay
            </a>
            <a asp-page="/Sales/Reconciliation/Index" class="btn btn-outline btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                Cash & Stock Reconciliation
            </a>
            <a asp-page="./Create" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                New Supermarket Account
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Model.SuccessMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Model.ErrorMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    <!-- High-Level Metric Stats Cards -->
    @* <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">Active Accounts</div>
                    <div class="text-2xl font-bold text-base-content mt-1">@Model.Accounts.Count</div>
                </div>
                <div class="p-3 bg-primary/10 text-primary rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                </div>
            </div>
            <div class="text-xs text-base-content/60 mt-2">Supplied by @Model.SalesReps.Count dedicated reps</div>
        </div>

        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">Total Outstanding Credit</div>
                    <div class="text-2xl font-bold text-error mt-1">₦@Model.TotalCreditOutstanding.ToString("N0")</div>
                </div>
                <div class="p-3 bg-error/10 text-error rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
            </div>
            <div class="text-xs text-base-content/60 mt-2">Aggregate receivables owing</div>
        </div>

        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">Total Credit Facility</div>
                    <div class="text-2xl font-bold text-base-content mt-1">₦@Model.TotalCreditLimit.ToString("N0")</div>
                </div>
                <div class="p-3 bg-info/10 text-info rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
                </div>
            </div>
            @{
                decimal facilityUtil = Model.TotalCreditLimit > 0 ? (Model.TotalCreditOutstanding / Model.TotalCreditLimit) * 100 : 0;
            }
            <div class="mt-2">
                <div class="flex justify-between text-xs text-base-content/60 mb-1">
                    <span>Credit Utilization</span>
                    <span class="font-bold">@facilityUtil.ToString("F1")%</span>
                </div>
                <progress class="progress @(facilityUtil > 80 ? "progress-error" : (facilityUtil > 60 ? "progress-warning" : "progress-primary")) w-full" value="@facilityUtil" max="100"></progress>
            </div>
        </div>

        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">High Credit Risk</div>
                    <div class="text-2xl font-bold @(Model.HighRiskCount > 0 ? "text-error" : "text-success") mt-1">@Model.HighRiskCount Accounts</div>
                </div>
                <div class="p-3 @(Model.HighRiskCount > 0 ? "bg-error/10 text-error" : "bg-success/10 text-success") rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
            </div>
            <div class="text-xs text-base-content/60 mt-2">Accounts with ≥ 80% limit consumed</div>
        </div>
    </div> *@

    <!-- Main Content Layout: Accounts List (Left 5 Cols) + Selected Account Pricing Matrix (Right 7 Cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Supermarket Directory -->
        <div class="lg:col-span-5 space-y-4">
            <div class="card bg-base-100 border border-base-200 shadow-sm">
                <div class="card-body p-4 sm:p-5">
                    <div class="flex items-center justify-between mb-3">
                        <h2 class="card-title text-base font-bold flex items-center gap-2">
                            <span>Supermarkets & Depots</span>
                            <span class="badge badge-neutral badge-sm">@Model.Accounts.Count</span>
                        </h2>
                    </div>

                    <div class="space-y-3">
                        @foreach (var acc in Model.Accounts)
                        {
                            var isSelected = sel != null && sel.Id == acc.Id;
                            var utilPercent = acc.CreditLimit > 0 ? (acc.CurrentOutstandingCredit / acc.CreditLimit) * 100 : 0;
                            var isHighRisk = utilPercent >= 80;

                            <a asp-page="./Index" asp-route-accountId="@acc.Id"
                               class="block p-3.5 rounded-xl border transition-all cursor-pointer @(isSelected ? "border-primary bg-primary/5 shadow-sm" : "border-base-200 hover:border-base-300 hover:bg-base-200/40")">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-bold text-base-content">@acc.AccountName</span>
                                            @if (isHighRisk)
                                            {
                                                <span class="badge badge-error badge-xs font-semibold">High Credit</span>
                                            }
                                        </div>
                                        <div class="text-xs text-base-content/60 flex items-center gap-1.5">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                            @acc.ContactPerson (@acc.PhoneNumber)
                                        </div>
                                        <div class="text-xs text-base-content/60 flex items-center gap-1.5">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                            @acc.Address
                                        </div>
                                        <div class="text-xs text-primary/80 font-medium">
                                            Rep: @acc.AssignedRepName
                                        </div>
                                    </div>
                                </div>

                                <!-- Credit Utilization Bar -->
                                <div class="mt-3 pt-2 border-t border-base-200">
                                    <div class="flex justify-between items-center text-xs">
                                        <span class="text-base-content/60">Owing: <strong class="text-error">₦@acc.CurrentOutstandingCredit.ToString("N0")</strong></span>
                                        <span class="text-base-content/60">Limit: <strong>₦@acc.CreditLimit.ToString("N0")</strong></span>
                                    </div>
                                    <progress class="progress @(isHighRisk ? "progress-error" : "progress-primary") w-full mt-1.5" value="@utilPercent" max="100"></progress>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Selected Supermarket Detail & Custom Pricing Matrix -->
        <div class="lg:col-span-7 space-y-4">
            @if (sel != null)
            {
                var selUtil = sel.CreditLimit > 0 ? (sel.CurrentOutstandingCredit / sel.CreditLimit) * 100 : 0;
                var availableCredit = Math.Max(0m, sel.CreditLimit - sel.CurrentOutstandingCredit);

                <!-- Account Banner Card -->
                <div class="card bg-base-100 border border-base-200 shadow-sm">
                    <div class="card-body p-5">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-base-200">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h2 class="text-xl font-bold text-base-content">@sel.AccountName</h2>
                                    <span class="badge badge-success badge-sm">Active Supermarket</span>
                                </div>
                                <div class="text-xs text-base-content/70 mt-1 flex flex-wrap gap-x-4 gap-y-1">
                                    <span><strong>Contact:</strong> @sel.ContactPerson</span>
                                    <span><strong>Phone:</strong> @sel.PhoneNumber</span>
                                    <span><strong>Rep:</strong> @sel.AssignedRepName</span>
                                    <span><strong>Terms:</strong> @sel.PaymentTerms</span>
                                </div>
                            </div>

                            <div class="flex flex-wrap items-center gap-2">
                                <a asp-page="./Edit" asp-route-id="@sel.Id" class="btn btn-primary btn-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                                    Manage Store Details
                                </a>
                                <a asp-page="./Supply" asp-route-id="@sel.Id" class="btn btn-outline btn-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Direct Supply
                                </a>
                                <a asp-page="./Payment" asp-route-id="@sel.Id" class="btn btn-outline btn-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                    Pay Credit
                                </a>
                            </div>
                        </div>

                        <!-- Credit Status Snapshot -->
                        <div class="grid grid-cols-3 gap-3 pt-3">
                            <div class="bg-base-200/50 p-3 rounded-lg text-center">
                                <div class="text-xs text-base-content/60 font-medium">Credit Limit</div>
                                <div class="text-lg font-bold text-base-content mt-0.5">₦@sel.CreditLimit.ToString("N0")</div>
                            </div>
                            <div class="bg-base-200/50 p-3 rounded-lg text-center">
                                <div class="text-xs text-base-content/60 font-medium">Current Owing</div>
                                <div class="text-lg font-bold text-error mt-0.5">₦@sel.CurrentOutstandingCredit.ToString("N0")</div>
                            </div>
                            <div class="bg-base-200/50 p-3 rounded-lg text-center">
                                <div class="text-xs text-base-content/60 font-medium">Available Headroom</div>
                                <div class="text-lg font-bold text-success mt-0.5">₦@availableCredit.ToString("N0")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Custom Agreed Pricing Matrix Card -->
                <div class="card bg-base-100 border border-base-200 shadow-sm">
                    <div class="card-body p-5">
                        <div class="flex items-center justify-between mb-2">
                            <div>
                                <h3 class="card-title text-base font-bold flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                                    Contracted Custom Agreed SKU Pricing
                                </h3>
                                <p class="text-xs text-base-content/60">
                                    When this supermarket is billed or supplied on route, these custom prices automatically override the standard recipe price.
                                </p>
                            </div>
                            <span class="badge badge-info badge-sm">@sel.CustomAgreedPrices.Count Custom Overrides</span>
                        </div>

                        <form method="post" asp-page-handler="SavePrices">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="accountId" value="@sel.Id" />

                            <div class="overflow-x-auto mt-3">
                                <table class="table table-sm w-full">
                                    <thead>
                                        <tr class="bg-base-200/60 text-base-content font-bold">
                                            <th>SKU Code & Product</th>
                                            <th>Category</th>
                                            <th class="text-right">Standard Master Price</th>
                                            <th class="text-right w-44">Agreed Unit Price (₦)</th>
                                            <th class="text-right">Margin / Discount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sku in Model.CatalogSkus)
                                        {
                                            var hasCustom = sel.CustomAgreedPrices.TryGetValue(sku.Id, out var customPrice);
                                            var activePrice = hasCustom ? customPrice : sku.Price;
                                            var diff = sku.Price - activePrice;
                                            var discountPct = sku.Price > 0 ? (diff / sku.Price) * 100m : 0m;

                                            <tr class="hover:bg-base-200/30">
                                                <td>
                                                    <div class="font-bold text-sm text-base-content">@sku.Name</div>
                                                    <div class="text-xs font-mono text-base-content/50">@sku.Code</div>
                                                </td>
                                                <td>
                                                    <span class="badge badge-ghost badge-sm font-semibold">@sku.Category</span>
                                                </td>
                                                <td class="text-right font-mono text-sm font-medium">
                                                    ₦@sku.Price.ToString("N2")
                                                </td>
                                                <td class="text-right">
                                                    <div class="flex items-center justify-end gap-1">
                                                        <span class="text-xs font-mono text-base-content/50">₦</span>
                                                        <input type="number" 
                                                               step="0.01" 
                                                               min="0" 
                                                               name="prices[@sku.Id]" 
                                                               value="@(hasCustom ? customPrice.ToString("F2") : "")" 
                                                               placeholder="@sku.Price.ToString("F2")" 
                                                               class="input input-bordered input-xs w-28 text-right font-mono font-bold text-primary focus:border-primary" />
                                                    </div>
                                                </td>
                                                <td class="text-right">
                                                    @if (hasCustom && diff > 0)
                                                    {
                                                        <span class="badge badge-success badge-sm font-semibold text-xs">
                                                            -₦@diff.ToString("N0") (@discountPct.ToString("F1")%)
                                                        </span>
                                                    }
                                                    else if (hasCustom && diff < 0)
                                                    {
                                                        <span class="badge badge-warning badge-sm font-semibold text-xs">
                                                            +₦@Math.Abs(diff).ToString("N0") (+@Math.Abs(discountPct).ToString("F1")%)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-ghost badge-sm text-xs text-base-content/60">Standard</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="flex justify-end gap-2 mt-4 pt-3 border-t border-base-200">
                                <a asp-page="./Index" asp-route-accountId="@sel.Id" class="btn btn-ghost btn-sm">Discard</a>
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                    Save Agreed Pricing Contract
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card bg-base-100 border border-base-200 shadow-sm p-8 text-center text-base-content/60">
                    <p>No supermarket account selected. Please select an account from the directory.</p>
                </div>
            }
        </div>
    </div>
</div>


