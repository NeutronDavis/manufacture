@page
@using Manufacture.Models.DTOs
@model Manufacture.Pages.Sales.Reconciliation.IndexModel
@{
    ViewData["Title"] = "Sales Rep Reconciliation";
    var isReadOnly = Model.Selected == null
        || Model.Selected.IsReconciled
        || !Model.CanEdit;
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Sales/Index" class="hover:underline">Sales & POS</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Reconciliation</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-scale-balanced text-primary"></i> Sales Rep Reconciliation
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Opening stock rolls from yesterday's closing. Sold, damaged and replacement units are checked against the repository linked to the rep's POS.
            </p>
        </div>
        <form method="get" class="flex items-end gap-2">
            <div>
                <label class="label py-0"><span class="label-text text-[10px] font-bold uppercase opacity-60">Date</span></label>
                <input type="date" name="filterDate" value="@Model.FilterDate.ToString("yyyy-MM-dd")" class="input input-sm input-bordered rounded-xl" />
            </div>
            @if (!Model.IsSalesRep)
            {
                <div>
                    <label class="label py-0"><span class="label-text text-[10px] font-bold uppercase opacity-60">Rep</span></label>
                    <select name="repId" class="select select-sm select-bordered rounded-xl">
                        <option value="">All reps</option>
                        @foreach (var rep in Model.SalesReps)
                        {
                            <option value="@rep.Id" selected="@(Model.RepFilter == rep.Id)">@rep.FullName</option>
                        }
                    </select>
                </div>
            }
            <button type="submit" class="btn btn-sm btn-neutral rounded-xl">Load</button>
        </form>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success rounded-2xl text-sm font-semibold">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-error rounded-2xl text-sm font-semibold">@error</div>
    }

    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
        <div class="xl:col-span-4 card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-5 space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="font-black text-sm">Rep Sheets · @Model.FilterDate.ToString("yyyy-MM-dd")</h2>
                    <span class="badge badge-neutral badge-sm font-mono">@Model.Sheets.Count</span>
                </div>

                @if (Model.Sheets.Count == 0)
                {
                    <div class="rounded-xl border border-dashed border-base-300 p-5 text-center text-xs opacity-60">
                        No reconciliation saved for this date.
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        @foreach (var sheet in Model.Sheets)
                        {
                            <a asp-page="/Sales/Reconciliation/Index"
                               asp-route-sheetId="@sheet.Id"
                               asp-route-filterDate="@Model.FilterDate.ToString("yyyy-MM-dd")"
                               class="block rounded-xl border p-3 transition hover:border-primary @(Model.Selected?.Id == sheet.Id ? "border-primary bg-primary/5" : "border-base-300")">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="font-bold text-sm truncate">@sheet.RepName</div>
                                        <div class="font-mono text-[10px] opacity-60">@sheet.ReconciliationNumber</div>
                                    </div>
                                    <span class="badge badge-sm @(sheet.Status == SalesReconciliationStatus.Reconciled ? "badge-success" : "badge-warning")">
                                        @sheet.Status
                                    </span>
                                </div>
                                <div class="mt-2 flex items-center justify-between text-[10px] opacity-70">
                                    <span>@sheet.PosTerminalCode · @sheet.ProductRepositoryName</span>
                                    <span class="font-mono font-bold">₦@sheet.TotalExpectedRevenue.ToString("N0")</span>
                                </div>
                            </a>
                        }
                    </div>
                }

                <form method="post" asp-page-handler="Start" class="pt-2 border-t border-base-200 space-y-2">
                    <input type="hidden" name="filterDate" value="@Model.FilterDate.ToString("yyyy-MM-dd")" />
                    @if (Model.IsSalesRep)
                    {
                        <button type="submit" class="btn btn-primary btn-sm w-full rounded-xl font-bold">Start My Reconciliation</button>
                    }
                    else
                    {
                        <select name="repId" class="select select-sm select-bordered rounded-xl w-full" required>
                            <option value="">Select rep to start…</option>
                            @foreach (var rep in Model.SalesReps)
                            {
                                <option value="@rep.Id">@rep.FullName</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm w-full rounded-xl font-bold">Start Reconciliation</button>
                    }
                </form>
            </div>
        </div>

        <div class="xl:col-span-8">
            @if (Model.Selected == null)
            {
                <div class="card bg-base-100 border border-base-300 rounded-2xl">
                    <div class="card-body items-center justify-center py-16 text-center">
                        <i class="fa-solid fa-scale-balanced text-4xl opacity-20"></i>
                        <h3 class="font-bold mt-3">Select or start a reconciliation</h3>
                        <p class="text-xs opacity-60 max-w-md">Each sales representative has one sheet per day. The sheet lists only the products in the repository linked to their POS terminal.</p>
                    </div>
                </div>
            }
            else
            {
                var sheet = Model.Selected;
                <div class="card bg-base-100 border border-base-300 rounded-2xl overflow-hidden">
                    <div class="card-body p-0">
                        <div class="p-5 border-b border-base-200 flex flex-col sm:flex-row sm:items-start justify-between gap-3">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h2 class="text-lg font-black">@sheet.RepName</h2>
                                    <span class="badge badge-sm @(sheet.IsReconciled ? "badge-success" : "badge-warning")">@sheet.Status</span>
                                </div>
                                <div class="text-xs opacity-70 mt-1 flex flex-wrap gap-x-4 gap-y-1">
                                    <span><i class="fa-solid fa-hashtag mr-1"></i>@sheet.ReconciliationNumber</span>
                                    <span><i class="fa-solid fa-calendar mr-1"></i>@sheet.ReconciliationDate.ToString("yyyy-MM-dd")</span>
                                    <span><i class="fa-solid fa-desktop mr-1"></i>@sheet.PosTerminalCode</span>
                                    <span><i class="fa-solid fa-warehouse mr-1"></i>@sheet.ProductRepositoryName</span>
                                </div>
                            </div>
                            @if (!isReadOnly)
                            {
                                <form method="post" asp-page-handler="Sync">
                                    <input type="hidden" name="id" value="@sheet.Id" />
                                    <button type="submit" class="btn btn-xs btn-outline rounded-lg">Sync Products</button>
                                </form>
                            }
                        </div>

                        <form method="post">
                            <input type="hidden" name="SaveInput.Id" value="@sheet.Id" />

                            <div class="overflow-x-auto p-5">
                                <table class="table table-sm w-full text-xs">
                                    <thead>
                                        <tr class="text-[10px] uppercase tracking-wide opacity-60">
                                            <th>Product</th>
                                            <th class="text-right">Active Stock<br /><span class="normal-case opacity-60">(yesterday closing)</span></th>
                                            <th class="text-right">Qty Sold</th>
                                            <th class="text-right">Damaged</th>
                                            <th class="text-right">Replacement</th>
                                            <th class="text-right">Closing</th>
                                            <th class="text-right">Unit Price</th>
                                            <th class="text-right">Expected</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < sheet.Items.Count; i++)
                                        {
                                            var item = sheet.Items[i];
                                            <tr class="recon-row" data-price="@item.UnitPrice">
                                                <td>
                                                    <input type="hidden" name="SaveInput.Items[@i].Id" value="@item.Id" />
                                                    <input type="hidden" name="SaveInput.Items[@i].RecipeId" value="@item.RecipeId" />
                                                    <div class="font-bold">@item.ProductName</div>
                                                    <div class="font-mono text-[10px] opacity-60">@item.ProductCode · @item.OutputUnit</div>
                                                    @if (item.SystemSoldQuantity != item.QtySold)
                                                    {
                                                        <div class="text-[10px] text-warning mt-0.5">System deducted @item.SystemSoldQuantity</div>
                                                    }
                                                </td>
                                                <td class="text-right">
                                                    <input type="number" min="0" name="SaveInput.Items[@i].OpeningStock" value="@item.OpeningStock"
                                                           class="input input-xs input-bordered w-20 text-right font-mono recon-opening"
                                                           readonly="@(!sheet.CanEditOpening || isReadOnly)" />
                                                </td>
                                                <td class="text-right">
                                                    <input type="number" min="0" name="SaveInput.Items[@i].QtySold" value="@item.QtySold"
                                                           class="input input-xs input-bordered w-20 text-right font-mono recon-sold"
                                                           readonly="@isReadOnly" />
                                                </td>
                                                <td class="text-right">
                                                    <input type="number" min="0" name="SaveInput.Items[@i].QtyDamaged" value="@item.QtyDamaged"
                                                           class="input input-xs input-bordered w-20 text-right font-mono recon-damaged"
                                                           readonly="@isReadOnly" />
                                                </td>
                                                <td class="text-right">
                                                    <input type="number" min="0" name="SaveInput.Items[@i].QtyReplacement" value="@item.QtyReplacement"
                                                           class="input input-xs input-bordered w-20 text-right font-mono recon-replacement"
                                                           readonly="@isReadOnly" />
                                                </td>
                                                <td class="text-right font-mono font-bold recon-closing">@item.ClosingStock</td>
                                                <td class="text-right font-mono">₦@item.UnitPrice.ToString("N0")</td>
                                                <td class="text-right font-mono font-bold recon-expected">₦@item.ExpectedRevenue.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="font-bold">
                                            <td colspan="7" class="text-right">Total expected revenue</td>
                                            <td class="text-right font-mono" id="totalExpected">₦@sheet.TotalExpectedRevenue.ToString("N0")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div class="p-5 border-t border-base-200 grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div class="rounded-xl border border-base-300 p-4 space-y-3">
                                    <h3 class="font-bold text-xs uppercase opacity-60">Cash Collection</h3>
                                    <label class="form-control">
                                        <span class="label-text text-[10px] font-bold uppercase opacity-60">Cash Handed Over</span>
                                        <input type="number" min="0" step="0.01" name="SaveInput.CashHandedOver" value="@sheet.CashHandedOver"
                                               class="input input-sm input-bordered rounded-xl font-mono cash-input" readonly="@isReadOnly" />
                                    </label>
                                    <label class="form-control">
                                        <span class="label-text text-[10px] font-bold uppercase opacity-60">POS Terminal Receipts</span>
                                        <input type="number" min="0" step="0.01" name="SaveInput.PosTerminalReceipts" value="@sheet.PosTerminalReceipts"
                                               class="input input-sm input-bordered rounded-xl font-mono pos-input" readonly="@isReadOnly" />
                                    </label>
                                </div>

                                <div class="rounded-xl border border-base-300 p-4 space-y-2">
                                    <h3 class="font-bold text-xs uppercase opacity-60">Summary</h3>
                                    <div class="flex justify-between text-xs"><span>Expected revenue</span><span class="font-mono font-bold" id="summaryExpected">₦@sheet.TotalExpectedRevenue.ToString("N0")</span></div>
                                    <div class="flex justify-between text-xs"><span>Total collected</span><span class="font-mono font-bold" id="summaryCollected">₦@sheet.TotalCollected.ToString("N0")</span></div>
                                    <div class="flex justify-between text-xs"><span>Variance</span><span class="font-mono font-bold" id="summaryVariance">₦@sheet.Variance.ToString("N0")</span></div>
                                    <p class="text-[10px] opacity-60">Damage and replacement quantities post out of the repository when the sheet is closed.</p>
                                </div>

                                <div class="rounded-xl border border-base-300 p-4 space-y-2">
                                    <h3 class="font-bold text-xs uppercase opacity-60">Remarks</h3>
                                    <textarea name="SaveInput.Notes" class="textarea textarea-bordered textarea-sm w-full rounded-xl" rows="4" readonly="@isReadOnly">@sheet.Notes</textarea>
                                    @if (sheet.IsReconciled)
                                    {
                                        <p class="text-[10px] opacity-60">Closed by @sheet.ReconciledBy on @sheet.ReconciledAt?.ToString("yyyy-MM-dd HH:mm").</p>
                                    }
                                </div>
                            </div>

                            @if (!isReadOnly)
                            {
                                <div class="p-5 border-t border-base-200 flex flex-wrap justify-end gap-2">
                                    <button type="submit" asp-page-handler="Save" class="btn btn-sm btn-outline rounded-xl font-bold">Save Draft</button>
                                    <button type="submit" asp-page-handler="Reconcile" class="btn btn-sm btn-primary rounded-xl font-bold">Reconcile &amp; Close</button>
                                </div>
                            }
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const money = value => '₦' + Math.round(value).toLocaleString();

            function recalc() {
                let expected = 0;
                document.querySelectorAll('.recon-row').forEach(row => {
                    const opening = parseInt(row.querySelector('.recon-opening')?.value || '0', 10);
                    const sold = parseInt(row.querySelector('.recon-sold')?.value || '0', 10);
                    const damaged = parseInt(row.querySelector('.recon-damaged')?.value || '0', 10);
                    const replacement = parseInt(row.querySelector('.recon-replacement')?.value || '0', 10);
                    const price = parseFloat(row.dataset.price || '0');

                    const closing = opening - sold - damaged - replacement;
                    const expectedValue = sold * price;

                    row.querySelector('.recon-closing').textContent = closing.toLocaleString();
                    row.querySelector('.recon-closing').classList.toggle('text-error', closing < 0);
                    row.querySelector('.recon-expected').textContent = money(expectedValue);
                    expected += expectedValue;
                });

                const cash = parseFloat(document.querySelector('.cash-input')?.value || '0');
                const pos = parseFloat(document.querySelector('.pos-input')?.value || '0');
                const collected = cash + pos;

                document.getElementById('totalExpected').textContent = money(expected);
                document.getElementById('summaryExpected').textContent = money(expected);
                document.getElementById('summaryCollected').textContent = money(collected);
                document.getElementById('summaryVariance').textContent = money(expected - collected);
            }

            document.querySelectorAll('.recon-sold, .recon-damaged, .recon-replacement, .recon-opening, .cash-input, .pos-input')
                .forEach(input => input.addEventListener('input', recalc));

            recalc();
        })();
    </script>
}
