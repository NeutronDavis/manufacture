@page
@model Manufacture.Pages.Sales.Reconciliation.IndexModel
@{
    ViewData["Title"] = "End-of-Day Route Closing & Reconciliation";
    var sheet = Model.SelectedSheet;
}

<div class="space-y-6 w-full pb-12">
    <!-- Header & Breadcrumbs -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Sales/Index" class="hover:underline">Sales &amp; POS</a>
                <span>&gt;</span>
                <span>End-of-Day Closing &amp; Reconciliation</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2.5">
                <i class="fa-solid fa-calculator text-primary"></i> End-of-Day Route Closing &amp; Payment Drawer
            </h1>
            <p class="text-xs opacity-70 mt-1 max-w-4xl">
                Reconcile physical stock counts against actual sales, log unsold closing stock for rollover, and record lump-sum payments without SKU breakdown to calculate the rep's updated running balance.
            </p>
        </div>
        <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
            <a asp-page="/Sales/Dispatch/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-bold">
                <i class="fa-solid fa-truck-ramp-box text-xs"></i> Route Dispatch Bay
            </a>
            <a asp-page="/Reports/Index" asp-route-view="charts" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-bold">
                <i class="fa-solid fa-chart-pie text-xs"></i> Cash Variance Report
            </a>
            <a asp-page="/Sales/Index" class="btn btn-sm btn-ghost rounded-xl text-xs gap-1 opacity-70">
                <i class="fa-solid fa-arrow-left text-xs"></i> Sales Hub
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-xs rounded-2xl text-xs py-3.5">
            <i class="fa-solid fa-circle-check text-base"></i>
            <div>
                <div class="font-bold">Reconciliation Successful</div>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error shadow-xs rounded-2xl text-xs py-3.5">
            <i class="fa-solid fa-circle-exclamation text-base"></i>
            <div>
                <div class="font-bold">Action Failed</div>
                <div>@TempData["ErrorMessage"]</div>
            </div>
        </div>
    }

    <!-- Main Workspace Layout: Rep Sheets List + Active Closing Sheet -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Left: Route Sheets Roster (4 cols) -->
        <div class="lg:col-span-4 card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
            <div class="p-4 border-b border-base-300 bg-base-200/50 flex items-center justify-between">
                <div class="font-bold text-xs uppercase tracking-wider opacity-70 flex items-center gap-2">
                    <i class="fa-solid fa-calendar-day text-primary"></i> Route Sheets To Close
                </div>
                <form method="get" class="flex items-center gap-1.5">
                    <input type="date" name="FilterDate" value="@((Model.FilterDate ?? DateTime.UtcNow).ToString("yyyy-MM-dd"))" onchange="this.form.submit()" class="input input-xs input-bordered rounded-lg text-[10px] font-mono" />
                </form>
            </div>

            <div class="divide-y divide-base-200 max-h-[600px] overflow-y-auto">
                @if (Model.RouteSheets.Count == 0)
                {
                    <div class="p-6 text-center text-xs opacity-60">
                        No route sheets found for this date.
                    </div>
                }
                @foreach (var s in Model.RouteSheets)
                {
                    var isSelected = sheet != null && sheet.Id == s.Id;
                    <a asp-page="/Sales/Reconciliation/Index" asp-route-sheetId="@s.Id" asp-route-FilterDate="@((Model.FilterDate ?? DateTime.UtcNow).ToString("yyyy-MM-dd"))" 
                       class="block p-4 transition-colors hover:bg-base-200/60 @(isSelected ? "bg-primary/5 border-l-4 border-primary" : "")">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="font-mono font-bold text-xs text-base-content">@s.RouteSheetRef</span>
                                <div class="font-semibold text-xs text-base-content mt-0.5">@s.RepName</div>
                                <div class="text-[10px] opacity-60 flex items-center gap-1 mt-0.5">
                                    <i class="fa-solid fa-van-shuttle text-[9px]"></i> @s.VehicleRegNumber &bull; @s.RouteName
                                </div>
                            </div>
                            <div class="text-right">
                                @if (s.Status == Manufacture.Models.Domain.RouteSheetStatus.Ordered)
                                {
                                    <span class="badge badge-warning badge-xs font-bold uppercase text-[9px] py-1">Ordered</span>
                                }
                                else if (s.Status == Manufacture.Models.Domain.RouteSheetStatus.LoadedOnRoute)
                                {
                                    <span class="badge badge-info badge-xs font-bold uppercase text-[9px] py-1">On Route</span>
                                }
                                else
                                {
                                    <span class="badge badge-success badge-xs font-bold uppercase text-[9px] py-1">Reconciled</span>
                                }
                                <div class="text-[10px] font-mono opacity-60 mt-1">
                                    Bal: ₦@s.NewOutstandingAccountBalance.ToString("N0")
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>

        <!-- Right: Active Reconciliation Matrix & Lump-Sum Drawer (8 cols) -->
        <div class="lg:col-span-8 space-y-6">
            @if (sheet == null)
            {
                <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-12 text-center text-xs opacity-60">
                    Select a route sheet from the left to start physical quantity closing and payment drawer balancing.
                </div>
            }
            else
            {
                var isReadOnly = sheet.Status == Manufacture.Models.Domain.RouteSheetStatus.Reconciled || sheet.Status == Manufacture.Models.Domain.RouteSheetStatus.Closed || !Model.CanEdit;
                
                <form method="post" asp-page-handler="Reconcile" id="reconcileForm" class="space-y-6">
                    <input type="hidden" name="RouteSheetId" value="@sheet.Id" />
                    <input type="hidden" id="prevBalanceHidden" value="@sheet.PreviousAccountBalance" />
                    <input type="hidden" id="plannedCashPctHidden" value="@Model.PlannedCashPercent" />

                    <!-- Sheet Header Details -->
                    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-base-300 pb-4">
                            <div>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-mono font-black text-lg text-base-content">@sheet.RouteSheetRef</span>
                                    @if (sheet.Status == Manufacture.Models.Domain.RouteSheetStatus.LoadedOnRoute)
                                    {
                                        <span class="badge badge-info badge-sm font-bold gap-1 text-[10px]">
                                            <i class="fa-solid fa-clock"></i> Ready For Route Closing
                                        </span>
                                    }
                                    else if (sheet.Status == Manufacture.Models.Domain.RouteSheetStatus.Reconciled)
                                    {
                                        <span class="badge badge-success badge-sm font-bold gap-1 text-[10px]">
                                            <i class="fa-solid fa-check-double"></i> Reconciled &amp; Account Closed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning badge-sm font-bold gap-1 text-[10px]">
                                            <i class="fa-solid fa-hourglass-start"></i> Waiting for Loading Sign-off
                                        </span>
                                    }
                                </div>
                                <div class="text-xs opacity-70 mt-1 flex items-center gap-3 flex-wrap">
                                    <span><strong class="text-base-content">Rep:</strong> @sheet.RepName (@sheet.RepCode)</span>
                                    <span><strong class="text-base-content">Vehicle:</strong> <span class="font-mono font-bold">@sheet.VehicleRegNumber</span></span>
                                    <span><strong class="text-base-content">Route:</strong> @sheet.RouteName</span>
                                    <span><strong class="text-base-content">Prior Debt:</strong> <span class="font-mono font-bold text-error">₦@sheet.PreviousAccountBalance.ToString("N0")</span></span>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="window.print()" class="btn btn-xs btn-outline border-base-300 rounded-xl font-bold gap-1 text-[11px]">
                                    <i class="fa-solid fa-print"></i> Print Settlement
                                </button>
                            </div>
                        </div>

                        <!-- 1. Physical Quantity Closing Matrix -->
                        <div>
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-base-content flex items-center gap-1.5">
                                    <i class="fa-solid fa-boxes-stacked text-primary"></i> Physical Route Stock Balancing Matrix
                                </h3>
                                <span class="text-[10px] opacity-60">Rule: Sold + Returned + Damaged == Active Inventory</span>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="table table-sm w-full text-xs" id="itemsTable">
                                    <thead>
                                        <tr class="opacity-70 uppercase text-[9px] tracking-wider border-b border-base-300 bg-base-200/50">
                                            <th class="py-2.5 pl-3">SKU Name</th>
                                            <th class="text-right">Yest. Closing</th>
                                            <th class="text-right">Today Loaded</th>
                                            <th class="text-right font-bold text-base-content">Active Stock</th>
                                            <th class="text-right text-success font-bold">Qty Sold</th>
                                            <th class="text-right text-amber-500 font-bold">Unsold Return</th>
                                            <th class="text-right text-error font-bold">Damaged</th>
                                            <th class="text-right">Unit Price</th>
                                            <th class="text-right pr-3 font-bold text-primary">Expected Value</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-base-200 font-mono">
                                        @for (int i = 0; i < sheet.Items.Count; i++)
                                        {
                                            var it = sheet.Items[i];
                                            <tr class="hover:bg-base-200/40 item-row" data-product-id="@it.ProductId" data-active="@it.TotalActiveInventory" data-price="@it.UnitSellingPrice">
                                                <td class="py-2.5 pl-3 font-sans">
                                                    <div class="font-bold text-base-content text-xs">@it.ProductName</div>
                                                    <div class="text-[9px] opacity-60">@it.ProductCode</div>
                                                </td>
                                                <td class="text-right opacity-70">@it.YesterdayClosingStock.ToString("N0")</td>
                                                <td class="text-right opacity-70">@it.TodayNewlyLoadedQty.ToString("N0")</td>
                                                <td class="text-right font-bold text-base-content">@it.TotalActiveInventory.ToString("N0")</td>
                                                <td class="text-right">
                                                    @if (!isReadOnly)
                                                    {
                                                        <input type="number" 
                                                               name="SoldQuantities[@it.ProductId]" 
                                                               value="@it.QtySold" 
                                                               min="0" 
                                                               max="@it.TotalActiveInventory" 
                                                               class="input input-xs input-bordered rounded-lg w-16 text-right font-mono font-bold text-success sold-input" 
                                                               oninput="recalcReconciliation()" />
                                                    }
                                                    else
                                                    {
                                                        <span class="font-bold text-success">@it.QtySold.ToString("N0")</span>
                                                    }
                                                </td>
                                                <td class="text-right">
                                                    @if (!isReadOnly)
                                                    {
                                                        <input type="number" 
                                                               name="ReturnedQuantities[@it.ProductId]" 
                                                               value="@it.QtyReturned" 
                                                               min="0" 
                                                               max="@it.TotalActiveInventory" 
                                                               class="input input-xs input-bordered rounded-lg w-16 text-right font-mono font-bold text-amber-500 returned-input" 
                                                               oninput="recalcReconciliation()" />
                                                    }
                                                    else
                                                    {
                                                        <span class="font-bold text-amber-500">@it.QtyReturned.ToString("N0")</span>
                                                    }
                                                </td>
                                                <td class="text-right">
                                                    @if (!isReadOnly)
                                                    {
                                                        <input type="number" 
                                                               name="DamagedQuantities[@it.ProductId]" 
                                                               value="@it.QtyDamaged" 
                                                               min="0" 
                                                               max="@it.TotalActiveInventory" 
                                                               class="input input-xs input-bordered rounded-lg w-16 text-right font-mono font-bold text-error damaged-input" 
                                                               oninput="recalcReconciliation()" />
                                                    }
                                                    else
                                                    {
                                                        <span class="font-bold text-error">@it.QtyDamaged.ToString("N0")</span>
                                                    }
                                                </td>
                                                <td class="text-right opacity-80">₦@it.UnitSellingPrice.ToString("N0")</td>
                                                <td class="text-right pr-3 font-bold text-primary expected-cell">
                                                    ₦@it.ExpectedItemRevenue.ToString("N0")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr class="font-bold border-t-2 border-base-300 text-xs bg-base-200/30">
                                            <td class="pl-3 py-3 font-sans">Closing Totals</td>
                                            <td class="text-right font-mono">@sheet.Items.Sum(i => i.YesterdayClosingStock)</td>
                                            <td class="text-right font-mono">@sheet.Items.Sum(i => i.TodayNewlyLoadedQty)</td>
                                            <td class="text-right font-mono text-sm">@sheet.Items.Sum(i => i.TotalActiveInventory)</td>
                                            <td class="text-right font-mono text-success text-sm" id="totalSoldUnits">@sheet.Items.Sum(i => i.QtySold)</td>
                                            <td class="text-right font-mono text-amber-500 text-sm" id="totalReturnedUnits">@sheet.Items.Sum(i => i.QtyReturned)</td>
                                            <td class="text-right font-mono text-error text-sm" id="totalDamagedUnits">@sheet.Items.Sum(i => i.QtyDamaged)</td>
                                            <td></td>
                                            <td class="text-right pr-3 font-mono text-primary text-sm" id="totalExpectedRevenueDisplay">
                                                ₦@sheet.TotalExpectedSalesRevenue.ToString("N0")
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <!-- 2. Aggregated Lump-Sum Payment Drawer (No SKU Breakdown) -->
                        <div class="border-t border-base-300 pt-5 space-y-4">
                            <div class="flex items-center justify-between">
                                <h3 class="text-xs font-bold uppercase tracking-wider text-base-content flex items-center gap-1.5">
                                    <i class="fa-solid fa-vault text-amber-500"></i> Lump-Sum Payment Collection Panel (No SKU Breakdown)
                                </h3>
                                <span class="badge badge-neutral badge-xs font-bold text-[9px]">Tender Split</span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                <!-- Cash Brought Back -->
                                <div class="card bg-base-200/60 border border-base-300 rounded-xl p-3.5 space-y-1.5">
                                    <label class="text-[11px] font-bold text-amber-600 dark:text-amber-400 flex items-center justify-between">
                                        <span><i class="fa-solid fa-money-bill-wave"></i> Cash Handed Over</span>
                                        <span class="text-[9px] font-mono opacity-60">Physical Banknotes</span>
                                    </label>
                                    @if (!isReadOnly)
                                    {
                                        <input type="number" 
                                               id="cashInput" 
                                               name="CashCollected" 
                                               value="@sheet.CashCollected" 
                                               min="0" 
                                               step="500" 
                                               class="input input-sm input-bordered font-mono font-bold text-right w-full rounded-xl" 
                                               oninput="recalcReconciliation()" />
                                    }
                                    else
                                    {
                                        <div class="text-right font-mono font-bold text-base text-base-content">
                                            ₦@sheet.CashCollected.ToString("N0")
                                        </div>
                                    }
                                </div>

                                <!-- Bank Transfers Confirmed -->
                                <div class="card bg-base-200/60 border border-base-300 rounded-xl p-3.5 space-y-1.5">
                                    <label class="text-[11px] font-bold text-blue-600 dark:text-blue-400 flex items-center justify-between">
                                        <span><i class="fa-solid fa-building-columns"></i> Bank Transfers</span>
                                        <span class="text-[9px] font-mono opacity-60">Verified Alerts</span>
                                    </label>
                                    @if (!isReadOnly)
                                    {
                                        <input type="number" 
                                               id="transferInput" 
                                               name="BankTransferCollected" 
                                               value="@sheet.BankTransferCollected" 
                                               min="0" 
                                               step="500" 
                                               class="input input-sm input-bordered font-mono font-bold text-right w-full rounded-xl" 
                                               oninput="recalcReconciliation()" />
                                    }
                                    else
                                    {
                                        <div class="text-right font-mono font-bold text-base text-base-content">
                                            ₦@sheet.BankTransferCollected.ToString("N0")
                                        </div>
                                    }
                                </div>

                                <!-- POS Terminal Card Receipts -->
                                <div class="card bg-base-200/60 border border-base-300 rounded-xl p-3.5 space-y-1.5">
                                    <label class="text-[11px] font-bold text-purple-600 dark:text-purple-400 flex items-center justify-between">
                                        <span><i class="fa-solid fa-credit-card"></i> POS Terminal Receipts</span>
                                        <span class="text-[9px] font-mono opacity-60">@sheet.PosTerminalCode</span>
                                    </label>
                                    @if (!isReadOnly)
                                    {
                                        <input type="number" 
                                               id="posInput" 
                                               name="PosTerminalCollected" 
                                               value="@sheet.PosTerminalCollected" 
                                               min="0" 
                                               step="500" 
                                               class="input input-sm input-bordered font-mono font-bold text-right w-full rounded-xl" 
                                               oninput="recalcReconciliation()" />
                                    }
                                    else
                                    {
                                        <div class="text-right font-mono font-bold text-base text-base-content">
                                            ₦@sheet.PosTerminalCollected.ToString("N0")
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 3. Prominent Live Calculation Callout Box -->
                        <div class="card border-2 border-base-300 rounded-2xl p-6 space-y-4 bg-base-100" id="calculationCallout">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-sm text-base-content flex items-center gap-2">
                                    <i class="fa-solid fa-scale-balanced text-primary"></i> Daily Account Ledger Reconciliation
                                </h4>
                                <span class="badge badge-outline border-base-300 font-mono text-xs">
                                    Formula: Prev Debt + Expected Sales - Total Payments
                                </span>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-1">
                                <!-- Today's Expected -->
                                <div class="p-3 bg-base-200/60 rounded-xl border border-base-300">
                                    <div class="text-[10px] uppercase font-bold opacity-60">Today's Expected Sales</div>
                                    <div class="text-lg font-black font-mono text-primary mt-1" id="calloutExpected">
                                        ₦@sheet.TotalExpectedSalesRevenue.ToString("N0")
                                    </div>
                                    <div class="text-[9px] opacity-60">From verified units sold</div>
                                </div>

                                <!-- Previous Debt -->
                                <div class="p-3 bg-base-200/60 rounded-xl border border-base-300">
                                    <div class="text-[10px] uppercase font-bold opacity-60">Previous Account Debt</div>
                                    <div class="text-lg font-black font-mono text-base-content mt-1">
                                        ₦@sheet.PreviousAccountBalance.ToString("N0")
                                    </div>
                                    <div class="text-[9px] opacity-60">Balance brought forward</div>
                                </div>

                                <!-- Total Collected -->
                                <div class="p-3 bg-base-200/60 rounded-xl border border-base-300">
                                    <div class="text-[10px] uppercase font-bold opacity-60">Total Payments Handed In</div>
                                    <div class="text-lg font-black font-mono text-success mt-1" id="calloutCollected">
                                        ₦@sheet.TotalPaymentsCollectedToday.ToString("N0")
                                    </div>
                                    <div class="text-[9px] opacity-60">Cash + Transfer + POS</div>
                                </div>

                                <!-- Net Updated Running Balance -->
                                <div class="p-3 rounded-xl border-2 @(sheet.NewOutstandingAccountBalance > sheet.PreviousAccountBalance ? "bg-error/10 border-error" : "bg-success/10 border-success")" id="calloutBalanceBox">
                                    <div class="text-[10px] uppercase font-bold opacity-75">Updated Running Balance</div>
                                    <div class="text-lg font-black font-mono @(sheet.NewOutstandingAccountBalance > sheet.PreviousAccountBalance ? "text-error" : "text-success") mt-1" id="calloutBalance">
                                        ₦@sheet.NewOutstandingAccountBalance.ToString("N0")
                                    </div>
                                    <div class="text-[9px] font-bold @(sheet.NewOutstandingAccountBalance > sheet.PreviousAccountBalance ? "text-error" : "text-success")" id="calloutBalanceStatus">
                                        @(sheet.NewOutstandingAccountBalance > sheet.PreviousAccountBalance ? "Debt Increased ⚠️" : "Debt Reduced / Settled ✔️")
                                    </div>
                                </div>
                            </div>

                            <!-- Treasury Benchmark Live Indicator -->
                            <div class="p-3 bg-base-200/40 rounded-xl border border-base-300 flex items-center justify-between text-xs flex-wrap gap-2">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-coins text-amber-500"></i>
                                    <span>
                                        <strong>Corporate Treasury Benchmark:</strong> @Model.PlannedCashPercent.ToString("0.#")% cash policy
                                    </span>
                                </div>
                                <div class="font-mono text-[11px]" id="treasuryVarianceBadge">
                                    @{
                                        var targetCash = Math.Round(sheet.TotalExpectedSalesRevenue * (Model.PlannedCashPercent / 100m));
                                        var cashVar = sheet.CashCollected - targetCash;
                                    }
                                    Cash Target: ₦<span id="targetCashDisplay">@targetCash.ToString("N0")</span> &bull; 
                                    Variance: <span class="font-bold @(cashVar >= 0 ? "text-warning" : "text-success")" id="cashVarDisplay">₦@cashVar.ToString("N0")</span>
                                </div>
                            </div>
                        </div>

                        <!-- Reconcile & Close Form Actions -->
                        @if (!isReadOnly)
                        {
                            <div class="border-t border-base-300 pt-5 space-y-4">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div class="space-y-1">
                                        <label class="text-xs font-semibold">Cashier / Reconciler Name:</label>
                                        <input type="text" name="CashierName" value="Chief Cashier" required class="input input-sm input-bordered w-full rounded-xl text-xs font-bold" />
                                    </div>
                                    <div class="space-y-1">
                                        <label class="text-xs font-semibold">Settlement Notes / Remarks:</label>
                                        <input type="text" name="Notes" placeholder="Drawer balancing notes, bank transfer refs, customer debt explanation..." class="input input-sm input-bordered w-full rounded-xl text-xs" />
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-2 flex-wrap gap-3">
                                    <div class="text-[11px] opacity-70">
                                        Closing will lock route financial accounts and carry over unsold returned stock as tomorrow's opening stock.
                                    </div>
                                    <button type="submit" class="btn btn-sm btn-primary rounded-xl font-bold gap-2 shadow-xs text-xs px-6">
                                        <i class="fa-solid fa-check-double"></i> Reconcile &amp; Close Route Sheet
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 rounded-xl bg-success/10 border border-success/30 flex items-center justify-between text-xs flex-wrap gap-2 text-success-content">
                                <div class="flex items-center gap-2">
                                    <i class="fa-solid fa-circle-check text-success text-base"></i>
                                    <div>
                                        <strong>Reconciliation Signed Off By:</strong> @(sheet.ReconciledBy ?? "Chief Cashier")
                                        <span class="opacity-60 font-mono ml-1">(@(sheet.ReconciledAt?.ToString("MMM dd, yyyy HH:mm") ?? "—"))</span>
                                    </div>
                                </div>
                                <span class="badge badge-success badge-sm font-bold">Settled &amp; Closed</span>
                            </div>
                        }
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function formatMoney(n) {
        return '₦' + Math.round(n).toLocaleString('en-US');
    }

    function recalcReconciliation() {
        var prevBalance = parseFloat(document.getElementById('prevBalanceHidden').value) || 0;
        var plannedCashPct = parseFloat(document.getElementById('plannedCashPctHidden').value) || 32;

        var totalExpected = 0;
        var totalSold = 0;
        var totalReturned = 0;
        var totalDamaged = 0;

        // Iterate through all SKU rows
        var rows = document.querySelectorAll('.item-row');
        rows.forEach(function (row) {
            var active = parseInt(row.getAttribute('data-active')) || 0;
            var price = parseFloat(row.getAttribute('data-price')) || 0;

            var soldInput = row.querySelector('.sold-input');
            var returnedInput = row.querySelector('.returned-input');
            var damagedInput = row.querySelector('.damaged-input');

            var sold = soldInput ? (parseInt(soldInput.value) || 0) : 0;
            var returned = returnedInput ? (parseInt(returnedInput.value) || 0) : 0;
            var damaged = damagedInput ? (parseInt(damagedInput.value) || 0) : 0;

            totalSold += sold;
            totalReturned += returned;
            totalDamaged += damaged;

            var itemExp = sold * price;
            totalExpected += itemExp;

            var expCell = row.querySelector('.expected-cell');
            if (expCell) {
                expCell.textContent = formatMoney(itemExp);
            }
        });

        // Update table footer
        var totalSoldEl = document.getElementById('totalSoldUnits');
        if (totalSoldEl) totalSoldEl.textContent = totalSold.toLocaleString('en-US');

        var totalRetEl = document.getElementById('totalReturnedUnits');
        if (totalRetEl) totalRetEl.textContent = totalReturned.toLocaleString('en-US');

        var totalDmgEl = document.getElementById('totalDamagedUnits');
        if (totalDmgEl) totalDmgEl.textContent = totalDamaged.toLocaleString('en-US');

        var totalExpEl = document.getElementById('totalExpectedRevenueDisplay');
        if (totalExpEl) totalExpEl.textContent = formatMoney(totalExpected);

        // Lump-sum payments
        var cashInput = document.getElementById('cashInput');
        var transferInput = document.getElementById('transferInput');
        var posInput = document.getElementById('posInput');

        var cash = cashInput ? (parseFloat(cashInput.value) || 0) : 0;
        var transfer = transferInput ? (parseFloat(transferInput.value) || 0) : 0;
        var pos = posInput ? (parseFloat(posInput.value) || 0) : 0;

        var totalCollected = cash + transfer + pos;
        var newBalance = prevBalance + totalExpected - totalCollected;

        // Update callout box
        document.getElementById('calloutExpected').textContent = formatMoney(totalExpected);
        document.getElementById('calloutCollected').textContent = formatMoney(totalCollected);
        document.getElementById('calloutBalance').textContent = formatMoney(newBalance);

        var balanceBox = document.getElementById('calloutBalanceBox');
        var balanceStatus = document.getElementById('calloutBalanceStatus');
        var calloutBalanceText = document.getElementById('calloutBalance');

        if (newBalance > prevBalance) {
            balanceBox.className = "p-3 rounded-xl border-2 bg-error/10 border-error";
            calloutBalanceText.className = "text-lg font-black font-mono text-error mt-1";
            balanceStatus.className = "text-[9px] font-bold text-error";
            balanceStatus.textContent = "Debt Increased ⚠️";
        } else {
            balanceBox.className = "p-3 rounded-xl border-2 bg-success/10 border-success";
            calloutBalanceText.className = "text-lg font-black font-mono text-success mt-1";
            balanceStatus.className = "text-[9px] font-bold text-success";
            balanceStatus.textContent = "Debt Reduced / Settled ✔️";
        }

        // Treasury benchmark comparison
        var targetCash = Math.round(totalExpected * (plannedCashPct / 100));
        var cashVar = cash - targetCash;

        document.getElementById('targetCashDisplay').textContent = targetCash.toLocaleString('en-US');
        var varDisplay = document.getElementById('cashVarDisplay');
        varDisplay.textContent = formatMoney(cashVar);
        varDisplay.className = "font-bold " + (cashVar >= 0 ? "text-warning" : "text-success");
    }
</script>
}
