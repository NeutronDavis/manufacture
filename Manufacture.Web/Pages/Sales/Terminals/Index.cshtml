@page
@model Manufacture.Pages.Sales.Terminals.IndexModel
@{
    ViewData["Title"] = "POS Terminals & Bank Account Management";
}

<div class="space-y-6 w-full pb-12">
    <!-- Header & Breadcrumbs -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="breadcrumbs text-sm mb-1 text-base-content/70">
                <ul>
                    <li><a asp-page="/Sales/Index" class="hover:text-primary">Sales & POS</a></li>
                    <li>Terminals</li>
                    <li class="font-semibold text-base-content">POS Registers & Bank Mapping</li>
                </ul>
            </div>
            <h1 class="text-3xl font-extrabold tracking-tight text-base-content flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                POS Terminals & Multi-Account Banking
            </h1>
            <p class="text-sm text-base-content/70">
                Manage registered checkout registers, configure multi-channel bank routing (Cash, Transfer, POS Merchant), and control terminal operational status.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <a asp-page="/Sales/Orders/Create" class="btn btn-outline btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                Open POS Checkout
            </a>
            <a asp-page="/Sales/Terminals/Create" class="btn btn-primary btn-sm">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Register New POS Terminal
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Model.SuccessMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Model.ErrorMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    <!-- Metric Stats Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">Total Registered</div>
                    <div class="text-2xl font-bold text-base-content mt-1">@Model.TotalCount</div>
                </div>
                <div class="p-3 bg-primary/10 text-primary rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                </div>
            </div>
            <div class="text-xs text-base-content/60 mt-2">Fleet vans & retail checkouts</div>
        </div>

        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">Active Terminals</div>
                    <div class="text-2xl font-bold text-success mt-1">@Model.ActiveCount</div>
                </div>
                <div class="p-3 bg-success/10 text-success rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
            </div>
            <div class="text-xs text-success mt-2 font-medium flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-success"></span> Online & accepting transactions
            </div>
        </div>

        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">Offline / Inactive</div>
                    <div class="text-2xl font-bold @(Model.InactiveCount > 0 ? "text-warning" : "text-base-content/60") mt-1">@Model.InactiveCount</div>
                </div>
                <div class="p-3 @(Model.InactiveCount > 0 ? "bg-warning/10 text-warning" : "bg-base-200 text-base-content/60") rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                </div>
            </div>
            <div class="text-xs text-base-content/60 mt-2">Locked or in maintenance</div>
        </div>

        <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-base-content/60">Assigned Operators</div>
                    <div class="text-2xl font-bold text-base-content mt-1">@Model.Terminals.Count(t => t.AssignedEmployeeId.HasValue)</div>
                </div>
                <div class="p-3 bg-info/10 text-info rounded-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                </div>
            </div>
            <div class="text-xs text-base-content/60 mt-2">Dedicated cashiers & reps</div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card bg-base-100 border border-base-200 shadow-sm p-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="relative w-full sm:w-96">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-base-content/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" 
                       id="terminalSearchInput" 
                       oninput="filterTerminals()" 
                       placeholder="Search terminal code, name, rep, or bank account..." 
                       class="input input-bordered input-sm w-full pl-9 text-xs" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <select id="statusFilter" onchange="filterTerminals()" class="select select-bordered select-sm text-xs">
                    <option value="all">All Statuses (@Model.TotalCount)</option>
                    <option value="active">Active Only (@Model.ActiveCount)</option>
                    <option value="inactive">Inactive / Offline (@Model.InactiveCount)</option>
                </select>
                <span id="terminalCountBadge" class="badge badge-neutral badge-sm font-mono font-bold">
                    @Model.TotalCount Terminals
                </span>
            </div>
        </div>
    </div>

    <!-- Grid of Terminal Cards -->
    <div id="terminalsGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var term in Model.Terminals)
        {
            var repName = term.AssignedEmployeeName ?? "Unassigned";

            <div class="card bg-base-100 border border-base-200 shadow-sm hover:shadow-md hover:border-primary/50 transition-all duration-200 rounded-2xl flex flex-col justify-between terminal-card cursor-pointer group"
                 onclick="window.location.href='@Url.Page("/Sales/Terminals/Edit", new { id = term.Id })'"
                 data-code="@term.TerminalCode"
                 data-name="@term.TerminalName"
                 data-status="@(term.IsActive ? "active" : "inactive")"
                 data-user-name="@repName"
                 data-cash="@term.CashAccountName"
                 data-transfer="@term.TransferAccountName"
                 data-pos="@term.PosBankAccountName">
                
                <div class="card-body p-5 sm:p-6 space-y-4">
                    <!-- Top Header: Code, Name, Status Badge -->
                    <div class="flex justify-between items-start gap-2">
                        <div>
                            <span class="badge badge-neutral badge-xs font-mono font-bold">@term.TerminalCode</span>
                            <h2 class="text-base font-black text-base-content tracking-tight mt-1 group-hover:text-primary transition-colors">
                                @term.TerminalName
                            </h2>
                        </div>
                        @if (term.IsActive)
                        {
                            <span class="badge badge-success badge-sm font-bold gap-1.5 shrink-0">
                                <span class="w-2 h-2 rounded-full bg-success-content animate-pulse"></span> Active
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-error badge-sm font-bold gap-1 shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                                Offline / Inactive
                            </span>
                        }
                    </div>

                    <!-- Assigned Rep -->
                    <div class="p-3 bg-base-200/60 border border-base-200 rounded-xl flex items-center justify-between text-xs">
                        <span class="text-base-content/60 flex items-center gap-1.5">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                            Operator / Rep:
                        </span>
                        <span class="font-bold text-base-content">
                            @repName
                        </span>
                    </div>

                    <!-- Multi-Channel Financial Account Mapping -->
                    <div class="space-y-2 text-xs">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-base-content/50">
                            Mapped Financial Channels & Accounts
                        </div>
                        
                        <!-- 1. Cash Drawer -->
                        <div class="p-2.5 rounded-xl border border-success/20 bg-success/5 flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-success/15 text-success flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                            </div>
                            <div class="truncate">
                                <div class="font-bold text-success text-xs">Cash Drawer Ledger</div>
                                <div class="font-mono text-[11px] text-base-content/80 truncate">@term.CashAccountName</div>
                            </div>
                        </div>

                        <!-- 2. Bank Transfer -->
                        <div class="p-2.5 rounded-xl border border-info/20 bg-info/5 flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-info/15 text-info flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                                </svg>
                            </div>
                            <div class="truncate">
                                <div class="font-bold text-info text-xs">Direct Bank Transfer</div>
                                <div class="font-mono text-[11px] text-base-content/80 truncate">@term.TransferAccountName</div>
                            </div>
                        </div>

                        <!-- 3. POS Machine Bank -->
                        <div class="p-2.5 rounded-xl border border-secondary/20 bg-secondary/5 flex items-center gap-2.5">
                            <div class="w-8 h-8 rounded-lg bg-secondary/15 text-secondary flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                                </svg>
                            </div>
                            <div class="truncate">
                                <div class="font-bold text-secondary text-xs">POS Machine Bank Account</div>
                                <div class="font-mono text-[11px] text-base-content/80 truncate">@term.PosBankAccountName</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Action Buttons -->
                <div class="p-3.5 border-t border-base-200 bg-base-100 flex justify-between items-center rounded-b-2xl gap-2" onclick="event.stopPropagation()">
                    <div class="flex items-center gap-1.5">
                        <a asp-page="/Sales/Terminals/Edit" asp-route-id="@term.Id" class="btn btn-xs btn-outline btn-primary gap-1 text-xs font-semibold">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                            Manage Bank & Settings
                        </a>
                    </div>

                    <div class="flex items-center gap-1.5">
                        <!-- Quick Status Toggle Form -->
                        <form method="post" asp-page-handler="ToggleStatus">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@term.Id" />
                            <button type="submit" 
                                    class="btn btn-xs @(term.IsActive ? "btn-outline btn-error" : "btn-outline btn-success") text-xs font-semibold" 
                                    title="@(term.IsActive ? "Disable / Set Offline" : "Activate Terminal")">
                                @(term.IsActive ? "Set Offline" : "Activate")
                            </button>
                        </form>

                        @if (term.IsActive)
                        {
                            <a asp-page="/Sales/Orders/Create" class="btn btn-xs btn-neutral text-xs font-bold shadow-xs">
                                POS &rarr;
                            </a>
                        }
                    </div>
                </div>

            </div>
        }
    </div>

    <!-- No Results Alert -->
    <div id="noTerminalsAlert" class="alert alert-info shadow-xs rounded-2xl text-xs py-4 hidden flex items-center gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>No POS terminals matched your search query. Try another terminal name, bank account, or status filter.</span>
    </div>
</div>

@section Scripts {
<script>
    function filterTerminals() {
        const query = (document.getElementById('terminalSearchInput').value || '').toLowerCase().trim();
        const statusFilter = document.getElementById('statusFilter').value;
        const cards = document.querySelectorAll('.terminal-card');
        let visibleCount = 0;

        cards.forEach(card => {
            const code = (card.getAttribute('data-code') || '').toLowerCase();
            const name = (card.getAttribute('data-name') || '').toLowerCase();
            const rep = (card.getAttribute('data-user-name') || '').toLowerCase();
            const cash = (card.getAttribute('data-cash') || '').toLowerCase();
            const transfer = (card.getAttribute('data-transfer') || '').toLowerCase();
            const pos = (card.getAttribute('data-pos') || '').toLowerCase();
            const status = card.getAttribute('data-status');

            const matchesQuery = !query || 
                                 code.includes(query) || 
                                 name.includes(query) || 
                                 rep.includes(query) || 
                                 cash.includes(query) || 
                                 transfer.includes(query) || 
                                 pos.includes(query);

            const matchesStatus = (statusFilter === 'all') || (status === statusFilter);

            if (matchesQuery && matchesStatus) {
                card.classList.remove('hidden');
                visibleCount++;
            } else {
                card.classList.add('hidden');
            }
        });

        document.getElementById('terminalCountBadge').innerText = visibleCount + ' Terminals';
        const alert = document.getElementById('noTerminalsAlert');
        if (visibleCount === 0) {
            alert.classList.remove('hidden');
        } else {
            alert.classList.add('hidden');
        }
    }
</script>
}
