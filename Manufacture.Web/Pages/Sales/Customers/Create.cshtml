@page
@model Manufacture.Pages.Sales.Customers.CreateModel
@{
    ViewData["Title"] = "Register Client or Vendor";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Sales/Customers/Index" class="hover:underline">Clients & Vendors</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Register Account</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-store text-primary"></i> Register Client / Vendor Account
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Register supermarkets, external bread depots, or corporate standing pre-order vendor accounts.
            </p>
        </div>
        <div>
            <a asp-page="/Sales/Customers/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-semibold">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Clients
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        
        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
                <div class="card-body p-6 space-y-5">
                    
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-7 h-7 rounded-lg bg-primary text-primary-content flex items-center justify-center text-xs font-bold shadow-xs">
                                <i class="fa-regular fa-building"></i>
                            </div>
                            <span>Account Profile & Credit Category</span>
                        </div>
                        <span class="badge badge-neutral badge-xs font-bold uppercase tracking-wider">Client Directory</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Account / Business Name <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="CustomerInput.Name" class="input input-bordered input-sm w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-medium" placeholder="e.g. Grand Square Supermarkets Ltd" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Member / Account Code <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="CustomerInput.MemberCode" class="input input-bordered input-sm w-full font-mono uppercase bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-bold" placeholder="e.g. SUP-501" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Customer Category</span>
                            </label>
                            <select asp-for="CustomerInput.Category" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-semibold focus:bg-base-100 focus:border-primary">
                                <option value="Supermarket">Supermarket Chain (Standing Pre-Orders)</option>
                                <option value="ExternalVendor">External Vendor (Wholesale Depot)</option>
                                <option value="WalkIn">Walk-in Retail Customer</option>
                                <option value="SalesRep">Internal Sales Rep Account</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Phone Number <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="tel" asp-for="CustomerInput.PhoneNumber" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="+234 80..." required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Initial Outstanding Balance (₦)</span>
                            </label>
                            <input type="number" step="100" min="0" asp-for="CustomerInput.OutstandingBalance" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" value="0" />
                        </div>

                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Delivery Address / Store Location</span>
                            </label>
                            <textarea asp-for="CustomerInput.Address" class="textarea textarea-bordered w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary leading-relaxed" rows="3" placeholder="Shop address, landmarks, delivery gate contact"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Sticky Section (~30% width, 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <h2 class="font-black text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-address-book text-primary"></i> Account Setup
                    </h2>
                    <span class="badge badge-success badge-xs font-bold">New Client</span>
                </div>

                <p class="text-[11px] opacity-70 leading-relaxed">
                    Client account will immediately be available for POS orders, scheduled pre-order deliveries, and customer credit ledger tracking.
                </p>

                <div class="space-y-2 pt-2 border-t border-base-200">
                    <button type="submit" class="btn btn-neutral w-full rounded-xl font-bold py-2.5 text-xs shadow-xs gap-2">
                        <i class="fa-solid fa-circle-check text-success text-xs"></i> Register Client Profile
                    </button>

                    <a asp-page="/Sales/Customers/Index" class="btn btn-ghost w-full rounded-xl text-xs font-semibold">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>
