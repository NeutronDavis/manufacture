@page
@model Manufacture.Pages.Sales.Orders.PreOrdersModel
@{
    ViewData["Title"] = "Pre-Order Management Pipeline";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs breadcrumbs mb-1">
                <ul>
                    <li><a asp-page="/Dashboard/Index">Dashboard</a></li>
                    <li><a asp-page="/Sales/Index">Sales</a></li>
                    <li class="font-semibold text-primary">Pre-Orders</li>
                </ul>
            </div>
            <h1 class="text-2xl font-black text-base-content flex items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-warning"></i> Advance Pre-Order Pipeline
            </h1>
            <p class="text-sm text-base-content/60">Manage supermarket and vendor pre-orders feeding directly into daily production planning</p>
        </div>
        <a asp-page="/Sales/Orders/Create" asp-route-orderType="PreOrder" class="btn btn-warning gap-2">
            <i class="fa-solid fa-plus"></i> Place Advance Pre-Order
        </a>
    </div>

    <!-- Demand Summary Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="card bg-base-100 border border-base-300 shadow-xs">
            <div class="card-body p-4 text-center">
                <div class="text-xs uppercase font-semibold text-base-content/60">Total Active Pre-Orders</div>
                <div class="text-2xl font-black text-warning mt-1">@Model.PreOrders.Count</div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 shadow-xs">
            <div class="card-body p-4 text-center">
                <div class="text-xs uppercase font-semibold text-base-content/60">Total Loaves Scheduled</div>
                <div class="text-2xl font-black text-primary mt-1">
                    @Model.PreOrders.Sum(o => o.Items.Sum(i => i.Quantity))
                </div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 shadow-xs">
            <div class="card-body p-4 text-center">
                <div class="text-xs uppercase font-semibold text-base-content/60">Pre-Order Gross Value</div>
                <div class="text-2xl font-black text-emerald-600 mt-1">
                    ₦@Model.PreOrders.Sum(o => o.TotalAmount).ToString("N0")
                </div>
            </div>
        </div>
    </div>

    <!-- Pre-Orders Table -->
    <div class="card bg-base-100 border border-base-300 shadow-xs">
        <div class="card-body p-5">
            <div class="overflow-x-auto">
                <table class="table table-sm table-zebra">
                    <thead>
                        <tr class="bg-base-200/70">
                            <th>Order #</th>
                            <th>Target Delivery Date</th>
                            <th>Customer / Supermarket</th>
                            <th>Booked Products</th>
                            <th>Total Amount</th>
                            <th>Payment Channel</th>
                            <th>Production / Slip Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.PreOrders)
                        {
                            <tr>
                                <td class="font-mono text-xs font-bold text-primary">@o.OrderNumber</td>
                                <td class="text-xs font-semibold text-warning">
                                    <i class="fa-solid fa-calendar-day"></i> @o.TargetDeliveryDate.ToString("yyyy-MM-dd")
                                </td>
                                <td>
                                    <div class="font-bold text-xs">@o.CustomerName</div>
                                    <span class="badge badge-ghost badge-xs">@o.CustomerCategory</span>
                                </td>
                                <td class="text-xs">
                                    @foreach (var item in o.Items)
                                    {
                                        <div><strong class="text-base-content">@item.Quantity</strong> loaves of @item.ProductName</div>
                                    }
                                </td>
                                <td class="font-mono text-xs font-bold">₦@o.TotalAmount.ToString("N0")</td>
                                <td>
                                    <span class="badge badge-outline badge-xs font-mono">@o.PaymentMethod</span>
                                </td>
                                <td>
                                    @if (o.IsPrintedForLoading)
                                    {
                                        <span class="badge badge-success badge-xs font-bold gap-1"><i class="fa-solid fa-check"></i> Slip Ready</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-info badge-xs">In Production</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <a asp-page="/Sales/Orders/Receipt" asp-route-id="@o.Id" class="btn btn-xs btn-outline btn-primary">
                                        <i class="fa-solid fa-print"></i> Loading Slip
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
