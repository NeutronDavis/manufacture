@page
@using System.Text.Json
@using Manufacture.Models.DTOs
@model Manufacture.Pages.Sales.Orders.CreateModel
@{
    ViewData["Title"] = Model.IsCustomer ? "Place Pre-Order" : "Point of Sale";
    var productsJson = JsonSerializer.Serialize(Model.Products.Select(p => new
    {
        id = p.RecipeId,
        name = p.Name,
        code = p.Code,
        price = p.SellingPrice,
        available = p.AvailableQuantity,
        unit = p.OutputUnit
    }));
    var bonusJson = JsonSerializer.Serialize(Model.BonusRules.Select(b => new
    {
        recipeId = b.RecipeId,
        threshold = b.ThresholdQuantity,
        bonus = b.BonusQuantity
    }));
}

<div class="space-y-5 w-full max-w-7xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <div class="text-xs opacity-60 mb-1">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Sales/Index" class="hover:underline">Sales &amp; POS</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">@(Model.IsCustomer ? "Pre-Order" : "Point of Sale")</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-cash-register text-primary"></i> @(Model.IsCustomer ? "Place Pre-Order" : "Point of Sale")
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                @(Model.IsCustomer
                    ? "Book your next delivery order. Payment is settled on account."
                    : "Sell from the product repository linked to the selected POS. Stock is deducted when the receipt is printed.")
            </p>
        </div>
        <a asp-page="/Sales/Orders/Index" class="btn btn-sm btn-outline rounded-xl">Orders</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error rounded-2xl text-sm">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form method="post" id="posForm" class="grid grid-cols-1 xl:grid-cols-12 gap-5">
        <div class="xl:col-span-8 space-y-5">
            @if (!Model.IsCustomer)
            {
                <div class="card bg-base-100 border border-base-300 rounded-2xl">
                    <div class="card-body p-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <label class="form-control">
                            <span class="label-text text-[10px] font-bold uppercase opacity-60">POS Register Terminal</span>
                            <select asp-for="OrderInput.PosTerminalCode" id="terminalSelect" class="select select-sm select-bordered rounded-xl" disabled="@Model.IsSalesRep">
                                @foreach (var terminal in Model.Terminals)
                                {
                                    <option value="@terminal.TerminalCode" data-id="@terminal.Id" data-repository="@terminal.ProductRepositoryName" selected="@(terminal.TerminalCode == Model.SelectedTerminalCode)">
                                        @terminal.TerminalCode · @terminal.TerminalName
                                    </option>
                                }
                            </select>
                            @if (Model.IsSalesRep)
                            {
                                <input type="hidden" name="OrderInput.PosTerminalCode" value="@Model.SelectedTerminalCode" />
                            }
                            <span id="directoryLabel" class="label-text-alt text-[10px] opacity-60">Directory: @Model.RepositoryName</span>
                        </label>
                        <label class="form-control">
                            <span class="label-text text-[10px] font-bold uppercase opacity-60">Order Flow Type</span>
                            <select asp-for="OrderInput.OrderType" class="select select-sm select-bordered rounded-xl">
                                <option value="ImmediateSale">Direct Walk-in Sale</option>
                                <option value="PreOrder">Pre-Order (collect later)</option>
                            </select>
                        </label>
                    </div>
                </div>
            }

            <div class="card bg-base-100 border border-base-300 rounded-2xl">
                <div class="card-body p-4 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-2 items-end">
                        <div class="form-control min-w-0 sm:col-span-8">
                            <label for="productSearch" class="label py-0 pb-1">
                                <span class="label-text text-[10px] font-bold uppercase opacity-60">Search Product</span>
                            </label>
                            <input id="productSearch" list="productOptions" class="input input-sm input-bordered rounded-xl w-full" placeholder="Type a product name or code…" autocomplete="off" />
                            <datalist id="productOptions">
                                @foreach (var product in Model.Products)
                                {
                                    <option value="@product.Name — @product.Code">@product.SellingPrice.ToString("N0") · @product.AvailableQuantity.ToString("N0") @product.OutputUnit available</option>
                                }
                            </datalist>
                        </div>
                        <div class="form-control sm:col-span-2">
                            <label for="productQty" class="label py-0 pb-1">
                                <span class="label-text text-[10px] font-bold uppercase opacity-60">Quantity</span>
                            </label>
                            <input id="productQty" type="number" min="1" value="1" class="input input-sm input-bordered rounded-xl text-right font-mono w-full" />
                        </div>
                        <button type="button" id="addProduct" class="btn btn-sm btn-primary rounded-xl font-bold w-full sm:col-span-2">Add</button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="table table-sm text-xs">
                            <thead>
                                <tr class="text-[10px] uppercase opacity-60">
                                    <th>Product</th>
                                    <th class="text-right">Unit Price</th>
                                    <th class="text-right">Qty</th>
                                    <th class="text-right">Bonus</th>
                                    <th class="text-right">Line Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="basketBody">
                                <tr id="emptyBasket"><td colspan="6" class="text-center py-8 opacity-50">Basket is empty. Search and add a product.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="xl:col-span-4 space-y-5">
            <div class="card bg-base-100 border border-base-300 rounded-2xl">
                <div class="card-body p-5 space-y-4">
                    <h2 class="font-black text-sm">Order Settlement Summary</h2>

                    @if (!Model.IsCustomer)
                    {
                        <label class="form-control">
                            <span class="label-text text-[10px] font-bold uppercase opacity-60">Payment Method</span>
                            <select asp-for="OrderInput.PaymentMethod" class="select select-sm select-bordered rounded-xl w-full">
                                <option value="Cash">Cash</option>
                                <option value="BankTransfer">Bank Transfer</option>
                                <option value="PosBank">POS Bank</option>
                                <option value="CreditOwing">Credit Owing</option>
                            </select>
                        </label>
                    }
                    else
                    {
                        <input type="hidden" asp-for="OrderInput.PaymentMethod" value="CreditOwing" />
                        <div class="rounded-xl bg-base-200 p-3 text-xs">Payment: <b>Customer Credit</b></div>
                    }

                    <div class="grid grid-cols-2 gap-3">
                        <label class="form-control">
                            <span class="label-text text-[10px] font-bold uppercase opacity-60">Discount (₦)</span>
                            <input asp-for="OrderInput.Discount" type="number" min="0" step="0.01" class="input input-sm input-bordered rounded-xl text-right font-mono" />
                        </label>
                        <label class="form-control">
                            <span class="label-text text-[10px] font-bold uppercase opacity-60">Amount Paid (₦)</span>
                            <input asp-for="OrderInput.AmountPaid" type="number" min="0" step="0.01" class="input input-sm input-bordered rounded-xl text-right font-mono" />
                        </label>
                    </div>

                    <label class="form-control">
                        <span class="label-text text-[10px] font-bold uppercase opacity-60">Remarks</span>
                        <textarea asp-for="OrderInput.Notes" class="textarea textarea-bordered textarea-sm rounded-xl w-full" rows="3" placeholder="Optional note for this sale…"></textarea>
                    </label>

                    <div class="rounded-xl bg-base-200 p-4 space-y-2 text-xs">
                        <div class="flex justify-between"><span class="opacity-60">Items</span><span id="summaryCount" class="font-mono font-bold">0</span></div>
                        <div class="flex justify-between"><span class="opacity-60">Subtotal</span><span id="summarySubtotal" class="font-mono font-bold">₦0</span></div>
                        <div class="flex justify-between"><span class="opacity-60">Discount</span><span id="summaryDiscount" class="font-mono">₦0</span></div>
                        <div class="flex justify-between border-t border-base-300 pt-2"><span class="font-bold">Total</span><span id="summaryTotal" class="font-mono font-black">₦0</span></div>
                        <div class="flex justify-between"><span class="opacity-60">Paid</span><span id="summaryPaid" class="font-mono">₦0</span></div>
                        <div class="flex justify-between"><span class="opacity-60">Balance</span><span id="summaryBalance" class="font-mono font-bold">₦0</span></div>
                    </div>

                    <button type="submit" class="btn btn-primary w-full rounded-xl font-black gap-2">
                        <i class="fa-solid fa-check"></i> @(Model.IsCustomer ? "Place Pre-Order" : "Save Order & Open Receipt")
                    </button>
                    <p class="text-[10px] opacity-60 text-center">
                        @(Model.IsCustomer ? "No stock is deducted for a pre-order." : "Stock is deducted after you print the receipt.")
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const bonusRules = @Html.Raw(bonusJson);
        const isCustomer = @(Model.IsCustomer ? "true" : "false");
        let products = @Html.Raw(productsJson);
        let productByKey = {};

        function rebuildProductIndex() {
            productByKey = {};
            products.forEach(p => {
                productByKey[p.name.toLowerCase()] = p;
                productByKey[p.code.toLowerCase()] = p;
                productByKey[`${p.name} — ${p.code}`.toLowerCase()] = p;
            });
        }

        function renderProductOptions() {
            const list = document.getElementById('productOptions');
            list.innerHTML = '';
            products.forEach(p => {
                const option = document.createElement('option');
                option.value = `${p.name} — ${p.code}`;
                option.textContent = `${Math.round(p.price).toLocaleString()} · ${p.available} ${p.unit} available`;
                list.appendChild(option);
            });
        }

        async function reloadProductsForTerminal() {
            const select = document.getElementById('terminalSelect');
            const option = select?.selectedOptions?.[0];
            const terminalId = option?.dataset?.id;
            if (!terminalId) return;

            const response = await fetch(`?handler=Products&terminalId=${encodeURIComponent(terminalId)}`);
            if (!response.ok) return;

            products = await response.json();
            basket = [];
            rebuildProductIndex();
            renderProductOptions();

            const directoryLabel = document.getElementById('directoryLabel');
            if (directoryLabel) {
                directoryLabel.textContent = `Directory: ${option.dataset.repository || ''}`;
            }

            render();
        }

        let basket = [];

        const money = value => '₦' + Math.round(value).toLocaleString();

        function bonusFor(recipeId, quantity) {
            const rule = bonusRules.find(r => r.recipeId === recipeId);
            if (!rule || rule.threshold <= 0) return 0;
            return Math.floor(quantity / rule.threshold) * rule.bonus;
        }

        function addProduct() {
            const input = document.getElementById('productSearch');
            const qtyInput = document.getElementById('productQty');
            const key = input.value.trim().toLowerCase();
            const product = productByKey[key];
            const quantity = parseInt(qtyInput.value || '1', 10);

            if (!product) {
                input.classList.add('input-error');
                input.focus();
                return;
            }
            input.classList.remove('input-error');
            if (!isCustomer && quantity > product.available) {
                alert(`Only ${product.available} ${product.unit} of ${product.name} is available in this repository.`);
                return;
            }

            const existing = basket.find(x => x.id === product.id);
            if (existing) {
                existing.quantity += quantity;
                existing.bonus = bonusFor(product.id, existing.quantity);
            } else {
                basket.push({
                    id: product.id,
                    name: product.name,
                    code: product.code,
                    price: product.price,
                    unit: product.unit,
                    quantity: quantity,
                    bonus: bonusFor(product.id, quantity)
                });
            }

            input.value = '';
            qtyInput.value = '1';
            input.focus();
            render();
        }

        function changeQty(id, delta) {
            const item = basket.find(x => x.id === id);
            if (!item) return;
            item.quantity = Math.max(0, item.quantity + delta);
            if (item.quantity === 0) {
                basket = basket.filter(x => x.id !== id);
            } else {
                item.bonus = bonusFor(id, item.quantity);
            }
            render();
        }

        function removeItem(id) {
            basket = basket.filter(x => x.id !== id);
            render();
        }

        function render() {
            const body = document.getElementById('basketBody');
            body.innerHTML = '';

            if (basket.length === 0) {
                body.innerHTML = '<tr id="emptyBasket"><td colspan="6" class="text-center py-8 opacity-50">Basket is empty. Search and add a product.</td></tr>';
            }

            basket.forEach((item, index) => {
                const lineTotal = item.quantity * item.price;
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>
                        <div class="font-bold">${item.name}</div>
                        <div class="font-mono text-[10px] opacity-60">${item.code}</div>
                        <input type="hidden" name="OrderInput.Items[${index}].RecipeId" value="${item.id}" />
                        <input type="hidden" name="OrderInput.Items[${index}].ProductName" value="${item.name}" />
                        <input type="hidden" name="OrderInput.Items[${index}].UnitPrice" value="${item.price}" />
                        <input type="hidden" name="OrderInput.Items[${index}].BonusQuantity" value="${item.bonus}" />
                    </td>
                    <td class="text-right font-mono">${money(item.price)}</td>
                    <td class="text-right">
                        <div class="join">
                            <button type="button" class="btn btn-xs join-item" onclick="changeQty(${item.id}, -1)">−</button>
                            <input type="number" min="1" name="OrderInput.Items[${index}].Quantity" value="${item.quantity}" class="input input-xs input-bordered join-item w-16 text-right font-mono" />
                            <button type="button" class="btn btn-xs join-item" onclick="changeQty(${item.id}, 1)">+</button>
                        </div>
                    </td>
                    <td class="text-right font-mono">${item.bonus > 0 ? '+' + item.bonus : '—'}</td>
                    <td class="text-right font-mono font-bold">${money(lineTotal)}</td>
                    <td class="text-right"><button type="button" class="btn btn-xs btn-ghost text-error" onclick="removeItem(${item.id})">✕</button></td>
                `;
                body.appendChild(row);
            });

            const subtotal = basket.reduce((sum, item) => sum + item.quantity * item.price, 0);
            const discount = Math.max(0, parseFloat(document.getElementById('OrderInput_Discount')?.value || '0'));
            const total = Math.max(0, subtotal - discount);
            const paid = parseFloat(document.getElementById('OrderInput_AmountPaid')?.value || '0');

            document.getElementById('summaryCount').textContent = basket.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('summarySubtotal').textContent = money(subtotal);
            document.getElementById('summaryDiscount').textContent = money(discount);
            document.getElementById('summaryTotal').textContent = money(total);
            document.getElementById('summaryPaid').textContent = money(paid);
            document.getElementById('summaryBalance').textContent = money(Math.max(0, total - paid));
        }

        document.getElementById('addProduct')?.addEventListener('click', addProduct);
        document.getElementById('productSearch')?.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                addProduct();
            }
        });
        document.getElementById('OrderInput_Discount')?.addEventListener('input', render);
        document.getElementById('OrderInput_AmountPaid')?.addEventListener('input', render);
        document.getElementById('terminalSelect')?.addEventListener('change', reloadProductsForTerminal);

        document.getElementById('productSearch')?.addEventListener('change', () => {
            const product = productByKey[document.getElementById('productSearch').value.trim().toLowerCase()];
            if (product && !isCustomer) {
                document.getElementById('productQty').max = product.available;
            }
        });

        rebuildProductIndex();
        render();
    </script>
}
