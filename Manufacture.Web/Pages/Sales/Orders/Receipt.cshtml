@page "{id:int}"
@using Manufacture.Models.Domain
@model Manufacture.Pages.Sales.Orders.ReceiptModel
@{
    ViewData["Title"] = $"Receipt {Model.Order.OrderNumber}";
    var isAdvancePreOrder = Model.Order.Type == OrderType.PreOrder && Model.Order.StockDeductedAt == null;
}

<style>
    @@media print {
        body * { visibility: hidden; }
        #printableSlip, #printableSlip * { visibility: visible; }
        #printableSlip { position: absolute; left: 0; top: 0; width: 80mm; margin: 0; padding: 4mm; border: none; box-shadow: none; }
        .no-print { display: none !important; }
    }
    #printableSlip { font-family: 'Courier New', monospace; font-size: 11px; }
</style>

<div class="space-y-5 w-full max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 no-print">
        <div>
            <div class="text-xs opacity-60 mb-1">
                <a asp-page="/Sales/Orders/Index" class="hover:underline">Orders</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Receipt</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-receipt text-primary"></i> @Model.Order.OrderNumber
            </h1>
            <p class="text-xs opacity-70 mt-0.5">@Model.Order.OrderDate.ToString("yyyy-MM-dd HH:mm") · @Model.Order.CustomerName</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <a asp-page="/Sales/Orders/Index" class="btn btn-sm btn-outline rounded-xl">Back</a>
            <a asp-page="/Sales/Orders/Create" class="btn btn-sm btn-neutral rounded-xl">New Sale</a>

            @if (Model.Order.StockDeductedAt == null)
            {
                @if (isAdvancePreOrder)
                {
                    <button type="button" onclick="window.print()" class="btn btn-sm btn-outline rounded-xl">Print Advance Slip</button>
                    <form method="post" asp-page-handler="PrintAndDeduct">
                        <input type="hidden" name="id" value="@Model.Order.Id" />
                        <button type="submit" class="btn btn-sm btn-primary rounded-xl font-bold">Collect, Deduct &amp; Print</button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="PrintAndDeduct">
                        <input type="hidden" name="id" value="@Model.Order.Id" />
                        <button type="submit" class="btn btn-sm btn-primary rounded-xl font-bold gap-2">
                            <i class="fa-solid fa-print"></i> Print Receipt &amp; Deduct Stock
                        </button>
                    </form>
                }
            }
            else
            {
                <button type="button" onclick="window.print()" class="btn btn-sm btn-primary rounded-xl font-bold gap-2">
                    <i class="fa-solid fa-print"></i> Reprint Receipt
                </button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success rounded-2xl text-sm font-semibold no-print">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-error rounded-2xl text-sm font-semibold no-print">@error</div>
    }

    @if (isAdvancePreOrder)
    {
        <div class="alert alert-info rounded-2xl text-xs no-print">
            <i class="fa-solid fa-circle-info mr-1"></i>
            This is an advance pre-order slip. Stock is not deducted yet; use <b>Collect, Deduct &amp; Print</b> when the customer collects the order.
        </div>
    }
    else if (Model.Order.StockDeductedAt != null)
    {
        <div class="alert alert-success rounded-2xl text-xs no-print">
            <i class="fa-solid fa-boxes-stacked mr-1"></i>
            Stock deducted on @Model.Order.StockDeductedAt?.ToString("yyyy-MM-dd HH:mm") by @Model.Order.StockDeductedBy.
        </div>
    }

    <div class="card bg-base-100 border border-base-300 rounded-2xl no-print">
        <div class="card-body p-5 space-y-4">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                <div><div class="text-[10px] uppercase opacity-60">Customer</div><div class="font-bold">@Model.Order.CustomerName</div></div>
                <div><div class="text-[10px] uppercase opacity-60">POS Terminal</div><div class="font-mono font-bold">@(Model.Order.PosTerminalCode ?? "—")</div></div>
                <div><div class="text-[10px] uppercase opacity-60">Sales Rep</div><div class="font-bold">@(Model.Order.SalesRepName ?? "Counter")</div></div>
                <div><div class="text-[10px] uppercase opacity-60">Payment</div><div class="font-bold">@Model.Order.PaymentMethod · @Model.Order.PaymentStatus</div></div>
            </div>

            <div class="overflow-x-auto">
                <table class="table table-sm text-xs">
                    <thead>
                        <tr class="text-[10px] uppercase opacity-60">
                            <th>Product</th>
                            <th class="text-right">Qty</th>
                            <th class="text-right">Bonus</th>
                            <th class="text-right">Unit Price</th>
                            <th class="text-right">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Order.Items)
                        {
                            <tr>
                                <td class="font-bold">@item.ProductName</td>
                                <td class="text-right font-mono">@item.Quantity</td>
                                <td class="text-right font-mono">@item.BonusQuantity</td>
                                <td class="text-right font-mono">₦@item.UnitPrice.ToString("N2")</td>
                                <td class="text-right font-mono font-bold">₦@item.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ml-auto w-full sm:w-72 space-y-1 text-xs">
                <div class="flex justify-between"><span class="opacity-60">Subtotal</span><span class="font-mono">₦@Model.Order.SubTotal.ToString("N2")</span></div>
                <div class="flex justify-between"><span class="opacity-60">Discount</span><span class="font-mono">₦@Model.Order.Discount.ToString("N2")</span></div>
                <div class="flex justify-between font-bold border-t border-base-300 pt-1"><span>Total</span><span class="font-mono">₦@Model.Order.TotalAmount.ToString("N2")</span></div>
                <div class="flex justify-between"><span class="opacity-60">Amount paid</span><span class="font-mono">₦@Model.Order.AmountPaid.ToString("N2")</span></div>
                <div class="flex justify-between"><span class="opacity-60">Balance due</span><span class="font-mono">₦@Model.Order.BalanceDue.ToString("N2")</span></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Order.Notes))
            {
                <div class="text-xs rounded-xl bg-base-200 p-3"><span class="font-bold">Remarks:</span> @Model.Order.Notes</div>
            }
        </div>
    </div>

    <div id="printableSlip" class="bg-base-100 border border-base-300 rounded-2xl p-6 mx-auto">
        <div class="text-center">
            <div class="text-base font-black tracking-widest">MAURECORDS</div>
            <div class="text-[10px] uppercase tracking-widest">@(Model.Order.Type == OrderType.PreOrder ? "Advance Pre-Order Slip" : "Sales Receipt")</div>
            <div class="border-t border-dashed border-base-300 my-2"></div>
        </div>

        <div class="space-y-0.5">
            <div class="flex justify-between"><span>Receipt:</span><span>@Model.Order.OrderNumber</span></div>
            <div class="flex justify-between"><span>Date:</span><span>@Model.Order.OrderDate.ToString("yyyy-MM-dd HH:mm")</span></div>
            <div class="flex justify-between"><span>Customer:</span><span>@Model.Order.CustomerName</span></div>
            <div class="flex justify-between"><span>POS:</span><span>@(Model.Order.PosTerminalCode ?? "—")</span></div>
            <div class="flex justify-between"><span>Rep:</span><span>@(Model.Order.SalesRepName ?? "Counter")</span></div>
            <div class="border-t border-dashed border-base-300 my-2"></div>
        </div>

        @foreach (var item in Model.Order.Items)
        {
            <div class="mb-1">
                <div class="font-bold">@item.ProductName</div>
                <div class="flex justify-between">
                    <span>@item.Quantity x ₦@item.UnitPrice.ToString("N2")@(item.BonusQuantity > 0 ? $" +{item.BonusQuantity} bonus" : "")</span>
                    <span>₦@item.TotalPrice.ToString("N2")</span>
                </div>
            </div>
        }

        <div class="border-t border-dashed border-base-300 my-2"></div>
        <div class="space-y-0.5">
            <div class="flex justify-between"><span>Subtotal</span><span>₦@Model.Order.SubTotal.ToString("N2")</span></div>
            <div class="flex justify-between"><span>Discount</span><span>₦@Model.Order.Discount.ToString("N2")</span></div>
            <div class="flex justify-between font-black"><span>TOTAL</span><span>₦@Model.Order.TotalAmount.ToString("N2")</span></div>
            <div class="flex justify-between"><span>Paid (@Model.Order.PaymentMethod)</span><span>₦@Model.Order.AmountPaid.ToString("N2")</span></div>
            <div class="flex justify-between"><span>Balance</span><span>₦@Model.Order.BalanceDue.ToString("N2")</span></div>
        </div>

        <div class="border-t border-dashed border-base-300 my-2"></div>
        <div class="text-center text-[10px]">
            @if (Model.Order.StockDeductedAt != null)
            {
                <div>Stock deducted from POS repository</div>
                <div>@Model.Order.StockDeductedAt?.ToString("yyyy-MM-dd HH:mm")</div>
            }
            else
            {
                <div>Stock not yet deducted</div>
            }
            <div class="mt-2">Thank you for your business</div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.AutoPrint)
    {
        <script>window.addEventListener('load', () => window.print());</script>
    }
}
