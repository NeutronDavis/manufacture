@page
@using System.Text.Json
@using Manufacture.Models.DTOs
@model Manufacture.Pages.Production.Batches.CreateModel
@{
    ViewData["Title"] = "Record Production Batch";
    var recipeJson = JsonSerializer.Serialize(Model.Recipes.Select(r => new
    {
        id = r.Id,
        name = r.Name,
        code = r.Code,
        expectedYield = r.ExpectedYield,
        outputUnit = r.OutputUnit,
        baseline = string.IsNullOrWhiteSpace(r.Baseline) ? "Batch" : r.Baseline,
        materialCost = r.TotalBatchCost,
        category = r.CategoryName
    }));
    var stockJson = JsonSerializer.Serialize(Model.FactoryStock.ToDictionary(
        s => s.RecipeId,
        s => new { available = s.QuantityOnHand, threshold = s.ReorderThreshold }));
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Production/Batches/Index" class="hover:underline">Batches</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">New Batch</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-layer-group text-primary"></i> Record Production Batch
            </h1>
            <p class="text-xs opacity-70 mt-0.5">Plan multiple products in one run. Actual output is recorded after the batch is complete.</p>
        </div>
        <a asp-page="/Production/Batches/Index" class="btn btn-sm btn-outline rounded-xl">Back to Batches</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error rounded-2xl text-sm">
            <div class="flex flex-col gap-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@error.ErrorMessage</span>
                }
            </div>
        </div>
    }

    <form method="post" id="batchForm" class="space-y-6">
        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-5 grid grid-cols-1 md:grid-cols-4 gap-4">
                <label class="form-control">
                    <span class="label-text text-[10px] font-bold uppercase opacity-60">Shift</span>
                    <select asp-for="BatchInput.Shift" class="select select-sm select-bordered rounded-xl">
                        @foreach (var shift in Model.Shifts)
                        {
                            <option value="@shift.Name">@shift.Name</option>
                        }
                        @if (!Model.Shifts.Any())
                        {
                            <option value="Morning Shift">Morning Shift</option>
                        }
                    </select>
                </label>
                <label class="form-control">
                    <span class="label-text text-[10px] font-bold uppercase opacity-60">Baker / Operator</span>
                    <input asp-for="BatchInput.BakerInCharge" class="input input-sm input-bordered rounded-xl" required />
                </label>
                <label class="form-control">
                    <span class="label-text text-[10px] font-bold uppercase opacity-60">Production Date</span>
                    <input asp-for="BatchInput.ProductionDate" type="date" value="@Model.BatchInput.ProductionDate.ToString("yyyy-MM-dd")" class="input input-sm input-bordered rounded-xl" />
                </label>
                <label class="form-control">
                    <span class="label-text text-[10px] font-bold uppercase opacity-60">Output Repository</span>
                    <input type="text" value="@Model.FactoryRepositoryName" class="input input-sm input-bordered rounded-xl" disabled />
                    <span class="label-text-alt text-[10px] opacity-60">Default factory repository</span>
                </label>
                <label class="form-control md:col-span-4">
                    <span class="label-text text-[10px] font-bold uppercase opacity-60">Notes</span>
                    <input asp-for="BatchInput.Notes" class="input input-sm input-bordered rounded-xl" placeholder="Optional production notes" />
                </label>
            </div>
        </div>

        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-5 space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="font-black text-sm">Product Lines</h2>
                    <button type="button" id="addLine" class="btn btn-xs btn-primary rounded-lg font-bold">
                        <i class="fa-solid fa-plus"></i> Add Product
                    </button>
                </div>

                <div id="lineRows" class="space-y-3">
                    @for (var i = 0; i < Model.BatchInput.Lines.Count; i++)
                    {
                        var line = Model.BatchInput.Lines[i];
                        <div class="line-row rounded-xl border border-base-300 p-3 grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                            <label class="form-control md:col-span-5">
                                <span class="label-text text-[10px] font-bold uppercase opacity-60">Product Recipe</span>
                                <select name="BatchInput.Lines[@i].RecipeId" class="select select-sm select-bordered rounded-xl recipe-select" required>
                                    <option value="">Select product…</option>
                                    @foreach (var recipe in Model.Recipes)
                                    {
                                        <option value="@recipe.Id" selected="@(recipe.Id == line.RecipeId)">@recipe.Name (@recipe.Code)</option>
                                    }
                                </select>
                            </label>
                            <label class="form-control md:col-span-2">
                                <span class="label-text text-[10px] font-bold uppercase opacity-60">Target Qty</span>
                                <input type="number" min="1" name="BatchInput.Lines[@i].TargetQuantity" value="@line.TargetQuantity" class="input input-sm input-bordered rounded-xl target-input" required />
                            </label>
                            <div class="md:col-span-2 text-[11px] leading-tight">
                                <div class="opacity-60">Available</div>
                                <div class="font-mono font-bold stock-available">—</div>
                                <div class="opacity-60">Threshold <span class="font-mono stock-threshold">—</span></div>
                            </div>
                            <div class="md:col-span-2 text-[11px] leading-tight">
                                <div class="opacity-60">Est. material cost</div>
                                <div class="font-mono font-bold line-cost">₦0</div>
                                <div class="opacity-60 unit-hint"></div>
                            </div>
                            <div class="md:col-span-1 text-right">
                                <button type="button" class="btn btn-xs btn-ghost text-error remove-line" title="Remove line">✕</button>
                            </div>
                        </div>
                    }
                </div>

                <div class="flex items-center justify-end gap-6 border-t border-base-200 pt-3 text-xs">
                    <div>Total target: <span id="totalTarget" class="font-mono font-bold">0</span></div>
                    <div>Estimated material cost: <span id="totalCost" class="font-mono font-bold">₦0</span></div>
                </div>
            </div>
        </div>

        <div class="flex justify-end gap-2">
            <a asp-page="/Production/Batches/Index" class="btn btn-sm btn-outline rounded-xl">Cancel</a>
            <button type="submit" class="btn btn-sm btn-primary rounded-xl font-bold px-6">Create Batch</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const recipes = @Html.Raw(recipeJson);
        const stock = @Html.Raw(stockJson);
        const recipeById = Object.fromEntries(recipes.map(r => [String(r.id), r]));
        const money = value => '₦' + Math.round(value).toLocaleString();

        function reindexRows() {
            document.querySelectorAll('.line-row').forEach((row, index) => {
                row.querySelectorAll('select, input').forEach(input => {
                    if (!input.name) return;
                    input.name = input.name.replace(/Lines\[\d+\]/, `Lines[${index}]`);
                });
            });
        }

        function updateRow(row) {
            const select = row.querySelector('.recipe-select');
            const targetInput = row.querySelector('.target-input');
            const recipe = recipeById[select.value];
            const target = parseInt(targetInput.value || '0', 10);
            const availableEl = row.querySelector('.stock-available');
            const thresholdEl = row.querySelector('.stock-threshold');
            const costEl = row.querySelector('.line-cost');
            const unitEl = row.querySelector('.unit-hint');

            if (!recipe) {
                availableEl.textContent = '—';
                thresholdEl.textContent = '—';
                costEl.textContent = '₦0';
                unitEl.textContent = '';
                recalcTotals();
                return;
            }

            const info = stock[String(recipe.id)] || { available: 0, threshold: 0 };
            availableEl.textContent = `${Number(info.available || 0).toLocaleString()} ${recipe.outputUnit}`;
            thresholdEl.textContent = `${Number(info.threshold || 0).toLocaleString()}`;

            const inputQty = recipe.expectedYield > 0 ? target / recipe.expectedYield : 1;
            const cost = recipe.materialCost * inputQty;
            costEl.textContent = money(cost);
            unitEl.textContent = target > 0 ? `${money(cost / target)} / ${recipe.outputUnit}` : '';

            recalcTotals();
        }

        function recalcTotals() {
            let targets = 0;
            let cost = 0;
            document.querySelectorAll('.line-row').forEach(row => {
                targets += parseInt(row.querySelector('.target-input')?.value || '0', 10);
                const recipe = recipeById[row.querySelector('.recipe-select')?.value];
                const target = parseInt(row.querySelector('.target-input')?.value || '0', 10);
                if (recipe) {
                    const inputQty = recipe.expectedYield > 0 ? target / recipe.expectedYield : 1;
                    cost += recipe.materialCost * inputQty;
                }
            });
            document.getElementById('totalTarget').textContent = targets.toLocaleString();
            document.getElementById('totalCost').textContent = money(cost);
        }

        function wireRow(row) {
            row.querySelector('.recipe-select').addEventListener('change', () => {
                const recipe = recipeById[row.querySelector('.recipe-select').value];
                if (recipe && parseInt(row.querySelector('.target-input').value || '0', 10) <= 0) {
                    row.querySelector('.target-input').value = Math.max(1, Math.round(recipe.expectedYield));
                }
                updateRow(row);
            });
            row.querySelector('.target-input').addEventListener('input', () => updateRow(row));
            row.querySelector('.remove-line').addEventListener('click', () => {
                if (document.querySelectorAll('.line-row').length <= 1) return;
                row.remove();
                reindexRows();
                recalcTotals();
            });
            updateRow(row);
        }

        document.querySelectorAll('.line-row').forEach(wireRow);

        document.getElementById('addLine').addEventListener('click', () => {
            const template = document.querySelector('.line-row');
            const clone = template.cloneNode(true);
            clone.querySelector('.recipe-select').value = '';
            clone.querySelector('.target-input').value = '';
            document.getElementById('lineRows').appendChild(clone);
            reindexRows();
            wireRow(clone);
        });

        reindexRows();
        recalcTotals();
    </script>
}
