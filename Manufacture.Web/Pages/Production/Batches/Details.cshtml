@page "{id:int}"
@using Manufacture.Models.Domain
@model Manufacture.Pages.Production.Batches.DetailsModel
@{
    ViewData["Title"] = $"Batch {Model.Batch.BatchNumber}";
    var isCompleted = Model.Batch.Status == BatchStatus.Completed;
    var statusBadge = Model.Batch.Status switch
    {
        BatchStatus.Completed => "badge-success",
        BatchStatus.Cancelled => "badge-error",
        BatchStatus.Baking => "badge-info",
        BatchStatus.InMixing => "badge-warning",
        _ => "badge-neutral"
    };
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Production/Batches/Index" class="hover:underline">Batches</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">@Model.Batch.BatchNumber</span>
            </div>
            <div class="flex items-center gap-2">
                <h1 class="text-2xl font-black tracking-tight">@Model.Batch.BatchNumber</h1>
                <span class="badge @statusBadge badge-sm font-bold">@Model.Batch.Status</span>
            </div>
            <p class="text-xs opacity-70 mt-0.5">
                @Model.Batch.ProductionDate.ToString("yyyy-MM-dd") · @Model.Batch.Shift · @Model.Batch.BakerInCharge
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-page="/Production/Batches/Index" class="btn btn-sm btn-outline rounded-xl">Back</a>
            <a asp-page="/Production/Batches/Create" class="btn btn-sm btn-primary rounded-xl gap-2 font-bold">
                <i class="fa-solid fa-plus"></i> New Batch
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success rounded-2xl text-sm font-semibold">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-error rounded-2xl text-sm font-semibold">@error</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error rounded-2xl text-sm">
            @foreach (var item in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@item.ErrorMessage</div>
            }
        </div>
    }

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-4">
                <div class="text-[10px] uppercase font-bold opacity-60">Product Lines</div>
                <div class="text-2xl font-black font-mono">@Model.Batch.Lines.Count</div>
                <div class="text-[10px] opacity-60 truncate">@Model.Batch.ProductSummary</div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-4">
                <div class="text-[10px] uppercase font-bold opacity-60">Target Units</div>
                <div class="text-2xl font-black font-mono">@Model.Batch.TargetQuantity.ToString("N0")</div>
                <div class="text-[10px] opacity-60">Across all lines</div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-4">
                <div class="text-[10px] uppercase font-bold opacity-60">Actual Units</div>
                <div class="text-2xl font-black font-mono text-success">@Model.Batch.ActualQuantity.ToString("N0")</div>
                <div class="text-[10px] opacity-60">@(isCompleted ? "Recorded" : "Pending outcome")</div>
            </div>
        </div>
        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-4">
                <div class="text-[10px] uppercase font-bold opacity-60">Material Cost</div>
                <div class="text-2xl font-black font-mono">₦@Model.Batch.TotalBatchCost.ToString("N0")</div>
                <div class="text-[10px] opacity-60">Unit cost ₦@Model.Batch.CalculatedUnitCost.ToString("N2")</div>
            </div>
        </div>
    </div>

    <div class="card bg-base-100 border border-base-300 rounded-2xl">
        <div class="card-body p-5 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="font-black text-sm">Product Output Lines</h2>
                @if (!isCompleted && Model.Batch.Status != BatchStatus.Cancelled)
                {
                    <button type="button" class="btn btn-sm btn-primary rounded-xl gap-2 font-bold" onclick="document.getElementById('actualDialog').showModal()">
                        <i class="fa-solid fa-clipboard-check"></i> Register Actual Outcome
                    </button>
                }
            </div>

            <div class="overflow-x-auto">
                <table class="table table-sm text-xs w-full">
                    <thead>
                        <tr class="text-[10px] uppercase opacity-60">
                            <th>Product</th>
                            <th class="text-right">Target</th>
                            <th class="text-right">Actual</th>
                            <th class="text-right">Variance</th>
                            <th class="text-right">Yield</th>
                            <th class="text-right">Input Batch</th>
                            <th class="text-right">Material Cost</th>
                            <th class="text-right">Unit Cost</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Batch.Lines)
                        {
                            <tr>
                                <td>
                                    <div class="font-bold">@line.RecipeName</div>
                                    <div class="font-mono text-[10px] opacity-60">@line.ProductCode</div>
                                </td>
                                <td class="text-right font-mono">@line.TargetQuantity.ToString("N0") <span class="opacity-60">@line.OutputUnitLabel</span></td>
                                <td class="text-right font-mono font-bold text-success">@line.ActualQuantity.ToString("N0")</td>
                                <td class="text-right font-mono @(line.Variance < 0 ? "text-error" : "text-success")">@line.Variance.ToString("+0;-0;0")</td>
                                <td class="text-right font-mono">@line.YieldPercent.ToString("N1")%</td>
                                <td class="text-right font-mono">@line.BatchInputQuantity.ToString("N2") <span class="opacity-60">@line.BatchInputUnitLabel</span></td>
                                <td class="text-right font-mono">₦@line.TotalBatchCost.ToString("N0")</td>
                                <td class="text-right font-mono">₦@line.CalculatedUnitCost.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (isCompleted)
            {
                <div class="rounded-xl bg-success/10 border border-success/30 p-3 text-xs text-success font-semibold">
                    <i class="fa-solid fa-warehouse mr-1"></i>
                    Actual output has been posted to the default factory product repository. Movement history is available in Product Repositories.
                </div>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-5 space-y-3">
                <h2 class="font-black text-sm">Batch Parameters</h2>
                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div><div class="opacity-60 text-[10px] uppercase">Production date</div><div class="font-semibold">@Model.Batch.ProductionDate.ToString("yyyy-MM-dd")</div></div>
                    <div><div class="opacity-60 text-[10px] uppercase">Shift</div><div class="font-semibold">@Model.Batch.Shift</div></div>
                    <div><div class="opacity-60 text-[10px] uppercase">Baker / operator</div><div class="font-semibold">@Model.Batch.BakerInCharge</div></div>
                    <div><div class="opacity-60 text-[10px] uppercase">Logged by</div><div class="font-semibold">@Model.Batch.LoggedBy</div></div>
                    <div><div class="opacity-60 text-[10px] uppercase">Expected unit cost</div><div class="font-mono">₦@Model.Batch.ExpectedUnitCost.ToString("N2")</div></div>
                    <div><div class="opacity-60 text-[10px] uppercase">Completed</div><div class="font-mono">@(Model.Batch.CompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Batch.Notes))
                {
                    <div class="text-xs"><span class="opacity-60">Notes:</span> @Model.Batch.Notes</div>
                }
            </div>
        </div>

        <div class="card bg-base-100 border border-base-300 rounded-2xl">
            <div class="card-body p-5 space-y-3">
                <div class="flex items-center justify-between">
                    <h2 class="font-black text-sm">Defects</h2>
                    <span class="badge badge-error badge-sm">@Model.TotalBatchDefects unit(s)</span>
                </div>
                @if (Model.BatchDefects.Count > 0)
                {
                    <div class="space-y-1 text-xs">
                        @foreach (var defect in Model.BatchDefects)
                        {
                            <div class="flex justify-between rounded-lg bg-base-200 px-2 py-1">
                                <span>@(string.IsNullOrWhiteSpace(defect.ProductName) ? "Product" : defect.ProductName) · @defect.DefectReason</span>
                                <span class="font-mono font-bold">@defect.Quantity</span>
                            </div>
                        }
                    </div>
                }
                @if (!isCompleted)
                {
                    <form method="post" asp-page-handler="LogDefects" class="space-y-2 border-t border-base-200 pt-3">
                        <input type="hidden" name="DefectInput.BatchId" value="@Model.Batch.Id" />
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                            <select name="DefectInput.RecipeId" class="select select-sm select-bordered rounded-xl">
                                @foreach (var line in Model.Batch.Lines)
                                {
                                    <option value="@line.RecipeId" selected="@(line.RecipeId == Model.DefectInput.RecipeId)">@line.RecipeName</option>
                                }
                            </select>
                            <input type="number" min="0" name="DefectInput.Quantity" class="input input-sm input-bordered rounded-xl" placeholder="Qty" />
                            <input type="text" name="DefectInput.Reason" class="input input-sm input-bordered rounded-xl" placeholder="Reason" />
                        </div>
                        <button type="submit" class="btn btn-xs btn-outline rounded-lg">Save Defect</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="card bg-base-100 border border-base-300 rounded-2xl">
        <div class="card-body p-5 space-y-4">
            <h2 class="font-black text-sm">Scaled Bill of Materials</h2>
            @foreach (var line in Model.Batch.Lines)
            {
                if (!Model.LineRecipes.TryGetValue(line.RecipeId, out var recipe))
                {
                    continue;
                }
                <div class="rounded-xl border border-base-200 p-3">
                    <div class="font-bold text-xs mb-2">@recipe.Name <span class="font-mono opacity-60">(@recipe.Code)</span></div>
                    <table class="table table-xs text-[11px]">
                        <thead>
                            <tr class="opacity-60"><th>Ingredient</th><th class="text-right">Per unit</th><th class="text-right">For target</th><th class="text-right">Unit cost</th><th class="text-right">Line cost</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ingredient in recipe.Ingredients)
                            {
                                var perUnit = ingredient.QuantityPerUnit;
                                var forTarget = perUnit * line.TargetQuantity;
                                <tr>
                                    <td>@ingredient.IngredientName</td>
                                    <td class="text-right font-mono">@perUnit.ToString("N3") @ingredient.Unit</td>
                                    <td class="text-right font-mono">@forTarget.ToString("N2") @ingredient.Unit</td>
                                    <td class="text-right font-mono">₦@ingredient.IngredientUnitCost.ToString("N2")</td>
                                    <td class="text-right font-mono">₦@(Math.Round(forTarget * ingredient.IngredientUnitCost, 2)).ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<dialog id="actualDialog" class="modal">
    <div class="modal-box max-w-2xl rounded-2xl">
        <h3 class="font-black text-lg">Register Actual Outcome</h3>
        <p class="text-xs opacity-70 mt-1">Enter the actual output for every product line. Saving completes the batch and posts stock to the default factory repository.</p>
        <form method="post" asp-page-handler="RecordActuals" class="space-y-3 mt-4">
            <input type="hidden" name="ActualsInput.BatchId" value="@Model.Batch.Id" />
            <div class="space-y-2">
                @for (var i = 0; i < Model.Batch.Lines.Count; i++)
                {
                    var line = Model.Batch.Lines[i];
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-center rounded-xl border border-base-300 p-2">
                        <input type="hidden" name="ActualsInput.Lines[@i].LineId" value="@line.Id" />
                        <div class="sm:col-span-2">
                            <div class="font-bold text-xs">@line.RecipeName</div>
                            <div class="text-[10px] opacity-60">Target @line.TargetQuantity.ToString("N0") @line.OutputUnitLabel</div>
                        </div>
                        <label class="form-control">
                            <span class="label-text text-[10px] font-bold uppercase opacity-60">Actual output</span>
                            <input type="number" min="0" name="ActualsInput.Lines[@i].ActualQuantity" value="@line.ActualQuantity" class="input input-sm input-bordered rounded-xl text-right font-mono" required />
                        </label>
                    </div>
                }
            </div>
            <div class="modal-action">
                <button type="button" class="btn btn-sm btn-ghost rounded-xl" onclick="document.getElementById('actualDialog').close()">Cancel</button>
                <button type="submit" class="btn btn-sm btn-primary rounded-xl font-bold">Save Actual Output</button>
            </div>
        </form>
    </div>
</dialog>
