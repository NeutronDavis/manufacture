@page "{id:int}"
@model Manufacture.Pages.Production.Recipes.DetailsModel
@{
    ViewData["Title"] = $"{Model.Recipe.Name} - Recipe Formula";
    var marginBadgeClass = Model.Costing.HasNegativeMargin ? "badge-error"
                         : Model.Costing.HasThinMargin ? "badge-warning"
                         : "badge-success";
    var marginTextColor = Model.Costing.HasNegativeMargin ? "text-error"
                         : Model.Costing.HasThinMargin ? "text-warning"
                         : "text-success";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Production/Recipes/Index" class="hover:underline">Recipes &amp; Costing</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">@Model.Recipe.Name</span>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                    <i class="fa-solid fa-calculator text-primary"></i> @Model.Recipe.Name
                </h1>
                <span class="badge badge-neutral badge-sm font-mono font-bold">@Model.Recipe.Code</span>
                <span class="badge badge-soft badge-sm font-semibold">@Model.Recipe.ProductType</span>
                @if (!Model.Recipe.IsActive)
                {
                    <span class="badge badge-warning badge-sm font-bold">Deactivated</span>
                }
            </div>
            <p class="text-xs opacity-70 mt-0.5">@Model.Recipe.Description</p>
        </div>

        <!-- Header Action Controls with Back Button -->
        <div class="flex items-center gap-2">
            <a asp-page="/Production/Recipes/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl gap-1.5 text-xs font-semibold">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Recipes
            </a>
            
            <a asp-page="/Production/Recipes/Edit" asp-route-id="@Model.Recipe.Id" class="btn btn-sm btn-outline border-base-300 rounded-xl gap-1.5 text-xs font-semibold">
                <i class="fa-solid fa-pen-to-square text-xs"></i> Edit Formula
            </a>

            <a asp-page="/Production/Batches/Index" asp-route-recipeId="@Model.Recipe.Id" class="btn btn-sm btn-neutral rounded-xl gap-1.5 text-xs font-bold shadow-xs">
                <i class="fa-solid fa-layer-group text-xs"></i> Log Daily Output
            </a>
        </div>
    </div>

    <!-- Baseline Production Unit Banner -->
    <div class="card bg-base-200 border border-base-300 shadow-xs rounded-2xl">
        <div class="card-body p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div>
                    <div class="text-[10px] uppercase font-bold opacity-60">Baseline Production Unit</div>
                    <div class="font-black text-sm text-base-content">@Model.Costing.BaselineUnitName</div>
                    <div class="text-[11px] opacity-60 font-mono mt-0.5">
                        Expected yield: @Model.Costing.ExpectedYield.ToString("N0") @Model.Costing.OutputUnit per batch
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-4 text-xs font-mono">
                <div class="text-right">
                    <div class="text-[10px] uppercase font-bold opacity-60 font-sans">Total Batch Cost</div>
                    <div class="font-black text-lg text-base-content">₦@Model.Costing.TotalBatchCost.ToString("N2")</div>
                </div>
                <div class="divider divider-horizontal m-0"></div>
                <div class="text-right">
                    <div class="text-[10px] uppercase font-bold opacity-60 font-sans">Batch Revenue @@ Plan</div>
                    <div class="font-black text-lg text-primary">₦@((Model.Costing.SellingPrice * Model.Costing.ExpectedYield).ToString("N2"))</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Metrics Bar using daisyUI stats -->
    <div class="stats stats-vertical sm:stats-horizontal bg-base-100 border border-base-300 shadow-xs rounded-2xl w-full">
        <div class="stat p-5">
            <div class="stat-figure text-base-content text-2xl"><i class="fa-solid fa-wheat-awn"></i></div>
            <div class="stat-title text-[10px] uppercase font-bold opacity-60">Raw Ingredients</div>
            <div class="stat-value text-2xl font-black font-mono text-base-content">
                ₦@Model.Costing.IngredientsCostPerUnit.ToString("N2")
            </div>
            <div class="stat-desc opacity-70">@Model.Costing.Lines.Count components</div>
        </div>

        <div class="stat p-5">
            <div class="stat-figure text-base-content text-2xl"><i class="fa-solid fa-coins"></i></div>
            <div class="stat-title text-[10px] uppercase font-bold opacity-60">Total Unit Cost</div>
            <div class="stat-value text-2xl font-black font-mono text-base-content">
                ₦@Model.Costing.TotalUnitCost.ToString("N2")
            </div>
            <div class="stat-desc opacity-70">Materials + handling + overhead</div>
        </div>

        <div class="stat p-5">
            <div class="stat-figure text-primary text-2xl"><i class="fa-solid fa-tag"></i></div>
            <div class="stat-title text-[10px] uppercase font-bold opacity-60">Selling Price</div>
            <div class="stat-value text-2xl font-black font-mono text-primary">
                ₦@Model.Costing.SellingPrice.ToString("N2")
            </div>
            <div class="stat-desc opacity-70">Configured wholesale rate</div>
        </div>

        <div class="stat p-5">
            <div class="stat-figure @marginTextColor text-2xl"><i class="fa-solid fa-arrow-trend-up"></i></div>
            <div class="stat-title text-[10px] uppercase font-bold opacity-60">Profit Margin %</div>
            <div class="stat-value text-2xl font-black font-mono @marginTextColor">
                @Model.Costing.MarginPercentage%
            </div>
            <div class="stat-desc font-bold @marginTextColor font-mono">
                @(Model.Costing.MarginAmount >= 0 ? "+" : "")₦@Model.Costing.MarginAmount.ToString("N2") per @Model.Costing.SingularOutputUnit
            </div>
        </div>
    </div>

    @if (Model.Costing.HasNegativeMargin)
    {
        <div class="alert alert-error rounded-2xl shadow-xs text-xs">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>
                <div class="font-bold">This product is priced below production cost</div>
                <div>
                    Every @Model.Costing.OutputUnit loses ₦@Math.Abs(Model.Costing.MarginAmount).ToString("N2").
                    Raise the selling price or reduce the batch material cost.
                </div>
            </div>
            <a asp-page="/Production/Recipes/Edit" asp-route-id="@Model.Recipe.Id" class="btn btn-xs btn-neutral rounded-lg">Fix Formula</a>
        </div>
    }

    <!-- Ingredient Formulation Table -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
        <div class="card-body p-6 space-y-4">
            
            <div class="flex items-center justify-between border-b border-base-200 pb-3 flex-wrap gap-2">
                <div class="font-black text-sm text-base-content flex items-center gap-2">
                    <i class="fa-solid fa-flask text-primary"></i> Ingredient Formulation &amp; Cost Breakdown
                </div>
                <div class="flex items-center gap-2">
                    <span class="badge badge-neutral badge-xs font-mono font-bold">@Model.Costing.Lines.Count Raw Materials</span>
                    <span class="badge @marginBadgeClass badge-xs font-bold font-mono">@Model.Costing.MarginPercentage% Margin</span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="table table-sm w-full text-xs">
                    <thead>
                        <tr class="opacity-60 uppercase text-[10px] tracking-wider border-b border-base-200 bg-base-200/50">
                            <th class="py-3 pl-4 w-12">#</th>
                            <th>Ingredient Name</th>
                            <th class="text-right">Qty / Batch</th>
                            <th class="text-right">Live Unit Price</th>
                            <th class="text-right">Batch Line Cost</th>
                            <th class="text-right">Qty per @Model.Costing.SingularOutputUnit</th>
                            <th class="text-right pr-4">Cost per @Model.Costing.SingularOutputUnit</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-base-200">
                        @for (int i = 0; i < Model.Costing.Lines.Count; i++)
                        {
                            var line = Model.Costing.Lines[i];
                            <tr class="hover:bg-base-200/60 transition-colors">
                                <td class="opacity-50 py-3 pl-4 font-mono">@(i + 1)</td>
                                <td class="font-bold text-base-content py-3">
                                    @line.IngredientName
                                    <div class="text-[10px] font-sans opacity-50 font-normal">@line.ShareOfBatchPercent% of batch</div>
                                </td>
                                <td class="font-mono opacity-80 py-3 text-right">@line.QuantityPerBatch.ToString("N3") @line.Unit</td>
                                <td class="font-mono opacity-80 py-3 text-right">₦@line.UnitCost.ToString("N2") / @line.Unit</td>
                                <td class="font-mono py-3 text-right text-base-content">₦@line.BatchLineCost.ToString("N2")</td>
                                <td class="font-mono opacity-70 py-3 text-right">@line.QuantityPerUnit.ToString("N4") @line.Unit</td>
                                <td class="font-mono font-bold text-right py-3 pr-4 text-amber-700">
                                    ₦@line.UnitLineCost.ToString("N2")
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-base-200/60 font-mono text-xs border-t border-base-300">
                        <tr>
                            <td colspan="5" class="text-right py-2 opacity-70">
                                Total Batch Materials Cost:
                            </td>
                            <td colspan="2" class="text-right font-bold py-2 pr-4 text-base-content">
                                ₦@Model.Costing.TotalBatchCost.ToString("N2")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right py-2 opacity-70 text-[11px]">
                                &divide; @Model.Costing.ExpectedYield.ToString("N0") @Model.Costing.OutputUnit
                                &rarr; Materials per @Model.Costing.SingularOutputUnit:
                            </td>
                            <td colspan="2" class="text-right py-2 pr-4 text-base-content text-[11px]">
                                ₦@Model.Costing.IngredientsCostPerUnit.ToString("N2")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right py-2 opacity-70 text-[11px]">
                                Handling &amp; Label per @Model.Costing.SingularOutputUnit:
                            </td>
                            <td colspan="2" class="text-right py-2 pr-4 text-base-content text-[11px]">
                                ₦@Model.Costing.PackagingCost.ToString("N2")
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-right py-2 opacity-70 text-[11px]">
                                Labor, Oven Gas/Fuel &amp; Factory Overhead per @Model.Costing.SingularOutputUnit:
                            </td>
                            <td colspan="2" class="text-right py-2 pr-4 text-base-content text-[11px]">
                                ₦@Model.Costing.LaborAndOverheadPerUnit.ToString("N2")
                            </td>
                        </tr>
                        <tr class="font-bold text-sm bg-primary/10 border-t border-primary/20">
                            <td colspan="5" class="text-right py-3 text-primary font-black uppercase text-xs tracking-wider">
                                Total Base Cost Price per @Model.Costing.SingularOutputUnit:
                            </td>
                            <td colspan="2" class="text-right py-3 pr-4 text-primary font-black text-base">
                                ₦@Model.Costing.TotalUnitCost.ToString("N2")
                            </td>
                        </tr>
                        <tr class="font-bold text-sm @marginTextColor bg-base-200/40 border-t border-base-300">
                            <td colspan="5" class="text-right py-3 font-black uppercase text-xs tracking-wider">
                                Margin vs Selling Price of ₦@Model.Costing.SellingPrice.ToString("N2"):
                            </td>
                            <td colspan="2" class="text-right py-3 pr-4 font-black text-base">
                                @(Model.Costing.MarginAmount >= 0 ? "+" : "")₦@Model.Costing.MarginAmount.ToString("N2")
                                <span class="text-[10px]">(@Model.Costing.MarginPercentage%)</span>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </div>
    </div>

    <!-- Recent Production Runs for this Recipe -->
    @if (Model.RecentBatches.Any())
    {
        <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
            <div class="card-body p-6 space-y-4">
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <h2 class="font-bold text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-primary"></i> Recent Actual Yields
                    </h2>
                    <a asp-page="/Production/Batches/Index" class="text-[11px] opacity-70 hover:underline font-semibold">View all batches</a>
                </div>

                <div class="overflow-x-auto">
                    <table class="table table-sm w-full text-xs">
                        <thead>
                            <tr class="opacity-60 uppercase text-[10px] tracking-wider border-b border-base-200 bg-base-200/50">
                                <th class="py-2 pl-4">Batch #</th>
                                <th>Date</th>
                                <th class="text-right">Expected</th>
                                <th class="text-right">Actual</th>
                                <th class="text-right">Variance</th>
                                <th class="text-right pr-4">Unit Cost @@ Actual</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-base-200">
                            @foreach (var batch in Model.RecentBatches)
                            {
                                var unitCost = batch.ActualQuantity > 0
                                    ? batch.TotalBatchCost / batch.ActualQuantity + Model.Recipe.PackagingCost + Model.Recipe.LaborAndOverheadPerUnit
                                    : 0m;
                                <tr class="hover:bg-base-200/60 transition-colors">
                                    <td class="font-mono font-black text-primary py-2 pl-4">@batch.BatchNumber</td>
                                    <td class="py-2">@batch.ProductionDate.ToString("yyyy-MM-dd")</td>
                                    <td class="font-mono opacity-70 py-2 text-right">@batch.TargetQuantity</td>
                                    <td class="font-mono font-black text-base-content py-2 text-right">@batch.ActualQuantity</td>
                                    <td class="py-2 text-right">
                                        @if (batch.Variance > 0)
                                        {
                                            <span class="badge badge-success badge-xs font-bold">+@batch.Variance</span>
                                        }
                                        else if (batch.Variance < 0)
                                        {
                                            <span class="badge badge-error badge-xs font-bold">@batch.Variance</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-neutral badge-xs font-mono">0</span>
                                        }
                                    </td>
                                    <td class="font-mono font-bold text-amber-700 py-2 pr-4 text-right">
                                        @(unitCost > 0 ? "₦" + unitCost.ToString("N2") : "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
