@page "{id:int}"
@model Manufacture.Pages.UserManagement.EditModel
@{
    ViewData["Title"] = $"Edit User - {Model.UserInput.Name}";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/UserManagement/Index" class="hover:underline">User Management</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Edit User</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-user-pen text-primary"></i> Edit User: @Model.UserInput.Name
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Update account profile, assigned RBAC permissions, and 6-digit terminal PIN.
            </p>
        </div>
        <div>
            <a asp-page="/UserManagement/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-semibold">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Users
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        <input type="hidden" asp-for="UserInput.Id" />

        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
                <div class="card-body p-6 space-y-5">
                    
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-7 h-7 rounded-lg bg-primary text-primary-content flex items-center justify-center text-xs font-bold shadow-xs">
                                <i class="fa-solid fa-id-badge"></i>
                            </div>
                            <span>Account Profile & Security</span>
                        </div>
                        <span class="badge badge-neutral badge-xs font-bold uppercase tracking-wider">Role: @Model.UserInput.Role</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    User Full Name <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="UserInput.Name" class="input input-bordered input-sm w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-medium" required />
                        </div>

                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Email Address <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="email" asp-for="UserInput.Email" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    System Role & Permissions <span class="text-error">*</span>
                                </span>
                            </label>
                            <select asp-for="UserInput.Role" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-semibold focus:bg-base-100 focus:border-primary" required>
                                <option value="SuperAdmin">Super Admin</option>
                                <option value="ProductionManager">Production Manager</option>
                                <option value="StoreManager">Store Manager / Keeper</option>
                                <option value="SalesRep">Sales Rep (POS Register)</option>
                                <option value="Vendor">Vendor / Supermarket Client</option>
                                <option value="HrPayrollManager">HR & Payroll Manager</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    6-Digit Fast Login PIN <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" maxlength="6" pattern="\d{6}" asp-for="UserInput.PinCode" class="input input-bordered input-sm w-full font-mono text-center font-black bg-base-200 border-base-300 rounded-xl text-sm focus:bg-base-100 focus:border-primary tracking-widest text-primary" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Reset Password (Optional)</span>
                            </label>
                            <input type="password" asp-for="UserInput.Password" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="Leave blank to keep current" />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Phone Number</span>
                            </label>
                            <input type="tel" asp-for="UserInput.PhoneNumber" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="+234 80..." />
                        </div>

                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Assigned POS Terminal (For Sales Reps)</span>
                            </label>
                            <input type="text" asp-for="UserInput.PosTerminalId" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="e.g. POS-01" />
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Right Sticky Section (~30% width, 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <h2 class="font-black text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-primary"></i> Update Profile
                    </h2>
                    <span class="badge badge-success badge-xs font-bold">Active</span>
                </div>

                <p class="text-[11px] opacity-70 leading-relaxed">
                    Saving modifications will immediately take effect on the user's active session and POS terminal permissions.
                </p>

                <div class="space-y-2 pt-2 border-t border-base-200">
                    <button type="submit" class="btn btn-neutral w-full rounded-xl font-bold py-2.5 text-xs shadow-xs gap-2">
                        <i class="fa-solid fa-circle-check text-success text-xs"></i> Update User Profile
                    </button>

                    <a asp-page="/UserManagement/Index" class="btn btn-ghost w-full rounded-xl text-xs font-semibold">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>
