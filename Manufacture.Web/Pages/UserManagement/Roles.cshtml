@page
@model Manufacture.Pages.UserManagement.RolesModel
@{
    ViewData["Title"] = "Platform Access Roles";
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/UserManagement/Index" class="hover:underline">User Management</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Platform Roles</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-user-shield text-primary"></i> Platform Access Roles
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Roles define which module permissions a user can receive through the RBAC matrix. System roles are protected from deletion.
            </p>
        </div>
        <a asp-page="/UserManagement/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs font-semibold">Back to Users</a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success text-xs rounded-xl"><span>@success</span></div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-error text-xs rounded-xl"><span>@error</span></div>
    }

    <div class="card bg-base-100 border border-base-300 rounded-2xl p-5">
        <form method="post" asp-page-handler="Save" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
            <input type="hidden" asp-for="Input.Id" />
            <input type="hidden" asp-for="Input.IsSystemRole" />

            <div class="md:col-span-3 form-control">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Role Code / Name</span></label>
                <input asp-for="Input.Name" readonly="@Model.Input.IsSystemRole" class="input input-sm input-bordered font-mono text-xs @(Model.Input.IsSystemRole ? "opacity-70" : "")" required />
                @if (Model.Input.IsSystemRole)
                {
                    <span class="text-[10px] opacity-60 mt-1">System role codes cannot be changed.</span>
                }
            </div>
            <div class="md:col-span-3 form-control">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Display Name</span></label>
                <input asp-for="Input.DisplayName" class="input input-sm input-bordered text-xs" required />
            </div>
            <div class="md:col-span-4 form-control">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Description</span></label>
                <input asp-for="Input.Description" class="input input-sm input-bordered text-xs" />
            </div>
            <div class="md:col-span-2">
                <button type="submit" class="btn btn-sm btn-neutral w-full rounded-xl text-xs font-bold">
                    @(Model.Input.Id > 0 ? "Update Role" : "Create Role")
                </button>
            </div>
        </form>
    </div>

    <div class="card bg-base-100 border border-base-300 rounded-2xl overflow-hidden">
        <table class="table table-sm text-xs">
            <thead>
                <tr class="uppercase text-[10px] opacity-60">
                    <th>Role</th>
                    <th>Display Name</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td class="font-mono font-bold text-primary">@role.Name</td>
                        <td class="font-bold">@role.DisplayName</td>
                        <td class="opacity-70">@role.Description</td>
                        <td>
                            <span class="badge @(role.IsSystemRole ? "badge-neutral" : "badge-info") badge-xs font-bold">
                                @(role.IsSystemRole ? "System" : "Custom")
                            </span>
                        </td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a asp-page="/UserManagement/Roles" asp-route-editId="@role.Id" class="btn btn-xs btn-ghost rounded-lg">Edit</a>
                                @if (!role.IsSystemRole)
                                {
                                    <form method="post" asp-page-handler="Delete" class="inline">
                                        <input type="hidden" name="id" value="@role.Id" />
                                        <button type="submit" class="btn btn-xs btn-ghost text-error rounded-lg" onclick="return confirm('Delete this platform role? This cannot be undone.');">Delete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
