@page
@model Manufacture.Pages.UserManagement.PermissionsModel
@{
    ViewData["Title"] = "Role-Based Access Control (RBAC) Matrix";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/UserManagement/Index" class="hover:underline">User Management</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">RBAC Matrix</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-primary"></i> Role-Based Access Control (RBAC) Matrix
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Configure live Granular View, Edit, Issue, Print, and Delete privileges across all bakery roles.
            </p>
        </div>
        
        <!-- Header Actions -->
        <div class="flex items-center gap-2">
            @if (Model.IsEditMode)
            {
                <a asp-page="/UserManagement/Permissions" class="btn btn-sm btn-ghost rounded-xl text-xs gap-1">
                    <i class="fa-solid fa-xmark text-xs"></i> Cancel Editing
                </a>
            }
            else
            {
                <a asp-page="/UserManagement/Permissions" asp-route-edit="true" class="btn btn-sm btn-neutral rounded-xl font-bold text-xs gap-1.5 shadow-xs">
                    <i class="fa-solid fa-sliders text-xs"></i> Adjust Permissions
                </a>

                <button type="button" onclick="document.getElementById('resetModal').showModal()" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1 text-error hover:bg-error hover:text-white">
                    <i class="fa-solid fa-rotate-left text-xs"></i> Reset Defaults
                </button>
            }

            <a asp-page="/UserManagement/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl gap-1 text-xs font-semibold">
                <i class="fa-solid fa-arrow-left text-xs"></i> User Directory
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success shadow-xs rounded-2xl text-xs py-3">
            <i class="fa-solid fa-circle-check text-base"></i>
            <span>@successMessage</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-error shadow-xs rounded-2xl text-xs py-3">
            <i class="fa-solid fa-circle-exclamation text-base"></i>
            <span>@errorMessage</span>
        </div>
    }

    <!-- Active RBAC Live Enforcement Banner -->
    <div class="alert alert-info shadow-xs rounded-2xl text-xs py-3.5 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-circle-check text-base text-info-content"></i>
            <div>
                <span class="font-bold">Live Application Access Engine Active:</span>
                <span class="opacity-80 ml-1">Permissions configured in this matrix directly determine sidebar navigation, module visibility, and action buttons for each active user role in real time.</span>
            </div>
        </div>
        @if (Model.IsEditMode)
        {
            <span class="badge badge-warning badge-sm font-bold uppercase tracking-wider shrink-0">Edit Mode Active</span>
        }
    </div>

    <!-- RBAC Matrix Form & Table -->
    <form method="post" asp-page-handler="Save">
        <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
            <div class="card-body p-6 space-y-4">
                
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <div class="font-black text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-table text-primary"></i> Module Privilege Matrix
                    </div>
                    <div class="text-right">
                        <span class="text-xs opacity-60">@Model.Matrix.Rows.Count Functional Modules &bull; @Model.Matrix.Roles.Count Roles</span>
                        @if (Model.Matrix.LastUpdatedAt.HasValue)
                        {
                            <div class="text-[10px] opacity-50 mt-0.5">
                                Last updated @Model.Matrix.LastUpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                by @Model.Matrix.LastUpdatedBy
                            </div>
                        }
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="table table-sm w-full text-xs">
                        <thead>
                            <tr class="opacity-60 uppercase text-[10px] tracking-wider border-b border-base-200 bg-base-200/50">
                                <th class="py-3 pl-4 w-72">Module / Feature Area</th>
                                @foreach (var role in Model.Matrix.Roles)
                                {
                                    <th class="text-center">@role.DisplayName</th>
                                }
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-base-200">
                            @{
                                var cellIndex = 0;
                            }
                            @foreach (var row in Model.Matrix.Rows)
                            {
                                <tr class="hover:bg-base-200/60 transition-colors">
                                    <td class="font-bold py-3 pl-4">
                                        <div class="text-base-content font-bold">@row.Module.ModuleName</div>
                                        <span class="text-[10px] opacity-60 font-normal leading-tight">@row.Module.Description</span>
                                        <div class="text-[9px] font-mono opacity-40 mt-0.5">@row.Module.ModuleKey</div>
                                    </td>

                                    @foreach (var cell in row.Cells)
                                    {
                                        var index = cellIndex++;
                                        <td class="text-center">
                                            <input type="hidden" name="Input.Cells[@index].ModuleId" value="@cell.ModuleId" />
                                            <input type="hidden" name="Input.Cells[@index].RoleId" value="@cell.RoleId" />

                                            @if (Model.IsEditMode && !cell.IsLocked)
                                            {
                                                <select name="Input.Cells[@index].PermissionLevelId" class="select select-bordered select-xs w-full max-w-[130px] font-medium bg-base-200 border-base-300 rounded-lg text-xs focus:bg-base-100 focus:border-primary">
                                                    @foreach (var level in Model.Matrix.PermissionLevels)
                                                    {
                                                        @if (level.Id == cell.PermissionLevelId)
                                                        {
                                                            <option value="@level.Id" selected>@level.Name</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@level.Id">@level.Name</option>
                                                        }
                                                    }
                                                </select>
                                            }
                                            else
                                            {
                                                <input type="hidden" name="Input.Cells[@index].PermissionLevelId" value="@cell.PermissionLevelId" />
                                                @RenderBadge(cell.PermissionLevelName, cell.IsLocked)
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.IsEditMode)
                {
                    <div class="pt-4 border-t border-base-200 flex items-center justify-between gap-4">
                        <div class="text-xs opacity-70">
                            Select the desired permission level for each role and click <strong>Save Changes</strong> to apply immediately.
                        </div>
                        <div class="flex items-center gap-3">
                            <a asp-page="/UserManagement/Permissions" class="btn btn-sm btn-ghost rounded-xl text-xs">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-sm btn-neutral rounded-xl font-bold text-xs gap-1.5 shadow-xs px-5">
                                <i class="fa-solid fa-check text-success text-xs"></i> Save Changes Live
                            </button>
                        </div>
                    </div>
                }

            </div>
        </div>
    </form>
</div>

<!-- Reset Confirmation Modal -->
<dialog id="resetModal" class="modal">
    <div class="modal-box rounded-2xl border border-base-300 p-6 space-y-4 max-w-sm">
        <h3 class="font-black text-base text-base-content flex items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-warning"></i> Reset RBAC Matrix?
        </h3>
        <p class="text-xs opacity-70 leading-relaxed">
            This will restore all module access permissions for all user roles back to standard factory defaults.
        </p>
        <form method="post" asp-page-handler="Reset" class="flex justify-end gap-2 pt-2">
            <button type="button" onclick="document.getElementById('resetModal').close()" class="btn btn-sm btn-ghost rounded-xl text-xs font-semibold">
                Cancel
            </button>
            <button type="submit" class="btn btn-sm btn-error rounded-xl text-xs font-bold gap-1 shadow-xs">
                <i class="fa-solid fa-rotate-left text-xs"></i> Yes, Reset
            </button>
        </form>
    </div>
</dialog>

@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent RenderBadge(string level, bool locked)
    {
        if (string.IsNullOrWhiteSpace(level) || level == "None" || level == "—")
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<span class=\"opacity-30 font-mono\">—</span>");
        }

        var safeLevel = System.Net.WebUtility.HtmlEncode(level);
        var css = "badge-soft";
        if (level == "Full Access")
        {
            css = "badge-neutral";
        }
        else if (level.Contains("Edit") || level.Contains("Manage") || level.Contains("Issue"))
        {
            css = "badge-success";
        }
        else if (level.Contains("Request") || level.Contains("Book"))
        {
            css = "badge-primary";
        }
        else if (level.Contains("Create") || level.Contains("Print"))
        {
            css = "badge-warning";
        }

        var lockIcon = locked ? "<i class=\"fa-solid fa-lock text-[8px] mr-1\"></i>" : "";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class=\"badge {css} badge-xs font-bold font-mono\">{lockIcon}{safeLevel}</span>");
    }
}
