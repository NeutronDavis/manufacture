@page
@model Manufacture.Pages.Settings.SalesRulesModel
@{
    ViewData["Title"] = "Sales Bonus Rules";
}

<div class="space-y-6 w-full">
    <div>
        <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
            <a asp-page="/Settings/Index" class="hover:underline">Settings</a>
            <span>&gt;</span>
            <span class="text-primary font-bold">Sales Rules</span>
        </div>
        <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
            <i class="fa-solid fa-gift text-primary"></i> Sales Bonus Rules
        </h1>
        <p class="text-xs opacity-70 mt-0.5">Set buy-quantity thresholds that automatically add free bonus units to customer orders.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-xs rounded-xl"><span>@TempData["SuccessMessage"]</span></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error text-xs rounded-xl"><span>@TempData["ErrorMessage"]</span></div>
    }

    <div class="card bg-base-100 border border-base-300 rounded-2xl p-5">
        <form method="post" asp-page-handler="Save" class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
            <input type="hidden" asp-for="Input.Id" />
            <div class="md:col-span-4 form-control">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Product</span></label>
                <select asp-for="Input.RecipeId" class="select select-sm select-bordered text-xs" required>
                    <option value="">-- Select Product --</option>
                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Id">@product.Name (@product.Code)</option>
                    }
                </select>
            </div>
            <div class="md:col-span-2 form-control">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Buy Quantity</span></label>
                <input asp-for="Input.ThresholdQuantity" type="number" min="1" class="input input-sm input-bordered font-mono text-xs" required />
            </div>
            <div class="md:col-span-2 form-control">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Bonus Quantity</span></label>
                <input asp-for="Input.BonusQuantity" type="number" min="1" class="input input-sm input-bordered font-mono text-xs" required />
            </div>
            <div class="md:col-span-2 form-control">
                <label class="label cursor-pointer gap-2">
                    <span class="label-text text-xs font-bold">Active</span>
                    <input asp-for="Input.IsActive" type="checkbox" class="checkbox checkbox-sm checkbox-success" />
                </label>
            </div>
            <div class="md:col-span-2">
                <button type="submit" class="btn btn-sm btn-neutral w-full rounded-xl text-xs font-bold">@(Model.Input.Id > 0 ? "Update Rule" : "Save Rule")</button>
            </div>
        </form>
    </div>

    <div class="card bg-base-100 border border-base-300 rounded-2xl overflow-hidden">
        <table class="table table-sm text-xs">
            <thead>
                <tr class="uppercase text-[10px] opacity-60">
                    <th>Product</th>
                    <th>Buy Quantity</th>
                    <th>Bonus Quantity</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rule in Model.Rules)
                {
                    <tr>
                        <td>
                            <div class="font-bold">@rule.RecipeName</div>
                            <div class="font-mono text-[10px] text-primary">@rule.RecipeCode</div>
                        </td>
                        <td class="font-mono">@rule.ThresholdQuantity</td>
                        <td class="font-mono text-success font-bold">+@rule.BonusQuantity</td>
                        <td><span class="badge @(rule.IsActive ? "badge-success" : "badge-ghost") badge-sm">@(rule.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-right">
                            <div class="flex items-center justify-end gap-1">
                                <a asp-page="/Settings/SalesRules" asp-route-editId="@rule.Id" class="btn btn-xs btn-ghost rounded-lg">Edit</a>
                                <form method="post" asp-page-handler="Toggle" class="inline">
                                    <input type="hidden" name="id" value="@rule.Id" />
                                    <button class="btn btn-xs btn-outline rounded-lg">@(rule.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
