@page
@model Manufacture.Pages.Inventory.Suppliers.CreateModel
@{
    ViewData["Title"] = "Register Supplier";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Inventory/Suppliers/Index" class="hover:underline">Approved Suppliers</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Add Supplier</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-handshake text-primary"></i> Register Supplier / Vendor
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Register raw material mills, packaging printers, and baking equipment vendors into approved directories.
            </p>
        </div>
        <div>
            <a asp-page="/Inventory/Suppliers/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-semibold">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Suppliers
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        
        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
                <div class="card-body p-6 space-y-5">
                    
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-7 h-7 rounded-lg bg-primary text-primary-content flex items-center justify-center text-xs font-bold shadow-xs">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <span>Supplier Company & Representative Details</span>
                        </div>
                        <span class="badge badge-neutral badge-xs font-bold uppercase tracking-wider">Vendor Directory</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Supplier / Company Name <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="SupplierInput.Name" class="input input-bordered input-sm w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-medium" placeholder="e.g. Flour Mills of Nigeria PLC" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Contact Person <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="SupplierInput.ContactPerson" class="input input-bordered input-sm w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-medium" placeholder="e.g. Alhaji Shehu Garba" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Supply Category</span>
                            </label>
                            <select asp-for="SupplierInput.SupplyCategory" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-semibold focus:bg-base-100 focus:border-primary">
                                <option value="Flour & Grains">Flour & Grains (Wheat Flour, Semolina)</option>
                                <option value="Packaging (Nylon & Tags)">Packaging (Nylon Bags, Clip Tags)</option>
                                <option value="Sweeteners & Yeast">Sweeteners & Yeast (Sugar, Active Dry Yeast)</option>
                                <option value="Fats & Oils">Fats & Oils (Vegetable Margarine, Butter)</option>
                                <option value="Equipment & Maintenance">Equipment & Maintenance</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Phone Number <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="tel" asp-for="SupplierInput.PhoneNumber" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="+234 80..." required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Email Address</span>
                            </label>
                            <input type="email" asp-for="SupplierInput.Email" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="sales@supplier.com" />
                        </div>

                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Office / Warehouse Delivery Address</span>
                            </label>
                            <textarea asp-for="SupplierInput.Address" class="textarea textarea-bordered w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary leading-relaxed" rows="3" placeholder="Warehouse address, port or depot"></textarea>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Right Sticky Section (~30% width, 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <h2 class="font-black text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-handshake text-primary"></i> Vendor Registry
                    </h2>
                    <span class="badge badge-success badge-xs font-bold">Approved</span>
                </div>

                <p class="text-[11px] opacity-70 leading-relaxed">
                    Supplier will be listed in preferred vendor directories and linked to material stock items and purchase orders.
                </p>

                <div class="space-y-2 pt-2 border-t border-base-200">
                    <button type="submit" class="btn btn-neutral w-full rounded-xl font-bold py-2.5 text-xs shadow-xs gap-2">
                        <i class="fa-solid fa-circle-check text-success text-xs"></i> Save Supplier Profile
                    </button>

                    <a asp-page="/Inventory/Suppliers/Index" class="btn btn-ghost w-full rounded-xl text-xs font-semibold">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>
