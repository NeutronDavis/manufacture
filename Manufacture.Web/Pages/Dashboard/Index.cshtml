@* The executive overview partial's script lives here: Razor Pages renders
   @section only from the page itself, never from a partial, so leaving it
   in _ExecutiveOverview.cshtml silently dropped the whole drill-down. *@
@if (Model.ActiveRole == "SuperAdmin")
{
@section Scripts {
    <script>
        (function () {
            // Product SKU rows pre-computed for every scope & period.
            const productData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                overview.ProductDrillDownScopes.ToDictionary(
                    s => s.ScopeKey,
                    s => s.Periods.ToDictionary(p => p.Key, p => p.Value)),
                json));

            // Rep rows pre-computed for every scope & period.
            const repData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                overview.DrillDownScopes.ToDictionary(
                    s => s.ScopeKey,
                    s => s.Periods.ToDictionary(p => p.Key, p => p.Value)),
                json));

            // Stage-specific grouped breakdowns (the eight lifecycle KPI cards).
            // Shape: stageData[scope][metric][period] -> { rows, total, ... }
            const stageData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                overview.StageDrillDownScopes.ToDictionary(
                    s => s.ScopeKey,
                    s => s.Metrics),
                json));

            // Period metadata drives captions and deep links.
            const anchorDate = '@overview.AnchorDate.ToString("yyyy-MM-dd")';

            const periods = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                overview.Periods.Select(p => new
                {
                    key = p.Key,
                    label = p.Label,
                    dateLabel = p.DateLabel,
                    timeframe = p.ReportsTimeframe
                }),
                json));

            const scopeLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                overview.DrillDownScopes.ToDictionary(s => s.ScopeKey, s => s.ScopeLabel),
                json));

            const metricLabels = {
                'OrdersPlaced': 'Orders Placed',
                'Produced': 'Produced',
                'Loaded': 'Loaded',
                'FactoryDefects': 'Factory Defects',
                'Sold': 'Sold',
                'Returned': 'Closing Stock',
                'Damaged': 'Damaged',
                'CustomerReturns': 'Returns'
            };

            // What each KPI groups by, matching the server-side stage drill-down.
            const metricGrouping = {
                'OrdersPlaced': 'By Sales Rep & Product Category',
                'Produced': 'By Product Category',
                'Loaded': 'By Sales Rep, Vehicle & Product Category',
                'FactoryDefects': 'By Product Category',
                'Sold': 'By Sales Rep & Product Category',
                'Returned': 'By Sales Rep & Product Category',
                'Damaged': 'By Sales Rep & Product Category',
                'CustomerReturns': 'By Sales Rep & Product Category'
            };

            // Column recipes for the stage table. `key` is a property on the
            // StageDrillDownRowDto payload emitted by the analytics engine.
            const stageColumns = {
                'OrdersPlaced': [
                    { key: 'groupLabel', label: 'Sales Rep', type: 'text' },
                    { key: 'groupSubLabel', label: 'Route / Vehicle', type: 'subtext' },
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Orders Placed', type: 'qty', highlight: true },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ],
                'Produced': [
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Produced', type: 'qty', highlight: true },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ],
                'Loaded': [
                    { key: 'groupLabel', label: 'Sales Rep', type: 'text' },
                    { key: 'groupSubLabel', label: 'Route / Vehicle', type: 'subtext' },
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Loaded', type: 'qty', highlight: true },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ],
                'FactoryDefects': [
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Factory Defects', type: 'qty', highlight: true },
                    { key: 'produced', label: 'Produced', type: 'qty' },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ],
                'Sold': [
                    { key: 'groupLabel', label: 'Sales Rep', type: 'text' },
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Sold', type: 'qty', highlight: true },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ],
                'Returned': [
                    { key: 'groupLabel', label: 'Sales Rep', type: 'text' },
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Closing Stock', type: 'qty', highlight: true },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ],
                'Damaged': [
                    { key: 'groupLabel', label: 'Sales Rep', type: 'text' },
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Damaged', type: 'qty', highlight: true },
                    { key: 'loaded', label: 'Loaded', type: 'qty' },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ],
                'CustomerReturns': [
                    { key: 'groupLabel', label: 'Sales Rep', type: 'text' },
                    { key: 'categoryLabel', label: 'Product Category', type: 'badge' },
                    { key: 'metricValue', label: 'Returns', type: 'qty', highlight: true },
                    { key: 'sharePercent', label: 'Share', type: 'share' }
                ]
            };

            const money = (v) => '₦' + Number(v || 0).toLocaleString('en-NG', { maximumFractionDigits: 0 });
            const num = (v) => Number(v || 0).toLocaleString('en-NG');

            // Escape every database-sourced label before it reaches innerHTML.
            const esc = (v) => String(v === null || v === undefined ? '' : v).replace(/[&<>"']/g, ch => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[ch]));

            // Columns for the source-record table. `key` is a property on
            // KpiDetailRowDto; a null quantity deliberately renders blank.
            const recordColumns = {
                'OrdersPlaced': [
                    { key: 'reference', label: 'Order #', type: 'ref' },
                    { key: 'product', label: 'Items Ordered', type: 'product' },
                    { key: 'quantity', label: 'Units', type: 'qty', highlight: true },
                    { key: 'secondaryQuantity', label: 'Bonus', type: 'qty' },
                    { key: 'amount', label: 'Order Value', type: 'money' },
                    { key: 'status', label: 'Status', type: 'status' },
                    { key: 'dateLabel', label: 'Booked', type: 'subtext' }
                ],
                'Produced': [
                    { key: 'reference', label: 'Batch #', type: 'ref' },
                    { key: 'product', label: 'Product', type: 'product' },
                    { key: 'category', label: 'Category', type: 'badge' },
                    { key: 'secondaryQuantity', label: 'Target', type: 'qty' },
                    { key: 'quantity', label: 'Actual Produced', type: 'qty', highlight: true },
                    { key: 'unitLabel', label: 'Unit', type: 'subtext' },
                    { key: 'status', label: 'Status', type: 'status' }
                ],
                'Loaded': [
                    { key: 'reference', label: 'Route Sheet', type: 'ref' },
                    { key: 'product', label: 'Product', type: 'product' },
                    { key: 'category', label: 'Category', type: 'badge' },
                    { key: 'quantity', label: 'Loaded', type: 'qty', highlight: true },
                    { key: 'secondaryQuantity', label: 'Requested', type: 'qty' },
                    { key: 'amount', label: 'Stock Value', type: 'money' },
                    { key: 'status', label: 'Dispatch', type: 'status' }
                ],
                'FactoryDefects': [
                    { key: 'reference', label: 'Batch #', type: 'ref' },
                    { key: 'product', label: 'Product', type: 'product' },
                    { key: 'category', label: 'Category', type: 'badge' },
                    { key: 'quantity', label: 'Defects', type: 'qty', highlight: true },
                    { key: 'dateLabel', label: 'Recorded', type: 'subtext' }
                ],
                'Sold': [
                    { key: 'reference', label: 'Route Sheet', type: 'ref' },
                    { key: 'product', label: 'Product', type: 'product' },
                    { key: 'category', label: 'Category', type: 'badge' },
                    { key: 'quantity', label: 'Sold', type: 'qty', highlight: true },
                    { key: 'unitPrice', label: 'Unit Price', type: 'money' },
                    { key: 'amount', label: 'Value', type: 'money' },
                    { key: 'status', label: 'Dispatch', type: 'status' }
                ],
                'Returned': [
                    { key: 'reference', label: 'Route Sheet', type: 'ref' },
                    { key: 'product', label: 'Product', type: 'product' },
                    { key: 'category', label: 'Category', type: 'badge' },
                    { key: 'quantity', label: 'Closing Stock', type: 'qty', highlight: true },
                    { key: 'secondaryQuantity', label: 'Loaded', type: 'qty' },
                    { key: 'status', label: 'Dispatch', type: 'status' }
                ],
                'Damaged': [
                    { key: 'reference', label: 'Route Sheet', type: 'ref' },
                    { key: 'product', label: 'Product', type: 'product' },
                    { key: 'category', label: 'Category', type: 'badge' },
                    { key: 'quantity', label: 'Damaged', type: 'qty', highlight: true },
                    { key: 'secondaryQuantity', label: 'Loaded', type: 'qty' },
                    { key: 'amount', label: 'Write-off Value', type: 'money' },
                    { key: 'status', label: 'Dispatch', type: 'status' }
                ],
                'CustomerReturns': [
                    { key: 'reference', label: 'Return #', type: 'ref' },
                    { key: 'product', label: 'Product', type: 'product' },
                    { key: 'quantity', label: 'Qty', type: 'qty', highlight: true },
                    { key: 'secondaryQuantity', label: 'Replaced', type: 'qty' },
                    { key: 'unitPrice', label: 'Unit Price', type: 'money' },
                    { key: 'amount', label: 'Refund', type: 'money' },
                    { key: 'status', label: 'Status', type: 'status' },
                    { key: 'dateLabel', label: 'Returned', type: 'subtext' }
                ]
            };

            let scope = 'all';
            let period = periods[0].key; // Initially "Today"
            let metric = 'OrdersPlaced';
            let viewMode = 'stage'; // The drawer opens on Records; initial page load stays aggregate.

            // Source-record cache: one metric/window/scope at a time.
            let detail = null;
            let detailKeyValue = '';
            let pendingDetailKey = '';
            let recordRequestId = 0;

            function currentDetailKey() {
                return [metric, period, scope].join('|');
            }

            function drillDrawerIsOpen() {
                const drawer = document.getElementById('drill-drawer');
                return !!drawer && drawer.classList.contains('translate-x-0');
            }

            const periodOf = (key) => periods.find(p => p.key === key) || periods[0];

            function productRows() {
                const byPeriod = (productData[scope] || {})[period] || [];
                let list = byPeriod.slice();
                const searchEl = document.getElementById('drill-search-input');
                const term = searchEl ? searchEl.value.trim().toLowerCase() : '';
                if (term) {
                    list = list.filter(p =>
                        (p.productName && p.productName.toLowerCase().indexOf(term) !== -1) ||
                        (p.productCode && p.productCode.toLowerCase().indexOf(term) !== -1) ||
                        (p.productionCategoryName && p.productionCategoryName.toLowerCase().indexOf(term) !== -1)
                    );
                }
                const sortKey = metric ? metric.charAt(0).toLowerCase() + metric.slice(1) : 'ordersPlaced';
                return list.sort((a, b) => (b[sortKey] ?? 0) - (a[sortKey] ?? 0));
            }

            function repRows() {
                const byPeriod = (repData[scope] || {})[period] || [];
                let list = byPeriod.slice();
                const searchEl = document.getElementById('drill-search-input');
                const term = searchEl ? searchEl.value.trim().toLowerCase() : '';
                if (term) {
                    list = list.filter(r =>
                        (r.repName && r.repName.toLowerCase().indexOf(term) !== -1) ||
                        (r.route && r.route.toLowerCase().indexOf(term) !== -1) ||
                        (r.vehicleRegistration && r.vehicleRegistration.toLowerCase().indexOf(term) !== -1)
                    );
                }
                return list.sort((a, b) => b.sold - a.sold);
            }

            function stageRows() {
                const stage = ((stageData[scope] || {})[metric] || {})[period];
                let list = stage && stage.rows ? stage.rows.slice() : [];
                const searchEl = document.getElementById('drill-search-input');
                const term = searchEl ? searchEl.value.trim().toLowerCase() : '';
                if (term) {
                    list = list.filter(r =>
                        (r.groupLabel && r.groupLabel.toLowerCase().indexOf(term) !== -1) ||
                        (r.groupSubLabel && r.groupSubLabel.toLowerCase().indexOf(term) !== -1) ||
                        (r.categoryLabel && r.categoryLabel.toLowerCase().indexOf(term) !== -1) ||
                        (r.repName && r.repName.toLowerCase().indexOf(term) !== -1) ||
                        (r.vehicleRegistration && r.vehicleRegistration.toLowerCase().indexOf(term) !== -1)
                    );
                }
                return list.sort((a, b) => (b.metricValue || 0) - (a.metricValue || 0));
            }

            // ---------------- Source-record drawer (Records tab) ----------------

            function setRecordsState(state, message) {
                const loading = document.getElementById('drill-records-loading');
                const error = document.getElementById('drill-records-error');
                const empty = document.getElementById('drill-records-empty');
                const groups = document.getElementById('drill-records-groups');
                if (!loading || !error || !empty || !groups) return;

                loading.classList.toggle('hidden', state !== 'loading');
                loading.classList.toggle('flex', state === 'loading');
                error.classList.toggle('hidden', state !== 'error');
                empty.classList.toggle('hidden', state !== 'empty');
                groups.classList.toggle('hidden', state !== 'ready');

                if (state === 'error' && message) {
                    const text = document.getElementById('drill-records-error-text');
                    if (text) text.textContent = message;
                }
            }

            function loadDetail(force) {
                const key = currentDetailKey();
                if (!force && detail && detailKeyValue === key) {
                    renderRecordsView();
                    return;
                }

                // A request for this exact key is already in flight.
                if (!force && pendingDetailKey === key) return;

                const requestId = ++recordRequestId;
                pendingDetailKey = key;
                setRecordsState('loading');

                const params = new URLSearchParams({
                    handler: 'Drill',
                    metric: metric,
                    timeframe: periodOf(period).timeframe,
                    scope: scope,
                    date: anchorDate
                });

                fetch('/Dashboard?' + params.toString(), {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(response.status === 403
                                ? 'You do not have access to these records.'
                                : 'HTTP ' + response.status);
                        }
                        return response.json();
                    })
                    .then(payload => {
                        if (requestId !== recordRequestId) return; // superseded
                        pendingDetailKey = '';
                        detail = payload;
                        detailKeyValue = key;
                        render();
                    })
                    .catch(err => {
                        if (requestId !== recordRequestId) return;
                        pendingDetailKey = '';
                        detail = null;
                        detailKeyValue = '';
                        setRecordsState('error', 'Could not load records (' + (err && err.message ? err.message : 'network error') + ').');
                    });
            }

            window.reloadDrillRecords = function () {
                loadDetail(true);
            };

            function recordValueIsBlank(value) {
                return value === null || value === undefined || value === '';
            }

            function recordCell(row, column) {
                const value = row[column.key];

                if (column.type === 'ref') {
                    const label = recordValueIsBlank(value) ? '—' : esc(value);
                    const href = row.referenceUrl && row.referenceUrl.charAt(0) === '/'
                        ? row.referenceUrl
                        : '';
                    const body = href
                        ? '<a href="' + esc(href) + '" class="text-primary hover:underline">' + label + '</a>'
                        : label;
                    return '<td class="py-2.5 font-mono font-bold text-xs text-base-content">' + body + '</td>';
                }

                if (column.type === 'product') {
                    return '<td class="py-2.5">'
                        + '<div class="font-bold text-base-content text-xs">' + (recordValueIsBlank(value) ? '—' : esc(value)) + '</div>'
                        + (row.meta ? '<div class="text-[10px] opacity-60">' + esc(row.meta) + '</div>' : '')
                        + '</td>';
                }

                if (column.type === 'badge') {
                    return '<td><span class="badge badge-sm badge-ghost border border-base-300 font-bold text-[10px]">'
                        + (recordValueIsBlank(value) ? '—' : esc(value)) + '</span></td>';
                }

                if (column.type === 'qty') {
                    return '<td class="text-right font-mono '
                        + (column.highlight ? 'font-black text-primary text-sm' : 'font-bold') + '">'
                        + (recordValueIsBlank(value) ? '' : num(value)) + '</td>';
                }

                if (column.type === 'money') {
                    return '<td class="text-right font-mono font-bold">'
                        + (recordValueIsBlank(value) ? '' : money(value)) + '</td>';
                }

                if (column.type === 'status') {
                    const tone = row.statusTone || 'ghost';
                    return '<td><span class="badge badge-' + esc(tone) + ' badge-xs font-bold">'
                        + (recordValueIsBlank(value) ? '—' : esc(value)) + '</span></td>';
                }

                if (column.type === 'subtext') {
                    return '<td class="text-[10px] opacity-60 font-mono">'
                        + (recordValueIsBlank(value) ? '—' : esc(value)) + '</td>';
                }

                return '<td class="text-xs font-medium">' + (recordValueIsBlank(value) ? '—' : esc(value)) + '</td>';
            }

            function recordRowMatches(row, term) {
                return ['reference', 'product', 'category', 'meta', 'status', 'dateLabel']
                    .some(key => String(row[key] || '').toLowerCase().indexOf(term) !== -1);
            }

            function renderRecordsView() {
                if (!detail || detailKeyValue !== currentDetailKey()) {
                    // Only fetch when the drawer is actually on screen; a period
                    // switch behind a closed drawer must not hit the database.
                    if (drillDrawerIsOpen()) loadDetail();
                    return;
                }

                const columns = recordColumns[detail.metric] || recordColumns['OrdersPlaced'];
                const unit = detail.unit || 'units';
                const term = (document.getElementById('drill-search-input')?.value || '').trim().toLowerCase();

                if (viewMode === 'records') {
                    const titleEl = document.getElementById('drill-header-title');
                    if (titleEl) {
                        const viewPeriod = periodOf(period);
                        titleEl.textContent = (period === 'Today' ? "Today's " : viewPeriod.label + " ")
                            + (detail.metricLabel || metric) + ' — ' + (detail.groupingLabel || 'Records');
                    }

                    const captionEl = document.getElementById('drill-caption');
                    if (captionEl) {
                        const viewPeriod = periodOf(period);
                        captionEl.textContent = (detail.scopeLabel || scopeLabels[scope] || 'All Product Lines')
                            + ' · ' + (detail.periodLabel || viewPeriod.label)
                            + ' (' + (detail.dateLabel || viewPeriod.dateLabel) + ')'
                            + ' · ' + num(detail.recordCount) + ' source records';
                    }
                }

                const groupingBadge = document.getElementById('drill-records-grouping-badge');
                if (groupingBadge) groupingBadge.textContent = detail.groupingLabel || 'Grouped records';

                const totalBadge = document.getElementById('drill-records-total-badge');
                if (totalBadge) totalBadge.textContent = num(detail.total) + ' ' + unit;

                const countBadge = document.getElementById('drill-records-count-badge');
                if (countBadge) countBadge.textContent = num(detail.recordCount) + ' records';

                const valueBadge = document.getElementById('drill-records-value-badge');
                if (valueBadge) {
                    const hasValue = Number(detail.totalValue || 0) > 0;
                    valueBadge.classList.toggle('hidden', !hasValue);
                    valueBadge.textContent = hasValue ? money(detail.totalValue) : '';
                }

                const noteEl = document.getElementById('drill-records-note');
                if (noteEl) noteEl.textContent = detail.note || 'Source records for the selected stage.';

                const groupIcon = String(detail.groupingLabel || '').toLowerCase().indexOf('category') !== -1
                    ? 'fa-solid fa-boxes-stacked'
                    : 'fa-solid fa-user-tie';

                let visibleRows = 0;
                let visibleGroups = 0;

                const groupsHtml = (detail.groups || []).map(group => {
                    const labelMatch = !term
                        || String(group.label || '').toLowerCase().indexOf(term) !== -1
                        || String(group.subLabel || '').toLowerCase().indexOf(term) !== -1;
                    const rows = labelMatch ? group.rows : group.rows.filter(row => recordRowMatches(row, term));

                    if (!rows.length) return '';
                    visibleRows += rows.length;
                    visibleGroups += 1;

                    const groupValue = Number(group.totalValue || 0) > 0
                        ? '<span class="badge badge-success badge-soft badge-sm font-mono font-bold text-[10px]">'
                            + money(group.totalValue) + '</span>'
                        : '';

                    return '<div class="rounded-xl border border-base-200 bg-base-100 shadow-xs overflow-hidden">'
                        + '<div class="flex flex-wrap items-center justify-between gap-2 bg-base-200/60 px-4 py-2.5 border-b border-base-200">'
                        +   '<div>'
                        +     '<div class="font-black text-xs text-base-content flex items-center gap-2">'
                        +       '<i class="' + groupIcon + ' text-primary text-[11px]"></i>' + esc(group.label) + '</div>'
                        +     (group.subLabel ? '<div class="text-[10px] opacity-60 font-mono">' + esc(group.subLabel) + '</div>' : '')
                        +   '</div>'
                        +   '<div class="flex items-center gap-1.5">'
                        +     '<span class="badge badge-ghost border border-base-300 badge-sm font-mono font-bold text-[10px]">'
                        +       num(group.recordCount) + ' records</span>'
                        +     '<span class="badge badge-primary badge-soft badge-sm font-mono font-black text-[10px]">'
                        +       num(group.total) + ' ' + esc(group.unit || unit) + '</span>'
                        +     groupValue
                        +   '</div>'
                        + '</div>'
                        + '<div class="overflow-x-auto"><table class="table table-sm w-full text-xs"><thead class="bg-base-100">'
                        + '<tr class="uppercase text-[10px] tracking-wider border-b border-base-200 opacity-60">'
                        + columns.map(column => {
                            const align = column.type === 'qty' || column.type === 'money' ? 'text-right' : 'text-left';
                            return '<th class="' + align + ' py-2">' + column.label + '</th>';
                        }).join('')
                        + '</tr></thead><tbody class="divide-y divide-base-200 font-medium">'
                        + rows.map(row => '<tr class="hover:bg-base-200/50 transition-colors">'
                            + columns.map(column => recordCell(row, column)).join('') + '</tr>').join('')
                        + '</tbody></table></div>'
                        + '</div>';
                }).join('');

                const container = document.getElementById('drill-records-groups');
                if (visibleRows === 0) {
                    const emptyText = document.getElementById('drill-records-empty-text');
                    if (emptyText) {
                        emptyText.textContent = term
                            ? 'No records match \u201c' + term + '\u201d.'
                            : 'No source records were found for this stage, scope and period.';
                    }
                    setRecordsState('empty');
                } else {
                    const truncation = detail.isTruncated
                        ? '<p class="text-[10px] opacity-60 flex items-center gap-1.5">'
                            + '<i class="fa-solid fa-circle-info"></i>'
                            + 'Some rows were hidden to keep the drawer light. Open Full Reports for the complete list.</p>'
                        : '';

                    const grandTotal = '<div class="rounded-xl border border-primary/30 bg-primary/5 px-4 py-3 flex flex-wrap items-center justify-between gap-2">'
                        + '<span class="text-xs font-black text-primary"><i class="fa-solid fa-sigma mr-1.5"></i>'
                        +   'Grand total · ' + num(detail.recordCount) + ' records</span>'
                        + '<span class="font-mono font-black text-sm text-primary">'
                        +   num(detail.total) + ' ' + esc(unit)
                        +   (Number(detail.totalValue || 0) > 0 ? ' · ' + money(detail.totalValue) : '')
                        + '</span></div>';

                    if (container) container.innerHTML = groupsHtml + grandTotal + truncation;
                    setRecordsState('ready');
                }

                const footerEl = document.getElementById('drill-footer-summary');
                if (footerEl) {
                    footerEl.textContent = 'Showing ' + visibleGroups + ' group' + (visibleGroups === 1 ? '' : 's')
                        + ' · ' + num(visibleRows) + ' row' + (visibleRows === 1 ? '' : 's')
                        + ' · ' + num(detail.total) + ' total ' + String(detail.metricLabel || '').toLowerCase();
                }

                const drillLink = document.getElementById('drill-reports-link');
                if (drillLink) drillLink.setAttribute('href', reportsUrl());
                const execLink = document.getElementById('exec-reports-link');
                if (execLink) execLink.setAttribute('href', reportsUrl());
            }

            function renderStageView() {
                const stage = ((stageData[scope] || {})[metric] || {})[period];
                const rows = stageRows();
                const total = rows.reduce((sum, r) => sum + (r.metricValue || 0), 0);
                const columns = stageColumns[metric] || stageColumns['OrdersPlaced'];
                const grouping = metricGrouping[metric] || (stage && stage.groupingLabel) || 'By Product Category';
                const unit = stage && stage.outputUnit ? stage.outputUnit : 'units';

                const groupingBadge = document.getElementById('drill-stage-grouping-badge');
                if (groupingBadge) groupingBadge.textContent = grouping;
                const totalBadge = document.getElementById('drill-stage-total-badge');
                if (totalBadge) totalBadge.textContent = num(total) + ' ' + unit;
                const noteEl = document.getElementById('drill-stage-note');
                if (noteEl) noteEl.textContent = (stage && stage.note) || 'Grouped operational detail for the selected stage.';

                const head = document.getElementById('drill-stage-head');
                if (head) {
                    head.innerHTML = columns.map(c => {
                        const align = c.type === 'qty' || c.type === 'share' ? 'text-right' : 'text-left';
                        const highlight = c.highlight ? ' bg-primary/10 text-primary font-black' : '';
                        return '<th class="' + align + ' py-2.5' + highlight + '">' + c.label + '</th>';
                    }).join('');
                }

                const body = document.getElementById('drill-stage-body');
                if (body) {
                    body.innerHTML = rows.length
                        ? rows.map(r => {
                            const cells = columns.map(c => {
                                const value = r[c.key];
                                if (c.type === 'badge') {
                                    return '<td class="text-left"><span class="badge badge-sm badge-ghost border border-base-300 font-bold text-[10px]">' + (value || '—') + '</span></td>';
                                }
                                if (c.type === 'qty') {
                                    return '<td class="text-right font-mono ' + (c.highlight ? 'font-black text-primary text-sm' : 'font-bold') + '">' + num(value) + '</td>';
                                }
                                if (c.type === 'share') {
                                    return '<td class="text-right"><div class="flex items-center gap-1.5 justify-end">'
                                        + '<progress class="progress progress-primary w-14 h-1.5" value="' + (value || 0) + '" max="100"></progress>'
                                        + '<span class="font-mono font-bold text-[10px] w-10">' + (value || 0) + '%</span>'
                                        + '</div></td>';
                                }
                                if (c.type === 'subtext') {
                                    return '<td class="text-left text-[10px] opacity-60 font-mono">' + (value || '—') + '</td>';
                                }
                                return '<td class="text-left font-bold text-base-content">' + (value || '—') + '</td>';
                            }).join('');
                            return '<tr class="hover:bg-base-200/50 transition-colors">' + cells + '</tr>';
                        }).join('')
                        : '<tr><td colspan="' + columns.length + '" class="text-center py-10 opacity-50 text-xs font-medium">No ' + (metricLabels[metric] || metric).toLowerCase() + ' activity recorded for this scope and period.</td></tr>';
                }

                const footerEl = document.getElementById('drill-footer-summary');
                if (footerEl) {
                    const groupName = grouping.toLowerCase().replace('by ', '');
                    footerEl.textContent = 'Showing ' + rows.length + ' ' + groupName + ' group' + (rows.length === 1 ? '' : 's')
                        + ' · ' + num(total) + ' total ' + (metricLabels[metric] || metric).toLowerCase();
                }

                const drillLink = document.getElementById('drill-reports-link');
                if (drillLink) drillLink.setAttribute('href', reportsUrl());
                const execLink = document.getElementById('exec-reports-link');
                if (execLink) execLink.setAttribute('href', reportsUrl());
            }

            function reportsUrl() {
                const params = new URLSearchParams({
                    view: 'table',
                    module: 'Operational',
                    timeframe: periodOf(period).timeframe
                });
                if (scope !== 'all') params.set('category', scope);
                return '/Reports?' + params.toString();
            }

            function paintStrip(selector, attribute, value) {
                document.querySelectorAll(selector).forEach(b => {
                    const on = b.dataset[attribute] === value;
                    b.classList.toggle('btn-neutral', on);
                    b.classList.toggle('btn-ghost', !on);
                    b.classList.toggle('bg-base-200', !on);
                });
            }

            function render() {
                const p = periodOf(period);
                const scopeLabelText = scopeLabels[scope] || 'All Product Lines';
                const currentMetric = metric || 'OrdersPlaced';
                const metricDisplay = metricLabels[currentMetric] || currentMetric;

                // Update Header Labels & Badges
                const stageBadge = document.getElementById('drill-stage-badge');
                if (stageBadge) stageBadge.textContent = 'Stage: ' + metricDisplay;
                const scopeBadge = document.getElementById('drill-scope-badge');
                if (scopeBadge) scopeBadge.textContent = scopeLabelText;
                const viewTitle = viewMode === 'records'
                    ? ((detail && detailKeyValue === currentDetailKey() && detail.groupingLabel) || 'Record List')
                    : viewMode === 'stage'
                        ? (metricGrouping[currentMetric] || 'Stage Breakdown')
                        : (viewMode === 'reps' ? 'Sales Rep Allocations' : 'Product Orders');
                const titleEl = document.getElementById('drill-header-title');
                if (titleEl) {
                    titleEl.textContent = (period === 'Today' ? "Today's " : p.label + " ") + metricDisplay + " — " + viewTitle;
                }
                const viewCaption = viewMode === 'records'
                    ? ((detail && detailKeyValue === currentDetailKey() && detail.note) || 'Source records behind this KPI')
                    : viewMode === 'stage'
                        ? (metricGrouping[currentMetric] || 'Grouped operational detail')
                        : (viewMode === 'reps' ? 'Rep-by-rep allocation and settlement' : 'Product SKU lifecycle breakdown');
                const captionEl = document.getElementById('drill-caption');
                if (captionEl) {
                    captionEl.textContent = scopeLabelText + ' · ' + p.label + ' (' + p.dateLabel + ') · ' + viewCaption;
                }

                // Every view owns its own table. Records are loaded on demand.
                if (viewMode === 'records') {
                    renderRecordsView();
                    return;
                }

                // The stage view has its own grouped table and summary.
                if (viewMode === 'stage') {
                    renderStageView();
                    return;
                }

                // Calculate Top Summary Metrics
                const pList = productRows();
                let totalMetricUnits = 0;
                let totalRevenue = 0;
                let totalProduced = 0;
                let totalLoaded = 0;
                let totalSold = 0;

                pList.forEach(item => {
                    const stageKey = currentMetric.charAt(0).toLowerCase() + currentMetric.slice(1);
                    totalMetricUnits += (item[stageKey] !== undefined ? item[stageKey] : item.ordersPlaced) || 0;
                    totalRevenue += item.expectedRevenue || 0;
                    totalProduced += item.produced || 0;
                    totalLoaded += item.loaded || 0;
                    totalSold += item.sold || 0;
                });

                const metricLabelEl = document.getElementById('drawer-kpi-metric-label');
                if (metricLabelEl) metricLabelEl.textContent = metricDisplay;
                const metricValueEl = document.getElementById('drawer-kpi-metric-value');
                if (metricValueEl) metricValueEl.textContent = num(totalMetricUnits) + ' Units';
                const revenueValueEl = document.getElementById('drawer-kpi-revenue-value');
                if (revenueValueEl) revenueValueEl.textContent = money(totalRevenue);
                const skusValueEl = document.getElementById('drawer-kpi-skus-value');
                if (skusValueEl) skusValueEl.textContent = pList.length + ' SKUs';
                const completionValueEl = document.getElementById('drawer-kpi-completion-value');
                if (completionValueEl) {
                    const sellThroughPct = totalLoaded > 0 ? Math.round(totalSold / totalLoaded * 1000) / 10 : 0;
                    completionValueEl.textContent = sellThroughPct + '%';
                }

                // Update table column header for the active stage
                const thMetric = document.getElementById('th-product-active-metric');
                if (thMetric) thMetric.textContent = metricDisplay + ' Qty';

                // Render Product Orders Table
                const productBody = document.getElementById('drill-product-body');
                if (productBody) {
                    productBody.innerHTML = pList.length
                        ? pList.map(item => {
                            const stageKey = currentMetric.charAt(0).toLowerCase() + currentMetric.slice(1);
                            const activeVal = item[stageKey] !== undefined ? item[stageKey] : item.ordersPlaced;
                            const sharePct = totalMetricUnits > 0 ? Math.round(activeVal / totalMetricUnits * 1000) / 10 : 0;

                            // Category name is database-driven. Do not infer colour or identity from
                            // hardcoded Bread/Water label comparisons.
                            const lineBadgeTone = 'badge-primary text-primary-content';

                            return '<tr class="hover:bg-base-200/50 transition-colors">'
                                + '<td class="py-3">'
                                +   '<div class="flex items-center gap-2">'
                                +     '<div class="w-8 h-8 rounded-lg bg-base-200 flex items-center justify-center text-xs font-bold text-primary">'
                                +       '<i class="fa-solid fa-box"></i>'
                                +     '</div>'
                                +     '<div>'
                                +       '<div class="font-bold text-base-content text-xs">' + item.productName + '</div>'
                                +       '<div class="flex items-center gap-1.5 mt-0.5">'
                                +         '<span class="badge badge-ghost border border-base-300 font-mono text-[9px] py-0 px-1">' + item.productCode + '</span>'
                                +         '<span class="text-[10px] opacity-50">' + item.outputUnit + '</span>'
                                +       '</div>'
                                +     '</div>'
                                +   '</div>'
                                + '</td>'
                                + '<td><span class="badge badge-sm font-bold text-[10px] ' + lineBadgeTone + '">' + (item.productionCategoryName || 'Uncategorised') + '</span></td>'
                                + '<td class="text-right font-mono font-semibold">' + money(item.unitPrice) + '</td>'
                                + '<td class="text-right bg-primary/5">'
                                +   '<span class="font-mono font-black text-sm text-primary">' + num(activeVal) + '</span>'
                                +   '<span class="text-[9px] opacity-60 ml-1">' + item.outputUnit + '</span>'
                                + '</td>'
                                + '<td class="text-center">'
                                +   '<div class="flex items-center justify-center gap-1 text-[10px] font-mono">'
                                +     '<span class="px-1.5 py-0.5 rounded bg-info/10 text-info font-bold" title="Orders">' + num(item.ordersPlaced) + '</span>'
                                +     '<span class="opacity-40">&rarr;</span>'
                                +     '<span class="px-1.5 py-0.5 rounded bg-primary/10 text-primary font-bold" title="Produced">' + num(item.produced) + '</span>'
                                +     '<span class="opacity-40">&rarr;</span>'
                                +     '<span class="px-1.5 py-0.5 rounded bg-secondary/10 text-secondary font-bold" title="Loaded">' + num(item.loaded) + '</span>'
                                +     '<span class="opacity-40">&rarr;</span>'
                                +     '<span class="px-1.5 py-0.5 rounded bg-success/10 text-success font-black" title="Sold">' + num(item.sold) + '</span>'
                                +   '</div>'
                                + '</td>'
                                + '<td class="text-right font-mono font-bold text-base-content">' + money(item.expectedRevenue) + '</td>'
                                + '<td class="text-right">'
                                +   '<div class="flex items-center gap-1.5 justify-end">'
                                +     '<progress class="progress progress-primary w-14 h-1.5" value="' + sharePct + '" max="100"></progress>'
                                +     '<span class="font-mono font-bold text-[10px] w-9">' + sharePct + '%</span>'
                                +   '</div>'
                                + '</td>'
                                + '</tr>';
                        }).join('')
                        : '<tr><td colspan="7" class="text-center py-10 opacity-50 text-xs font-medium">No product orders recorded in this scope and period.</td></tr>';
                }

                // Render Sales Rep Allocations Table
                const rList = repRows();
                const repBody = document.getElementById('drill-rep-body');
                if (repBody) {
                    repBody.innerHTML = rList.length
                        ? rList.map(r => {
                            const damaged = r.damaged > 0 ? 'text-error' : 'opacity-40';
                            const customerReturns = r.customerReturns > 0 ? 'text-warning' : 'opacity-40';
                            const owed = r.outstandingBalance > 0 ? 'text-error' : 'text-success';
                            const hasShortfall = r.expectedRevenue > r.cashCollected;
                            const shortfallBadge = hasShortfall
                                ? '<span class="badge badge-error badge-xs font-bold gap-1 mt-0.5"><i class="fa-solid fa-triangle-exclamation text-[8px]"></i> Shortfall</span>'
                                : '';
                            const vehicleDisplay = r.vehicleRegistration ? r.vehicleRegistration : '—';

                            return '<tr class="hover:bg-base-200/50 transition-colors">'
                                + '<td class="py-2.5 font-bold text-base-content">'
                                +   '<div>' + r.repName + '</div>'
                                +   shortfallBadge
                                + '</td>'
                                + '<td>'
                                +   '<div class="font-medium text-xs">' + r.route + '</div>'
                                +   '<div class="text-[10px] opacity-60 font-mono">' + vehicleDisplay + '</div>'
                                + '</td>'
                                + '<td class="text-right font-mono font-bold text-info">' + num(r.ordersPlaced) + '</td>'
                                + '<td class="text-right font-mono font-bold text-secondary">' + num(r.loaded) + '</td>'
                                + '<td class="text-right font-mono font-black text-success">' + num(r.sold) + '</td>'
                                + '<td class="text-right font-mono font-bold text-warning">' + num(r.returned) + '</td>'
                                + '<td class="text-right font-mono font-bold ' + damaged + '">' + num(r.damaged) + '</td>'
                                + '<td class="text-right font-mono font-bold ' + customerReturns + '">' + num(r.customerReturns) + '</td>'
                                + '<td class="text-right font-mono font-bold text-base-content">' + money(r.expectedRevenue) + '</td>'
                                + '<td class="text-right font-mono font-bold text-success">' + money(r.cashCollected) + '</td>'
                                + '<td class="text-right font-mono font-bold ' + owed + '">' + money(r.outstandingBalance) + '</td>'
                                + '</tr>';
                        }).join('')
                        : '<tr><td colspan="11" class="text-center py-10 opacity-50 text-xs font-medium">No sales rep activity recorded in this scope and period.</td></tr>';
                }

                // Update Footer Summary Text
                const footerEl = document.getElementById('drill-footer-summary');
                if (footerEl) {
                    footerEl.textContent = 'Showing ' + pList.length + ' products & ' + rList.length + ' reps · ' + num(totalMetricUnits) + ' total ' + metricDisplay.toLowerCase() + ' units';
                }

                // Update reports deep links
                const drillLink = document.getElementById('drill-reports-link');
                if (drillLink) drillLink.setAttribute('href', reportsUrl());
                const execLink = document.getElementById('exec-reports-link');
                if (execLink) execLink.setAttribute('href', reportsUrl());
            }

            // Slide-Over Drawer Opening & Closing.
            // The lifecycle KPI cards are the only entry point: they always open
            // the Records view. Product-line cards are read-only.
            window.openDrill = function (scopeKey, periodKey, stageMetric) {
                scope = scopeKey || 'all';
                period = periodKey || 'Today'; // Initially Today!
                metric = stageMetric || 'OrdersPlaced';
                viewMode = 'records';

                const drillScopeInput = document.getElementById('drill-scope');
                if (drillScopeInput) drillScopeInput.value = scope;
                const drillPeriodInput = document.getElementById('drill-period');
                if (drillPeriodInput) drillPeriodInput.value = period;
                const drillMetricInput = document.getElementById('drill-metric');
                if (drillMetricInput) drillMetricInput.value = metric;
                const drillViewInput = document.getElementById('drill-view-mode');
                if (drillViewInput) drillViewInput.value = viewMode;

                // Sync UI buttons
                paintStrip('.drill-scope-btn', 'scope', scope);
                paintStrip('.drill-period-btn', 'period', period);
                window.switchDrillTab(viewMode);

                // Reveal Slide-Over Drawer with smooth CSS slide-in
                const backdrop = document.getElementById('drill-backdrop');
                if (backdrop) {
                    backdrop.classList.remove('opacity-0', 'pointer-events-none');
                    backdrop.classList.add('opacity-100');
                }
                const drawer = document.getElementById('drill-drawer');
                if (drawer) {
                    drawer.classList.remove('translate-x-full');
                    drawer.classList.add('translate-x-0');
                }

                // Prevent body scrolling while drawer is active
                document.body.classList.add('overflow-hidden');

                render();
            };

            window.closeDrillDrawer = function () {
                const backdrop = document.getElementById('drill-backdrop');
                if (backdrop) {
                    backdrop.classList.remove('opacity-100');
                    backdrop.classList.add('opacity-0', 'pointer-events-none');
                }
                const drawer = document.getElementById('drill-drawer');
                if (drawer) {
                    drawer.classList.remove('translate-x-0');
                    drawer.classList.add('translate-x-full');
                }
                document.body.classList.remove('overflow-hidden');
            };

            window.switchDrillTab = function (mode) {
                viewMode = mode;
                const recContainer = document.getElementById('drill-records-container');
                const sContainer = document.getElementById('drill-stage-container');
                const pContainer = document.getElementById('drill-product-container');
                const rContainer = document.getElementById('drill-rep-container');
                const recTab = document.getElementById('tab-btn-records');
                const sTab = document.getElementById('tab-btn-stage');
                const pTab = document.getElementById('tab-btn-products');
                const rTab = document.getElementById('tab-btn-reps');

                const show = (el, visible) => {
                    if (!el) return;
                    if (visible) el.classList.remove('hidden');
                    else el.classList.add('hidden');
                };
                const active = (el, on) => {
                    if (!el) return;
                    if (on) el.classList.add('tab-active');
                    else el.classList.remove('tab-active');
                };

                show(recContainer, mode === 'records');
                show(sContainer, mode === 'stage');
                show(pContainer, mode === 'products');
                show(rContainer, mode === 'reps');
                active(recTab, mode === 'records');
                active(sTab, mode === 'stage');
                active(pTab, mode === 'products');
                active(rTab, mode === 'reps');

                const drillViewInput = document.getElementById('drill-view-mode');
                if (drillViewInput) drillViewInput.value = mode;

                render();
            };

            // Dynamic Timeframe & Scope Switching inside Drawer
            window.applyExecPeriod = function (key) {
                period = key;
                const drillPeriodInput = document.getElementById('drill-period');
                if (drillPeriodInput) drillPeriodInput.value = key;
                paintStrip('.drill-period-btn', 'period', key);

                document.querySelectorAll('.exec-period-panel').forEach(panel => {
                    panel.classList.toggle('hidden', panel.dataset.periodPanel !== key);
                });

                const p = periodOf(key);
                const captionEl = document.getElementById('exec-period-caption');
                if (captionEl) {
                    captionEl.textContent = p.label + ' — ' + p.dateLabel;
                }

                render();
            };

            window.selectDrillScope = function (button) {
                scope = button.dataset.scope;
                const drillScopeInput = document.getElementById('drill-scope');
                if (drillScopeInput) drillScopeInput.value = scope;
                paintStrip('.drill-scope-btn', 'scope', scope);
                render();
            };

            window.selectDrillPeriod = function (button) {
                const key = button.dataset.period;
                const radio = document.getElementById('exec-period-' + key);
                if (radio) { radio.checked = true; }
                window.applyExecPeriod(key);
            };

            document.querySelectorAll('input[name="exec-period"]').forEach(input => {
                input.addEventListener('change', () => {
                    if (input.checked) window.applyExecPeriod(input.value);
                });
            });

            const searchInput = document.getElementById('drill-search-input');
            if (searchInput) {
                searchInput.addEventListener('input', () => render());
            }

            // Keyboard Escape key to close drawer
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') {
                    window.closeDrillDrawer();
                }
            });

            // Initial view setup
            paintStrip('.drill-scope-btn', 'scope', 'all');
            window.applyExecPeriod('Today');
        })();
    </script>
}
}

