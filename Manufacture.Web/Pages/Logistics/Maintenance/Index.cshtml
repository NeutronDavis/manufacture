@page
@model Manufacture.Pages.Logistics.Maintenance.IndexModel
@{
    ViewData["Title"] = "Maintenance Logs";
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Logistics/Index" class="hover:underline">Fleet &amp; Logistics</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Maintenance Logs</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-wrench text-primary"></i> Vehicle Maintenance Logs
            </h1>
            <p class="text-xs opacity-70 mt-0.5">Service history with before/after photo evidence for every fleet vehicle.</p>
        </div>
        <a asp-page="/Logistics/Maintenance/Create" class="btn btn-sm btn-neutral rounded-xl gap-2 font-bold px-4 shadow-xs text-xs">
            <i class="fa-solid fa-plus text-xs"></i> Log New Maintenance
        </a>
    </div>

    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
        <div class="card-body p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-base-200 pb-3">
                <h2 class="font-bold text-sm text-base-content">Maintenance History</h2>
                <span class="badge badge-neutral badge-xs font-mono">@Model.Logs.Count record(s)</span>
            </div>
            <div class="overflow-x-auto">
                <table class="table table-sm w-full text-xs">
                    <thead>
                        <tr class="opacity-60 uppercase text-[10px] tracking-wider border-b border-base-200 bg-base-200/50">
                            <th>Service Date</th>
                            <th>Vehicle</th>
                            <th>Description</th>
                            <th>Workshop / Vendor</th>
                            <th>Invoice</th>
                            <th class="text-right">Cost (₦)</th>
                            <th class="text-center">Evidence</th>
                            <th class="text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-base-200">
                        @if (!Model.Logs.Any())
                        {
                            <tr><td colspan="8" class="text-center py-10 text-xs opacity-60">No maintenance logs recorded yet.</td></tr>
                        }
                        @foreach (var log in Model.Logs)
                        {
                            <tr class="hover:bg-base-200/60 transition-colors">
                                <td class="font-mono text-[11px]">@log.ServiceDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge badge-neutral badge-xs font-mono font-bold">@log.VehicleRegNumber</span></td>
                                <td class="max-w-xs truncate">@log.Description</td>
                                <td>@log.WorkshopOrVendor</td>
                                <td class="font-mono text-[10px] opacity-70">@log.InvoiceNumber</td>
                                <td class="text-right font-mono font-bold">₦@log.Cost.ToString("N2")</td>
                                <td class="text-center">
                                    @{
                                        var photoCount = (!string.IsNullOrWhiteSpace(log.BeforeImageUrl) ? 1 : 0)
                                                       + (!string.IsNullOrWhiteSpace(log.AfterImageUrl) ? 1 : 0);
                                    }
                                    @if (photoCount > 0)
                                    {
                                        <span class="badge badge-success badge-xs font-bold">@photoCount photo@(photoCount == 1 ? "" : "s")</span>
                                    }
                                    else
                                    {
                                        <span class="opacity-40">—</span>
                                    }
                                </td>
                                <td class="text-right">
                                    <a asp-page="/Logistics/Maintenance/Details" asp-route-id="@log.Id" class="btn btn-xs btn-outline border-base-300 rounded-lg gap-1">
                                        <i class="fa-solid fa-eye text-[10px]"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
