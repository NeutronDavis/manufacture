@page
@model Manufacture.Pages.Logistics.Vehicles.IndexModel
@{
    ViewData["Title"] = "Delivery Vehicles";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Logistics/Index" class="hover:underline">Fleet Logistics</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Vehicles</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-van-shuttle text-primary"></i> Company Delivery Vehicles
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Manage delivery vans, assigned drivers, tank capacities, and service schedules.
            </p>
        </div>
        <div>
            <a asp-page="/Logistics/Vehicles/Create" class="btn btn-sm btn-neutral rounded-xl gap-2 font-bold px-4 shadow-xs text-xs">
                <i class="fa-solid fa-plus text-xs"></i> Register Vehicle
            </a>
        </div>
    </div>

    <!-- Search & vehicle type filter -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-4">
        <form method="get" class="flex flex-col sm:flex-row sm:items-end gap-3">
            <div class="form-control flex-1">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Search vehicle</span></label>
                <input type="text" name="search" value="@Model.Search" placeholder="Registration, model or driver..."
                       class="input input-sm input-bordered w-full bg-base-200 border-base-300 rounded-xl text-xs" />
            </div>
            <div class="form-control w-full sm:w-56">
                <label class="label pb-1"><span class="label-text text-xs font-bold">Vehicle type</span></label>
                <select name="typeFilter" class="select select-sm select-bordered bg-base-200 border-base-300 rounded-xl text-xs font-semibold">
                    <option value="">All vehicle types</option>
                    @foreach (var type in Model.VehicleTypes)
                    {
                        <option value="@type" selected="@(string.Equals(Model.TypeFilter, type, StringComparison.OrdinalIgnoreCase))">@type</option>
                    }
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn btn-sm btn-neutral rounded-xl text-xs font-bold gap-1.5">
                    <i class="fa-solid fa-filter text-xs"></i> Apply
                </button>
                <a asp-page="/Logistics/Vehicles/Index" class="btn btn-sm btn-ghost rounded-xl text-xs">Clear</a>
            </div>
        </form>
    </div>
    <!-- Grid of Vehicle Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var v in Model.Vehicles)
        {
            <div onclick="window.location.href='/Logistics/Vehicles/Details/@v.Id'" class="card bg-base-100 border border-base-300 shadow-xs hover:shadow-md hover:border-primary transition-all duration-200 rounded-2xl flex flex-col justify-between cursor-pointer">
                <div class="card-body p-6 space-y-4">
                    @if (!string.IsNullOrWhiteSpace(v.ImageUrl))
                    {
                        <img src="@v.ImageUrl" alt="@v.MakeAndModel" class="w-full h-36 object-cover rounded-xl border border-base-300" />
                    }
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="badge badge-neutral badge-xs font-mono font-bold">@v.RegistrationNumber</span>
                            <h2 class="font-black text-base text-base-content tracking-tight mt-1">@v.MakeAndModel</h2>
                        </div>
                        <span class="badge badge-success badge-xs font-bold">● @v.Status</span>
                    </div>

                    <div class="space-y-2 bg-base-200 border border-base-300 p-4 rounded-xl text-xs">
                        <div class="flex justify-between">
                            <span class="opacity-60">Vehicle Type:</span>
                            <span class="font-bold text-base-content">@v.Type</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="opacity-60">Vehicle Function:</span>
                            <span class="badge badge-primary badge-xs font-bold">@v.Function</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="opacity-60">Assigned Driver:</span>
                            <span class="font-bold text-base-content">@(string.IsNullOrWhiteSpace(v.AssignedDriverName) ? "Unassigned" : v.AssignedDriverName)</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="opacity-60">Driver Phone:</span>
                            <span class="font-mono font-bold text-primary">@(string.IsNullOrWhiteSpace(v.DriverPhoneNumber) ? "—" : v.DriverPhoneNumber)</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="opacity-60">Fuel Type / Tank:</span>
                            <span class="font-mono">@v.FuelType (@v.TankCapacityLitres L)</span>
                        </div>
                        <div class="flex justify-between font-mono pt-1 border-t border-base-300">
                            <span class="opacity-60 font-sans">Current Odometer:</span>
                            <span class="font-bold text-base-content">@v.CurrentOdometerKm.ToString("N0") KM</span>
                        </div>
                    </div>

                    <div class="pt-2 border-t border-base-200 flex justify-between items-center text-xs">
                        <div class="flex items-center gap-1.5">
                            <a asp-page="/Logistics/FuelLogs/Create" asp-route-vehicleId="@v.Id" onclick="event.stopPropagation()" class="btn btn-xs btn-outline border-base-300 rounded-lg gap-1 font-semibold hover:border-primary">
                                <i class="fa-solid fa-gas-pump text-[10px]"></i> Fuel
                            </a>
                            <a asp-page="/Logistics/Maintenance/Create" asp-route-vehicleId="@v.Id" onclick="event.stopPropagation()" class="btn btn-xs btn-outline border-base-300 rounded-lg gap-1 font-semibold hover:border-primary">
                                <i class="fa-solid fa-wrench text-[10px]"></i> Service
                            </a>
                        </div>
                        <span class="text-[11px] opacity-60">Serviced: @(v.LastServiceDate?.ToString("yyyy-MM-dd") ?? "—")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
