@page
@model Manufacture.Pages.Logistics.Rates.CreateModel
@using System.Text.Json
@using Manufacture.Models.DTOs
@{
    ViewData["Title"] = "New Client Quote";
    var initialLegs = JsonSerializer.Serialize(Model.QuoteInput.Legs.Select(l => new
    {
        l.LegNumber,
        l.OriginAddress,
        l.OriginCityState,
        l.DestinationAddress,
        l.DestinationCityState,
        l.DistanceKm,
        FuelOption = l.FuelOption.ToString(),
        l.QuotedLegAmount,
        l.Notes
    }), new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Logistics/Index" class="hover:underline">Fleet Logistics</a>
                <span>&gt;</span>
                <a asp-page="/Logistics/Rates/Index" class="hover:underline">Client Quotes</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">New Quote</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-file-invoice-dollar text-primary"></i> New Client Quote
            </h1>
            <p class="text-xs opacity-70 mt-0.5">Enter the client request manually. Addresses and distance are captured per leg; there is no state/city fixed price.</p>
        </div>
        <a asp-page="/Logistics/Rates/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-semibold">
            <i class="fa-solid fa-arrow-left text-xs"></i> Back to Client Quotes
        </a>
    </div>

    <form method="post" id="quoteForm" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        <div class="lg:col-span-8 space-y-6">
            <div class="card bg-base-100 border border-base-300 rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-base-200">
                    <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                        <div class="w-7 h-7 rounded-lg bg-neutral text-neutral-content flex items-center justify-center text-xs font-bold">1</div>
                        <span>Client &amp; Vehicle Request</span>
                    </div>
                    <span class="badge badge-neutral badge-xs font-bold">Manual Quote</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="form-control w-full sm:col-span-2">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Client / Company Name <span class="text-error">*</span></span></label>
                        <input asp-for="QuoteInput.CustomerName" class="input input-sm input-bordered w-full rounded-xl text-xs font-bold bg-base-200 border-base-300" required />
                        <span asp-validation-for="QuoteInput.CustomerName" class="text-error text-[10px]"></span>
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Phone <span class="text-error">*</span></span></label>
                        <input asp-for="QuoteInput.CustomerPhone" class="input input-sm input-bordered w-full rounded-xl text-xs font-mono bg-base-200 border-base-300" required />
                        <span asp-validation-for="QuoteInput.CustomerPhone" class="text-error text-[10px]"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Email (optional)</span></label>
                        <input asp-for="QuoteInput.CustomerEmail" type="email" class="input input-sm input-bordered w-full rounded-xl text-xs bg-base-200 border-base-300" />
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Trip Type</span></label>
                        <select asp-for="QuoteInput.TripType" class="select select-sm select-bordered w-full rounded-xl text-xs bg-base-200 border-base-300">
                            <option value="@CharterQuoteTripType.OneWay">One Way</option>
                            <option value="@CharterQuoteTripType.Return">Return</option>
                            <option value="@CharterQuoteTripType.MultiStop">Multi-Stop</option>
                        </select>
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Quote Valid Until</span></label>
                        <input asp-for="QuoteInput.ValidUntil" type="date" class="input input-sm input-bordered w-full rounded-xl text-xs font-mono bg-base-200 border-base-300" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Vehicle Class <span class="text-error">*</span></span></label>
                        <select asp-for="QuoteInput.VehicleTypeRequired" class="select select-sm select-bordered w-full rounded-xl text-xs font-bold bg-base-200 border-base-300" required>
                            @foreach (var type in Model.VehicleTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Preferred Vehicle (optional)</span></label>
                        <select asp-for="QuoteInput.VehicleId" class="select select-sm select-bordered w-full rounded-xl text-xs bg-base-200 border-base-300">
                            <option value="">Not assigned yet</option>
                            @foreach (var vehicle in Model.AvailableVehicles)
                            {
                                <option value="@vehicle.Id">@vehicle.RegistrationNumber - @vehicle.MakeAndModel (@vehicle.Type)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-300 rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between pb-3 border-b border-base-200">
                    <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                        <div class="w-7 h-7 rounded-lg bg-neutral text-neutral-content flex items-center justify-center text-xs font-bold">2</div>
                        <div>
                            <span>Multi-Stop Route &amp; Manual Pricing</span>
                            <p class="text-[11px] text-base-content/60 font-normal">Address, fuel term and amount for every leg</p>
                        </div>
                    </div>
                    <button type="button" onclick="addLeg()" class="btn btn-sm btn-neutral rounded-xl gap-1.5 font-bold text-xs">
                        <i class="fa-solid fa-plus text-[10px]"></i> Add Leg
                    </button>
                </div>
                <div id="legsContainer" class="space-y-4"></div>
                <span asp-validation-for="QuoteInput.Legs" class="text-error text-[11px]"></span>
            </div>

            <div class="card bg-base-100 border border-base-300 rounded-2xl p-6 space-y-5">
                <div class="flex items-center gap-2.5 pb-3 border-b border-base-200">
                    <div class="w-7 h-7 rounded-lg bg-neutral text-neutral-content flex items-center justify-center text-xs font-bold">3</div>
                    <div>
                        <h2 class="text-sm font-black text-base-content">Trip Incidentals &amp; Notes</h2>
                        <p class="text-[11px] text-base-content/60">These amounts are deducted from the quoted total to estimate net revenue.</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Driver Allowance (₦)</span></label>
                        <input asp-for="QuoteInput.DriverAllowance" type="number" step="1000" min="0" id="driverAllowance" class="input input-sm input-bordered w-full rounded-xl text-xs font-mono" oninput="recalculate()" />
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Security / Escort Fee (₦)</span></label>
                        <input asp-for="QuoteInput.SecurityEscortFee" type="number" step="1000" min="0" id="securityFee" class="input input-sm input-bordered w-full rounded-xl text-xs font-mono" oninput="recalculate()" />
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1.5"><span class="label-text font-bold text-xs">Tolls &amp; Road Levies (₦)</span></label>
                        <input asp-for="QuoteInput.TollsAndRoadLevies" type="number" step="1000" min="0" id="tollsFee" class="input input-sm input-bordered w-full rounded-xl text-xs font-mono" oninput="recalculate()" />
                    </div>
                </div>
                <div class="form-control w-full">
                    <label class="label pb-1.5"><span class="label-text font-bold text-xs">Quote Notes / Client Requirements <span class="text-error">*</span></span></label>
                    <textarea asp-for="QuoteInput.Notes" rows="3" class="textarea textarea-bordered w-full rounded-xl text-xs bg-base-200 border-base-300" placeholder="e.g. VIP escort requested from Victoria Island to Port Harcourt, client provides diesel at Onitsha." required></textarea>
                    <span asp-validation-for="QuoteInput.Notes" class="text-error text-[10px]"></span>
                </div>
            </div>
        </div>

        <div class="lg:col-span-4 sticky top-20 space-y-4">
            <div class="card bg-base-100 border border-base-300 shadow-md rounded-2xl overflow-hidden">
                <div class="bg-neutral text-neutral-content p-5">
                    <div class="text-[10px] uppercase font-bold tracking-wider opacity-70">Manual Client Quote</div>
                    <div class="mt-3">
                        <div class="text-[11px] opacity-70">Total Quoted Amount</div>
                        <div id="quotedDisplay" class="text-3xl font-black tracking-tight text-white font-mono mt-0.5">₦0</div>
                    </div>
                </div>
                <div class="p-6 space-y-4 text-xs">
                    <div class="flex justify-between items-center text-base-content/70"><span>Incidentals:</span><span id="incidentalsDisplay" class="font-bold text-error font-mono">₦0</span></div>
                    <div class="flex justify-between items-center pt-3 border-t border-base-200 text-sm font-bold"><span>Estimated Net:</span><span id="netDisplay" class="font-black text-success font-mono">₦0</span></div>
                    <div class="alert alert-info py-2.5 px-3 rounded-xl text-[11px] flex items-start gap-2">
                        <i class="fa-solid fa-circle-info text-xs mt-0.5"></i>
                        <span>This is a manual quote. The system totals your leg amounts; it does not apply a state/city or per-km formula.</span>
                    </div>
                    <div class="space-y-2 pt-2">
                        <button type="submit" asp-page-handler="Submit" class="btn btn-neutral w-full rounded-xl font-black text-xs py-3 shadow-xs gap-2">
                            <i class="fa-solid fa-paper-plane"></i> Submit for Approval
                        </button>
                        <button type="submit" asp-page-handler="SaveDraft" class="btn btn-outline w-full rounded-xl font-bold text-xs py-2.5 gap-2 border-base-300">
                            <i class="fa-solid fa-floppy-disk"></i> Save Draft
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    const initialLegs = @Html.Raw(initialLegs);
    let legs = Array.isArray(initialLegs) && initialLegs.length > 0 ? initialLegs : [{ legNumber: 1, originAddress: '', originCityState: 'Lagos', destinationAddress: '', destinationCityState: '', distanceKm: 0, fuelOption: 'WithFuel', quotedLegAmount: 0, notes: '' }];

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);
    }
    function money(value) { return '₦' + (Number(value) || 0).toLocaleString('en-US'); }

    function addLeg() {
        legs.push({ legNumber: legs.length + 1, originAddress: '', originCityState: '', destinationAddress: '', destinationCityState: '', distanceKm: 0, fuelOption: 'WithFuel', quotedLegAmount: 0, notes: '' });
        renderLegs();
        recalculate();
    }
    function removeLeg(index) {
        if (legs.length <= 1) { alert('A quote must have at least one leg.'); return; }
        legs.splice(index, 1);
        legs.forEach((leg, i) => leg.legNumber = i + 1);
        renderLegs();
        recalculate();
    }
    function updateLeg(index, field, value) {
        legs[index][field] = value;
        recalculate();
    }
    function renderLegs() {
        const container = document.getElementById('legsContainer');
        container.innerHTML = legs.map((leg, index) => `
            <div class="card bg-base-200/50 border border-base-300 p-4 rounded-2xl space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-base-300/60">
                    <span class="badge badge-neutral badge-sm font-black text-[10px]">Leg ${index + 1}</span>
                    ${legs.length > 1 ? `<button type="button" onclick="removeLeg(${index})" class="btn btn-ghost btn-xs text-error rounded-lg gap-1"><i class="fa-solid fa-trash text-[10px]"></i> Remove</button>` : ''}
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="form-control w-full">
                        <label class="label pb-1"><span class="label-text text-[11px] font-bold">Origin Address *</span></label>
                        <input name="QuoteInput.Legs[${index}].OriginAddress" value="${escapeHtml(leg.originAddress)}" class="input input-sm input-bordered w-full rounded-xl text-xs" required oninput="updateLeg(${index}, 'originAddress', this.value)" />
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1"><span class="label-text text-[11px] font-bold">Origin City / State *</span></label>
                        <input name="QuoteInput.Legs[${index}].OriginCityState" value="${escapeHtml(leg.originCityState)}" class="input input-sm input-bordered w-full rounded-xl text-xs" required oninput="updateLeg(${index}, 'originCityState', this.value)" />
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1"><span class="label-text text-[11px] font-bold">Destination Address *</span></label>
                        <input name="QuoteInput.Legs[${index}].DestinationAddress" value="${escapeHtml(leg.destinationAddress)}" class="input input-sm input-bordered w-full rounded-xl text-xs" required oninput="updateLeg(${index}, 'destinationAddress', this.value)" />
                    </div>
                    <div class="form-control w-full">
                        <label class="label pb-1"><span class="label-text text-[11px] font-bold">Destination City / State *</span></label>
                        <input name="QuoteInput.Legs[${index}].DestinationCityState" value="${escapeHtml(leg.destinationCityState)}" class="input input-sm input-bordered w-full rounded-xl text-xs" required oninput="updateLeg(${index}, 'destinationCityState', this.value)" />
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="form-control w-full">
                        <label class="label pb-1"><span class="label-text text-[11px] font-bold">Fuel Term</span></label>
                        <select name="QuoteInput.Legs[${index}].FuelOption" class="select select-sm select-bordered w-full rounded-xl text-xs" onchange="updateLeg(${index}, 'fuelOption', this.value)">
                            <option value="WithFuel" ${leg.fuelOption === 'WithFuel' ? 'selected' : ''}>Company Fuel</option>
                            <option value="WithoutFuel" ${leg.fuelOption === 'WithoutFuel' ? 'selected' : ''}>Client Fuels</option>
                        </select>
                    </div>
                    <div class="form-control w-full sm:col-span-2">
                        <label class="label pb-1"><span class="label-text text-[11px] font-bold">Quoted Leg Amount (₦)</span></label>
                        <input type="number" min="0" step="any" name="QuoteInput.Legs[${index}].QuotedLegAmount" value="${leg.quotedLegAmount || ''}" class="input input-sm input-bordered w-full rounded-xl text-xs font-mono font-black text-success" oninput="updateLeg(${index}, 'quotedLegAmount', parseFloat(this.value) || 0)" />
                    </div>
                </div>
                <div class="form-control w-full">
                    <label class="label pb-1"><span class="label-text text-[11px] font-bold">Leg Notes</span></label>
                    <input name="QuoteInput.Legs[${index}].Notes" value="${escapeHtml(leg.notes)}" class="input input-sm input-bordered w-full rounded-xl text-xs" oninput="updateLeg(${index}, 'notes', this.value)" />
                </div>
                <input type="hidden" name="QuoteInput.Legs[${index}].LegNumber" value="${index + 1}" />
            </div>
        `).join('');
    }
    function recalculate() {
        const quoted = legs.reduce((sum, leg) => sum + (parseFloat(leg.quotedLegAmount) || 0), 0);
        const incidentals = (parseFloat(document.getElementById('driverAllowance').value) || 0)
            + (parseFloat(document.getElementById('securityFee').value) || 0)
            + (parseFloat(document.getElementById('tollsFee').value) || 0);
        document.getElementById('quotedDisplay').textContent = money(quoted);
        document.getElementById('incidentalsDisplay').textContent = money(incidentals);
        document.getElementById('netDisplay').textContent = money(quoted - incidentals);
    }
    document.addEventListener('DOMContentLoaded', () => { renderLegs(); recalculate(); });
</script>
}
