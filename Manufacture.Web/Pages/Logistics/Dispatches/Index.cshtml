@page
@model Manufacture.Pages.Logistics.Dispatches.IndexModel
@using Manufacture.Models.DTOs
@{
    ViewData["Title"] = "Delivery Dispatches";
}

<div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs breadcrumbs p-0 mb-1">
                <ul>
                    <li><a asp-page="/Dashboard/Index" class="opacity-60">Dashboard</a></li>
                    <li><a asp-page="/Logistics/Index" class="opacity-60">Fleet & Logistics</a></li>
                    <li class="font-bold text-base-content">Delivery Dispatches</li>
                </ul>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-info/10 text-info flex items-center justify-center font-black text-lg">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-base-content tracking-tight">Production & PreOrder Delivery Dispatches</h1>
                    <p class="text-xs text-base-content/60">Non-charter vehicle movements with multiple delivery points, vehicle status and linked fuel records.</p>
                </div>
            </div>
        </div>
        <a asp-page="/Logistics/Dispatches/Create" class="btn btn-neutral btn-sm rounded-xl gap-2 font-bold text-xs">
            <i class="fa-solid fa-plus"></i> New Delivery Dispatch
        </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card bg-base-100 border border-base-300 p-4 rounded-2xl"><div class="text-xs font-semibold text-base-content/60">Planned</div><div class="mt-2 text-2xl font-black text-warning">@Model.PlannedCount</div></div>
        <div class="card bg-base-100 border border-base-300 p-4 rounded-2xl"><div class="text-xs font-semibold text-base-content/60">In Transit</div><div class="mt-2 text-2xl font-black text-info">@Model.InTransitCount</div></div>
        <div class="card bg-base-100 border border-base-300 p-4 rounded-2xl"><div class="text-xs font-semibold text-base-content/60">Completed</div><div class="mt-2 text-2xl font-black text-success">@Model.CompletedCount</div></div>
        <div class="card bg-base-100 border border-base-300 p-4 rounded-2xl"><div class="text-xs font-semibold text-base-content/60">Linked Fuel Cost</div><div class="mt-2 text-2xl font-black text-base-content">₦@Model.TotalFuelCost.ToString("N0")</div></div>
    </div>

    <div class="card bg-base-100 border border-base-300 p-4 rounded-2xl">
        <form method="get" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
            <label class="form-control"><span class="label-text text-[10px] font-bold pb-1">Status</span><select name="StatusFilter" class="select select-sm select-bordered rounded-xl text-xs">@foreach (var s in new[] { "All", "Planned", "Loading", "InTransit", "Delivered", "Completed", "Cancelled" }) { <option value="@s" selected="@(Model.StatusFilter == s)">@s</option> }</select></label>
            <label class="form-control"><span class="label-text text-[10px] font-bold pb-1">From</span><input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="input input-sm input-bordered rounded-xl text-xs" /></label>
            <label class="form-control"><span class="label-text text-[10px] font-bold pb-1">To</span><input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="input input-sm input-bordered rounded-xl text-xs" /></label>
            <label class="form-control"><span class="label-text text-[10px] font-bold pb-1">Vehicle</span><select name="VehicleId" class="select select-sm select-bordered rounded-xl text-xs"><option value="">All</option>@foreach (var v in Model.Vehicles) { <option value="@v.Id" selected="@(Model.VehicleId == v.Id)">@v.RegistrationNumber</option> }</select></label>
            <label class="form-control"><span class="label-text text-[10px] font-bold pb-1">Search</span><input type="text" name="Search" value="@Model.Search" class="input input-sm input-bordered rounded-xl text-xs" placeholder="Ref, vehicle, stop..." /></label>
            <div class="flex gap-2"><button type="submit" class="btn btn-sm btn-neutral rounded-xl text-xs">Apply</button><a asp-page="/Logistics/Dispatches/Index" class="btn btn-sm btn-ghost rounded-xl text-xs">Clear</a></div>
        </form>
    </div>

    <div class="card bg-base-100 border border-base-300 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table table-sm text-xs">
                <thead><tr class="bg-base-200/60 border-b border-base-300"><th>Dispatch</th><th>Vehicle / Driver</th><th>Purpose</th><th>Stops</th><th class="text-right">Fuel</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
                <tbody class="divide-y divide-base-200">
                    @if (!Model.Dispatches.Any())
                    {
                        <tr><td colspan="7" class="text-center py-12 text-base-content/50">No delivery dispatches found.</td></tr>
                    }
                    @foreach (var d in Model.Dispatches)
                    {
                        <tr class="hover:bg-base-200/30">
                            <td class="py-3 px-4"><a asp-page="/Logistics/Dispatches/Details" asp-route-id="@d.Id" class="font-black text-primary hover:underline">@d.DispatchRef</a><div class="text-[10px] opacity-50">@d.DispatchDate.ToString("dd MMM yyyy")</div></td>
                            <td class="py-3 px-4"><div class="font-bold">@d.VehicleRegNumber</div><div class="text-[10px] opacity-50">@d.DriverName</div></td>
                            <td class="py-3 px-4"><span class="badge badge-ghost badge-xs">@d.Purpose</span></td>
                            <td class="py-3 px-4"><div class="font-bold">@d.Stops.Count</div><div class="text-[10px] opacity-50">@d.DeliveredStopCount delivered · @d.PendingStopCount pending · @d.FailedStopCount failed</div></td>
                            <td class="py-3 px-4 text-right font-mono">₦@d.TotalFuelCost.ToString("N0")</td>
                            <td class="py-3 px-4"><span class="badge badge-sm @IndexModel.StatusBadge(d.Status) font-bold">@d.Status</span></td>
                            <td class="py-3 px-4 text-right"><a asp-page="/Logistics/Dispatches/Details" asp-route-id="@d.Id" class="btn btn-ghost btn-xs rounded-lg"><i class="fa-solid fa-eye"></i></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
