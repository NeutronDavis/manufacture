@page
@model Manufacture.Pages.UserManagement.IndexModel
@{
    ViewData["Title"] = "User Accounts & PIN Access";
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-users-gear text-primary"></i> System Users & PIN Access
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Configure role-based access, fast numeric passcodes for POS reps, and soft-delete account preservation
            </p>
        </div>
        <div class="flex gap-2">
            <a asp-page="/UserManagement/Permissions" class="btn btn-sm btn-outline border-base-300 rounded-xl gap-2 font-semibold px-3.5 text-xs">
                <i class="fa-solid fa-shield-halved text-xs"></i> RBAC Matrix
            </a>
            <a asp-page="/UserManagement/Create" class="btn btn-sm btn-neutral rounded-xl gap-2 font-bold px-4 text-xs shadow-xs">
                <i class="fa-solid fa-user-plus text-xs"></i> Add New User
            </a>
        </div>
    </div>

    <!-- Soft Delete Retention Notice using daisyUI alert -->
    <div class="alert alert-info shadow-xs rounded-2xl text-xs py-3">
        <i class="fa-solid fa-circle-info text-base"></i>
        <span><strong>Data Retention Policy:</strong> When a user departs, deactivating them performs a "Soft Delete" — revoking active login access while preserving all historical sales receipts and audit trails.</span>
    </div>

    <!-- Users Table -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
        <div class="card-body p-6 space-y-4">
            <div class="overflow-x-auto">
                <table class="table table-sm w-full text-xs">
                    <thead>
                        <tr class="opacity-60 uppercase text-[10px] tracking-wider border-b border-base-200 bg-base-200/50">
                            <th class="py-3.5 pl-4">Full Name</th>
                            <th>Email Address</th>
                            <th>Role & Access Level</th>
                            <th>6-Digit PIN</th>
                            <th>Status</th>
                            <th class="text-right pr-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-base-200">
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-base-200/60 transition-colors">
                                <td class="py-3.5 pl-4">
                                    <div class="font-bold text-xs text-base-content">@user.Name</div>
                                    <div class="text-[10px] opacity-60">Created: @user.CreatedAt.ToString("yyyy-MM-dd")</div>
                                </td>
                                <td>
                                    <div class="font-mono text-xs font-semibold text-base-content">@user.Email</div>
                                </td>
                                <td>
                                    <span class="badge badge-neutral badge-xs font-bold px-2 py-0.5">@user.Role</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.PinCode))
                                    {
                                        <span class="badge badge-success badge-xs font-mono font-bold">● Configured</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning badge-xs font-mono">None</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge badge-success badge-xs font-bold gap-1">● Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-error badge-xs font-bold gap-1">● Inactive</span>
                                    }
                                </td>
                                <td class="text-right pr-4">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-page="/UserManagement/Edit" asp-route-id="@user.Id" class="btn btn-xs btn-outline border-base-300 rounded-lg">
                                            Edit
                                        </a>
                                        <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@user.Id" class="inline">
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-xs btn-ghost text-error rounded-lg" onclick="return confirm('Soft-delete / deactivate this user account?');">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-xs btn-ghost text-success rounded-lg">
                                                    Activate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
