@page
@model Manufacture.Pages.Settings.ThemeModel
@{
    ViewData["Title"] = "Theme & Color Palette Settings";
}

<div class="space-y-6 w-full">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Home</a>
                <span>&gt;</span>
                <a asp-page="/UserManagement/Index" class="hover:underline">Settings</a>
                <span>&gt;</span>
                <span>Theme & Color Palettes</span>
            </div>
            <h1 class="text-2xl font-black tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-palette text-primary"></i> Theme & Color Palette Settings
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Customize the visual appearance, color scheme, and typography of the entire ERP system using official daisyUI themes and custom brand palettes.
            </p>
        </div>
        <div class="flex gap-2">
            <button type="button" onclick="setErpTheme('bakeryflow')" class="btn btn-sm btn-neutral rounded-xl text-xs gap-1.5 font-bold shadow-xs">
                <i class="fa-solid fa-wand-magic-sparkles text-xs"></i> Apply BakeryFlow Theme
            </button>
            <button type="button" onclick="setErpTheme('corporate')" class="btn btn-sm btn-outline rounded-xl text-xs gap-1.5">
                <i class="fa-solid fa-rotate-left text-xs"></i> Reset to Corporate
            </button>
        </div>
    </div>

    <!-- Active Theme Banner / Status -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-primary text-primary-content flex items-center justify-center text-xl font-black shadow-xs">
                    <i class="fa-solid fa-swatchbook"></i>
                </div>
                <div>
                    <div class="text-xs uppercase font-bold opacity-60">Currently Active System Theme</div>
                    <div class="text-xl font-black flex items-center gap-2 mt-0.5">
                        <span id="activeThemeDisplay" class="capitalize">corporate</span>
                        <span class="badge badge-success badge-sm font-bold gap-1 text-[10px]">
                            <i class="fa-solid fa-circle text-[7px]"></i> Live
                        </span>
                    </div>
                </div>
            </div>
            <div class="text-xs opacity-70">
                Click any palette below to instantly apply and save it across all screens and user sessions.
            </div>
        </div>
    </div>

    <!-- 1. Featured Custom Theme Extracted from UI Screenshot -->
    <div class="space-y-3">
        <div class="flex items-center gap-2">
            <i class="fa-solid fa-wand-magic-sparkles text-xs text-primary"></i>
            <h2 class="text-sm font-bold tracking-wide uppercase opacity-75">Custom Design Theme (from UI Screenshot)</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            
            <!-- BakeryFlow Artisan -->
            <div class="theme-card card border-2 border-base-300 hover:border-primary cursor-pointer transition-all hover:scale-[1.01] rounded-2xl overflow-hidden shadow-xs" onclick="setErpTheme('bakeryflow')" data-theme-name="bakeryflow">
                <div data-theme="bakeryflow" class="p-5 space-y-3 bg-base-100 text-base-content">
                    <div class="flex justify-between items-center">
                        <div>
                            <span class="font-black text-sm">BakeryFlow Artisan</span>
                            <div class="text-[10px] opacity-70">Warm Apricot + Charcoal Industrial Ops</div>
                        </div>
                        <span class="badge badge-primary badge-xs font-black uppercase text-[9px] px-2 py-0.5">UI Design Match</span>
                    </div>
                    <div class="grid grid-cols-4 gap-1.5">
                        <div class="h-7 rounded-lg bg-primary flex items-center justify-center text-[10px] text-primary-content font-black shadow-xs">Peach</div>
                        <div class="h-7 rounded-lg bg-neutral flex items-center justify-center text-[10px] text-neutral-content font-bold shadow-xs">Black</div>
                        <div class="h-7 rounded-lg bg-base-200 border border-base-300 flex items-center justify-center text-[10px] text-base-content font-bold">Canvas</div>
