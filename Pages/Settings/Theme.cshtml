@section Scripts {
<script>
    function setErpTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('erp_theme', theme);
        updateActiveThemeUI(theme);
    }

    function updateActiveThemeUI(theme) {
        document.getElementById('activeThemeDisplay').innerText = theme;
        document.querySelectorAll('.theme-card').forEach(card => {
            if (card.getAttribute('data-theme-name') === theme) {
                card.classList.add('border-primary', 'ring-2', 'ring-primary', 'shadow-md');
                card.classList.remove('border-base-300');
            } else {
                card.classList.remove('border-primary', 'ring-2', 'ring-primary', 'shadow-md');
                card.classList.add('border-base-300');
            }
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const currentTheme = localStorage.getItem('erp_theme') || 'corporate';
        updateActiveThemeUI(currentTheme);
    });
</script>
}
