@page
@model Manufacture.Pages.Sales.Customers.CreateModel
@{
    ViewData["Title"] = "Register Client or Vendor";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-slate-400 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:text-slate-600">Home</a>
                <span>&gt;</span>
                <a asp-page="/Sales/Customers/Index" class="hover:text-slate-600">Clients & Vendors</a>
                <span>&gt;</span>
                <span class="text-slate-700">Register Account</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-store text-stone-900"></i> Register Client / Vendor Account
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">
                Register supermarkets, external bread depots, or corporate standing pre-order accounts
            </p>
        </div>
        <div>
            <a asp-page="/Sales/Customers/Index" class="text-xs text-slate-500 hover:text-slate-900 font-semibold flex items-center gap-1.5">
                <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to Clients
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        
        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            <div class="erp-card p-6 space-y-4">
                <div class="flex items-center gap-2 font-bold text-slate-900 text-sm border-b border-slate-100 pb-3">
                    <div class="w-6 h-6 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">
                        <i class="fa-regular fa-building"></i>
                    </div>
                    <span>Account Profile & Credit Category</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="erp-label">Account / Business Name <span class="text-rose-500">*</span></label>
                        <input type="text" asp-for="CustomerInput.Name" class="erp-input" placeholder="e.g. Grand Square Supermarkets Ltd" required />
                    </div>

                    <div>
                        <label class="erp-label">Member / Customer Code <span class="text-rose-500">*</span></label>
                        <input type="text" asp-for="CustomerInput.MemberCode" class="erp-input font-mono uppercase" placeholder="e.g. SUP-501" required />
                    </div>

                    <div>
                        <label class="erp-label">Customer Category</label>
                        <select asp-for="CustomerInput.Category" class="erp-select">
                            <option value="Supermarket">Supermarket Chain</option>
                            <option value="ExternalVendor">External Vendor (Wholesaler)</option>
                            <option value="WalkIn">Walk-in Retail</option>
                            <option value="SalesRep">Internal Sales Rep</option>
                        </select>
                    </div>

                    <div>
                        <label class="erp-label">Phone Number <span class="text-rose-500">*</span></label>
                        <input type="tel" asp-for="CustomerInput.PhoneNumber" class="erp-input" placeholder="+234 80..." required />
                    </div>

                    <div>
                        <label class="erp-label">Initial Outstanding Balance (₦)</label>
                        <input type="number" step="100" min="0" asp-for="CustomerInput.OutstandingBalance" class="erp-input font-mono" value="0" />
                    </div>

                    <div class="sm:col-span-2">
                        <label class="erp-label">Delivery Address / Shop Location</label>
                        <textarea asp-for="CustomerInput.Address" class="erp-textarea" rows="2" placeholder="Street, landmark, LGA, State"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Sticky Section (~30% width, 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            <div class="erp-card p-6 space-y-4">
                <div class="font-bold text-slate-900 text-sm">Actions</div>
                <p class="text-xs text-slate-500 leading-relaxed">
                    Client account will immediately be available for POS orders, pre-order deliveries, and credit management.
                </p>

                <button type="submit" class="btn-obsidian w-full py-2.5">
                    <i class="fa-solid fa-check text-xs"></i> Register Client Profile
                </button>

                <div class="text-center pt-1">
                    <a asp-page="/Sales/Customers/Index" class="text-xs text-slate-500 hover:text-slate-900 font-medium">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>
