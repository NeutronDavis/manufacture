@page
@model Manufacture.Pages.Sales.Terminals.IndexModel
@{
    ViewData["Title"] = "POS Terminals & Account Mapping";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Sales/Orders/Index" class="hover:underline">Sales & POS</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">POS Terminals</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-desktop text-primary"></i> POS Terminals & Multi-Account Mapping
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Dedicated checkout terminal registers mapped to specific Cash Drawer, Bank Transfer, and POS Machine accounts.
            </p>
        </div>
        <div>
            <a asp-page="/Sales/Orders/Create" class="btn btn-sm btn-neutral rounded-xl gap-2 font-bold px-4 shadow-xs text-xs">
                <i class="fa-solid fa-cash-register text-xs"></i> Open POS Checkout
            </a>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="relative w-full sm:w-96">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-xs opacity-50"></i>
                <input type="text" 
                       id="terminalSearchInput" 
                       oninput="filterTerminals()" 
                       placeholder="Search by terminal name, code, rep, or bank account..." 
                       class="input input-bordered input-sm w-full pl-9 bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-medium" />
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <span id="terminalCountBadge" class="badge badge-neutral badge-xs font-mono font-bold">
                    @Model.Terminals.Count Terminals
                </span>
            </div>
        </div>
    </div>

    <!-- Grid of Terminal Cards -->
    <div id="terminalsGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var term in Model.Terminals)
        {
            var repName = term.AssignedUserName ?? "Unassigned";

            <div class="card bg-base-100 border border-base-300 shadow-xs hover:shadow-md hover:border-primary transition-all duration-200 rounded-2xl flex flex-col justify-between terminal-card"
                 data-code="@term.TerminalCode.ToLower()"
                 data-name="@term.TerminalName.ToLower()"
                 data-rep="@repName.ToLower()"
                 data-cash="@term.CashAccountName.ToLower()"
                 data-transfer="@term.TransferAccountName.ToLower()"
                 data-pos="@term.PosBankAccountName.ToLower()">
                
                <div class="card-body p-6 space-y-4">
                    <!-- Top Header: Code, Name, Status -->
                    <div class="flex justify-between items-start gap-2">
                        <div>
                            <span class="badge badge-neutral badge-xs font-mono font-bold">@term.TerminalCode</span>
                            <h2 class="text-base font-black text-base-content tracking-tight mt-1">@term.TerminalName</h2>
                        </div>
                        <span class="badge badge-success badge-xs font-bold gap-1 shrink-0">
                            <i class="fa-solid fa-circle text-[6px]"></i> Active
                        </span>
                    </div>

                    <!-- Assigned Rep -->
                    <div class="p-3 bg-base-200 border border-base-300 rounded-xl flex items-center justify-between text-xs">
                        <span class="opacity-60 flex items-center gap-1.5">
                            <i class="fa-solid fa-user-check text-primary"></i> Assigned Sales Rep:
                        </span>
                        <span class="font-bold text-base-content">
                            @(term.AssignedUserName ?? "Unassigned")
                        </span>
                    </div>

                    <!-- Dedicated 3-Channel Account Mapping -->
                    <div class="space-y-2 text-xs">
                        <div class="text-[10px] font-bold uppercase tracking-wider opacity-60">
                            Mapped Financial Channels
                        </div>
                        
                        <!-- 1. Cash Drawer -->
                        <div class="p-2.5 rounded-xl border border-success/20 bg-success/5 flex items-center gap-2.5">
                            <div class="w-6 h-6 rounded-lg bg-success/20 text-success flex items-center justify-center text-xs shrink-0">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>
                            <div class="truncate">
                                <div class="font-bold text-success text-xs">Cash Drawer Ledger</div>
                                <div class="font-mono text-[11px] opacity-80 truncate">@term.CashAccountName</div>
                            </div>
                        </div>

                        <!-- 2. Bank Transfer -->
                        <div class="p-2.5 rounded-xl border border-info/20 bg-info/5 flex items-center gap-2.5">
                            <div class="w-6 h-6 rounded-lg bg-info/20 text-info flex items-center justify-center text-xs shrink-0">
                                <i class="fa-solid fa-building-columns"></i>
                            </div>
                            <div class="truncate">
                                <div class="font-bold text-info text-xs">Direct Bank Transfer</div>
                                <div class="font-mono text-[11px] opacity-80 truncate">@term.TransferAccountName</div>
                            </div>
                        </div>

                        <!-- 3. POS Machine Bank -->
                        <div class="p-2.5 rounded-xl border border-secondary/20 bg-secondary/5 flex items-center gap-2.5">
                            <div class="w-6 h-6 rounded-lg bg-secondary/20 text-secondary flex items-center justify-center text-xs shrink-0">
                                <i class="fa-solid fa-credit-card"></i>
                            </div>
                            <div class="truncate">
                                <div class="font-bold text-secondary text-xs">POS Terminal Bank Account</div>
                                <div class="font-mono text-[11px] opacity-80 truncate">@term.PosBankAccountName</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Action Buttons -->
                <div class="p-4 border-t border-base-200 bg-base-100 flex justify-between items-center rounded-b-2xl">
                    <a asp-page="/Sales/Terminals/Assign" asp-route-id="@term.Id" class="btn btn-xs btn-outline border-base-300 rounded-lg gap-1.5 text-xs font-semibold hover:border-primary">
                        <i class="fa-solid fa-user-gear text-[10px]"></i> Reassign Rep
                    </a>
                    <a asp-page="/Sales/Orders/Create" class="btn btn-xs btn-neutral rounded-lg gap-1.5 text-xs font-bold shadow-xs">
                        <i class="fa-solid fa-cash-register text-[10px]"></i> Open POS &rarr;
                    </a>
                </div>

            </div>
        }
    </div>

    <!-- No Results Alert -->
    <div id="noTerminalsAlert" class="alert alert-info shadow-xs rounded-2xl text-xs py-4 hidden flex items-center gap-3">
        <i class="fa-solid fa-circle-info text-base"></i>
        <span>No POS terminals matched your search query. Try another terminal name or operator.</span>
    </div>
</div>

@section Scripts {
<script>
    function filterTerminals() {
        const query = document.getElementById('terminalSearchInput').value.toLowerCase().trim();
        const cards = document.querySelectorAll('.terminal-card');
        const countBadge = document.getElementById('terminalCountBadge');
        const noResults = document.getElementById('noTerminalsAlert');

        let visibleCount = 0;

        cards.forEach(card => {
            const code = card.getAttribute('data-code') || '';
            const name = card.getAttribute('data-name') || '';
            const rep = card.getAttribute('data-rep') || '';
            const cash = card.getAttribute('data-cash') || '';
            const transfer = card.getAttribute('data-transfer') || '';
            const pos = card.getAttribute('data-pos') || '';

            if (code.includes(query) || name.includes(query) || rep.includes(query) || cash.includes(query) || transfer.includes(query) || pos.includes(query)) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        countBadge.innerText = `${visibleCount} Terminal${visibleCount !== 1 ? 's' : ''}`;

        if (visibleCount === 0) {
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
        }
    }
</script>
}
