@page "{id:int?}"
@model Manufacture.Pages.Sales.Terminals.EditModel
@{
    ViewData["Title"] = $"Manage POS Terminal - {Model.Terminal.TerminalCode}";
}

<div class="space-y-6 w-full pb-12">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="breadcrumbs text-sm mb-1 text-base-content/70">
                <ul>
                    <li><a asp-page="/Sales/Index" class="hover:text-primary">Sales & POS</a></li>
                    <li><a asp-page="/Sales/Terminals/Index" class="hover:text-primary">POS Terminals</a></li>
                    <li class="font-semibold text-base-content">Manage @Model.Terminal.TerminalCode</li>
                </ul>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <h1 class="text-3xl font-extrabold tracking-tight text-base-content flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Manage POS Terminal
                </h1>
                <span class="badge badge-neutral font-mono font-bold text-xs">@Model.Terminal.TerminalCode</span>
                @if (Model.Terminal.IsActive)
                {
                    <span class="badge badge-success badge-sm font-bold gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-success-content animate-pulse"></span> Active
                    </span>
                }
                else
                {
                    <span class="badge badge-error badge-sm font-bold gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                        Offline / Inactive
                    </span>
                }
            </div>
            <p class="text-sm text-base-content/70 mt-0.5">
                Edit operational status, reassign terminal operators, and update mapped cash and bank routing accounts for <strong class="text-base-content">@Model.Terminal.TerminalName</strong>.
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-page="/Sales/Terminals/Index" class="btn btn-sm btn-outline gap-1.5 font-semibold">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
                Back to Terminals
            </a>
            @if (Model.Terminal.IsActive)
            {
                <a asp-page="/Sales/Orders/Create" class="btn btn-sm btn-neutral gap-1.5 font-bold shadow-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    Open POS
                </a>
            }
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Model.SuccessMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>@Model.ErrorMessage</span>
            </div>
            <button class="btn btn-ghost btn-xs" onclick="this.parentElement.remove()">✕</button>
        </div>
    }

    <!-- 2-Column Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Terminal.Id" />

        <!-- Left Column: Primary Edit Fields (8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            
            <!-- Terminal Specs & Status Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
                <div class="card-body p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-sm font-bold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                            </div>
                            <span>Terminal Specifications & Operator Assignment</span>
                        </div>
                        <span class="badge badge-neutral badge-sm font-mono font-bold">ID #@Model.Terminal.Id</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Terminal Code *</span></label>
                            <input type="text" asp-for="Terminal.TerminalCode" class="input input-bordered input-sm w-full font-mono font-bold" required />
                            <span class="text-[11px] text-base-content/50 mt-1">Unique machine hardware identifier.</span>
                        </div>

                        <div class="form-control">
                            <label class="label"><span class="label-text font-semibold text-xs">Operational Status *</span></label>
                            <select asp-for="Terminal.IsActive" class="select select-bordered select-sm w-full font-bold">
                                <option value="true">Active & Ready</option>
                                <option value="false">Inactive / Offline (Maintenance)</option>
                            </select>
                            <span class="text-[11px] text-base-content/50 mt-1">Control whether this terminal can process sales transactions.</span>
                        </div>
                    </div>

                    <div class="form-control">
                        <label class="label"><span class="label-text font-semibold text-xs">Terminal Description / Display Name *</span></label>
                        <input type="text" asp-for="Terminal.TerminalName" class="input input-bordered input-sm w-full font-medium" required />
                        <span class="text-[11px] text-base-content/50 mt-1">Descriptive title displayed in POS checkout registers and loading slips.</span>
                    </div>

                    <div class="form-control">
                        <label class="label"><span class="label-text font-semibold text-xs">Assigned Sales Rep / Cashier</span></label>
                        <select asp-for="Terminal.AssignedUserId" class="select select-bordered select-sm w-full">
                            <option value="">-- Unassigned (Shared Register / Floating Till) --</option>
                            @foreach (var user in Model.EligibleUsers)
                            {
                                <option value="@user.Id">@user.Name (@user.Role) - @user.PhoneNumber</option>
                            }
                        </select>
                        <span class="text-[11px] text-base-content/50 mt-1">Responsible user authorized to log in and sign off daily drawer balances.</span>
                    </div>
                </div>
            </div>

            <!-- Multi-Account Banking Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
                <div class="card-body p-6 space-y-4">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-8 h-8 rounded-lg bg-success/10 text-success flex items-center justify-center text-sm font-bold">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            </div>
                            <span>Edit Financial Account & Bank Routing</span>
                        </div>
                        <span class="badge badge-success badge-sm font-semibold">Tender Routing</span>
                    </div>

                    <!-- 1. Cash Drawer Account -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-semibold text-xs text-success flex items-center gap-2">
                                <span class="w-6 h-6 rounded-md bg-success/15 text-success flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                                    </svg>
                                </span>
                                <span>1. Cash Drawer Ledger Name *</span>
                            </span>
                        </label>
                        <input type="text" asp-for="Terminal.CashAccountName" class="input input-bordered input-sm w-full font-mono font-medium" required />
                        <span class="text-[11px] text-base-content/50 mt-1">Internal till ledger tracking physical banknotes received in this drawer.</span>
                    </div>

                    <!-- 2. Bank Direct Transfer Account -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-semibold text-xs text-info flex items-center gap-2">
                                <span class="w-6 h-6 rounded-md bg-info/15 text-info flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" />
                                    </svg>
                                </span>
                                <span>2. Bank Direct Transfer Account *</span>
                            </span>
                        </label>
                        <input type="text" asp-for="Terminal.TransferAccountName" class="input input-bordered input-sm w-full font-mono font-medium" required />
                        <span class="text-[11px] text-base-content/50 mt-1">Corporate bank account credited when customers pay via bank transfer on this terminal.</span>
                    </div>

                    <!-- 3. POS Machine Bank Account -->
                    <div class="form-control">
                        <label class="label">
                            <span class="label-text font-semibold text-xs text-secondary flex items-center gap-2">
                                <span class="w-6 h-6 rounded-md bg-secondary/15 text-secondary flex items-center justify-center shrink-0">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                                    </svg>
                                </span>
                                <span>3. POS Machine Bank / Terminal ID *</span>
                            </span>
                        </label>
                        <input type="text" asp-for="Terminal.PosBankAccountName" class="input input-bordered input-sm w-full font-mono font-medium" required />
                        <span class="text-[11px] text-base-content/50 mt-1">Fintech merchant ID or physical card sweep account (Moniepoint, OPay, PalmPay).</span>
                    </div>

                    <div class="flex items-center justify-end gap-3 pt-4 border-t border-base-200">
                        <a asp-page="/Sales/Terminals/Index" class="btn btn-ghost btn-sm">Discard</a>
                        <button type="submit" class="btn btn-primary btn-sm px-6">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            Save Terminal Settings
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Status Card & Shortcuts (4 Cols) -->
        <div class="lg:col-span-4 space-y-6">
            
            <!-- Quick Status Overview Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-4">
                <h3 class="font-bold text-sm text-base-content flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    Live Operational State
                </h3>

                <div class="p-3.5 rounded-xl border @(Model.Terminal.IsActive ? "bg-success/10 border-success/30 text-success" : "bg-error/10 border-error/30 text-error") flex items-center justify-between">
                    <div>
                        <div class="text-[10px] uppercase font-bold opacity-75">Current State</div>
                        <div class="text-sm font-bold flex items-center gap-1.5 mt-0.5">
                            @if (Model.Terminal.IsActive)
                            {
                                <span class="w-2 h-2 rounded-full bg-success animate-pulse"></span>
                                <span>Online &amp; Active</span>
                            }
                            else
                            {
                                <span class="w-2 h-2 rounded-full bg-error"></span>
                                <span>Offline / Disabled</span>
                            }
                        </div>
                    </div>
                    <span class="badge @(Model.Terminal.IsActive ? "badge-success" : "badge-error") badge-sm font-bold">
                        @(Model.Terminal.IsActive ? "Active" : "Locked")
                    </span>
                </div>

                <div class="text-xs text-base-content/70 space-y-2 pt-1">
                    <div class="flex justify-between">
                        <span class="opacity-60">Assigned Operator:</span>
                        <strong class="text-base-content">@(Model.Terminal.AssignedUserName ?? "Unassigned")</strong>
                    </div>
                    <div class="flex justify-between">
                        <span class="opacity-60">Terminal ID:</span>
                        <strong class="font-mono text-base-content">#@Model.Terminal.Id</strong>
                    </div>
                </div>

                <!-- 1-Click Toggle Button -->
                <div class="pt-2">
                    <button type="submit" 
                            asp-page-handler="ToggleStatus" 
                            asp-route-id="@Model.Terminal.Id" 
                            class="btn btn-sm @(Model.Terminal.IsActive ? "btn-outline btn-error" : "btn-outline btn-success") w-full text-xs font-semibold gap-1.5">
                        @(Model.Terminal.IsActive ? "Set Terminal Offline" : "Activate Terminal")
                    </button>
                </div>
            </div>

            <!-- Quick Navigation Card -->
            <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl p-5 space-y-3">
                <h3 class="font-bold text-sm text-base-content">Navigation</h3>
                <div class="space-y-2">
                    <a asp-page="/Sales/Terminals/Create" class="btn btn-outline btn-sm w-full justify-start text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        Register Another Terminal
                    </a>
                    <a asp-page="/Sales/Terminals/Index" class="btn btn-outline btn-sm w-full justify-start text-xs font-semibold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
                        All Registered Terminals
                    </a>
                </div>
            </div>

        </div>
    </form>
</div>
