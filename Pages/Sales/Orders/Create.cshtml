@page
@model Manufacture.Pages.Sales.Orders.CreateModel
@{
    ViewData["Title"] = "Point of Sale & Order Entry";
    bool isPreOrder = Model.OrderInput.OrderType == "PreOrder" || Model.OrderInput.OrderType == "Advance Pre-Order (Supermarket)";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Sales/Orders/Index" class="hover:underline">Sales & POS</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">@(isPreOrder ? "Book Pre-Order" : "New POS Sale")</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-cash-register text-primary"></i> Point of Sale & Order Entry
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Instant counter checkout or advance scheduled standing pre-orders for supermarket vendors.
            </p>
        </div>
        <div>
            <a asp-page="/Sales/Orders/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-semibold">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Orders
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" id="orderForm" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        
        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            
            <!-- Card 1: Channel & Customer Account -->
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
                <div class="card-body p-6 space-y-5">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-7 h-7 rounded-lg bg-primary text-primary-content flex items-center justify-center text-xs font-bold shadow-xs">
                                <i class="fa-solid fa-store"></i>
                            </div>
                            <span>Channel & Customer Account</span>
                        </div>
                        <span class="badge badge-neutral badge-xs font-bold uppercase tracking-wider">Account Routing</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Order Flow Type <span class="text-error">*</span>
                                </span>
                            </label>
                            <select asp-for="OrderInput.OrderType" id="orderTypeSelect" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-semibold focus:bg-base-100 focus:border-primary">
                                <option value="Direct Walk-In (Counter Sale)">Direct Walk-In (Counter Sale)</option>
                                <option value="Advance Pre-Order (Supermarket)">Advance Pre-Order (Supermarket)</option>
                                <option value="Phone Booking">Phone Booking / Scheduled Delivery</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Customer / Account <span class="text-error">*</span>
                                </span>
                            </label>
                            <select asp-for="OrderInput.CustomerId" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-medium focus:bg-base-100 focus:border-primary" required>
                                @foreach (var c in Model.Customers)
                                {
                                    <option value="@c.Id">@c.Name (@c.Category) - Code: @c.MemberCode</option>
                                }
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">POS Register Terminal</span>
                            </label>
                            <select asp-for="OrderInput.PosTerminalCode" class="select select-bordered select-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary">
                                @foreach (var t in Model.Terminals)
                                {
                                    <option value="@t.TerminalCode">@t.TerminalCode - @t.TerminalName</option>
                                }
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Scheduled Dispatch Date</span>
                            </label>
                            <input type="date" asp-for="OrderInput.TargetDeliveryDate" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Remarks / Dispatch Loading Note</span>
                            </label>
                            <input type="text" asp-for="OrderInput.Notes" class="input input-bordered input-sm w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="e.g. Double nylon packaging / morning gate delivery" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 2: Interactive Product Basket & Item Selector -->
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
                <div class="card-body p-6 space-y-5">
                    
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-7 h-7 rounded-lg bg-primary text-primary-content flex items-center justify-center text-xs font-bold shadow-xs">
                                <i class="fa-solid fa-bread-slice"></i>
                            </div>
                            <span>Product Basket & Quantities</span>
                        </div>
                        <span class="badge badge-neutral badge-xs font-mono font-bold" id="itemCountBadge">0 Loaf Types</span>
                    </div>

                    <!-- Product Picker Bar (Add to Basket Tool) -->
                    <div class="p-4 rounded-2xl bg-base-200 border border-base-300 space-y-3">
                        <div class="text-xs font-bold text-base-content uppercase tracking-wider opacity-70">
                            Select Bread Product to Add to Order:
                        </div>
                        <div class="flex flex-col sm:flex-row items-center gap-3">
                            <div class="flex-1 w-full">
                                <select id="productPickerSelect" class="select select-bordered select-sm w-full bg-base-100 border-base-300 rounded-xl text-xs font-semibold focus:border-primary">
                                    <option value="">-- Choose Bread Product --</option>
                                    @foreach (var r in Model.Recipes)
                                    {
                                        <option value="@r.Id" data-name="@r.Name" data-code="@r.Code" data-price="@r.SellingPrice">
                                            @r.Name (@r.Code) — ₦@r.SellingPrice.ToString("N0")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="w-full sm:w-28 flex items-center gap-1.5">
                                <span class="text-xs font-bold opacity-60">Qty:</span>
                                <input type="number" id="productPickerQty" value="20" min="1" step="1" class="input input-bordered input-sm w-full font-mono font-bold text-center bg-base-100 border-base-300 rounded-xl text-xs focus:border-primary" />
                            </div>

                            <button type="button" onclick="addProductToBasket()" class="btn btn-sm btn-neutral rounded-xl font-bold px-4 text-xs shadow-xs gap-1.5 w-full sm:w-auto">
                                <i class="fa-solid fa-plus text-xs"></i> Add to Basket
                            </button>
                        </div>
                    </div>

                    <!-- Basket Table -->
                    <div class="overflow-x-auto">
                        <table class="table table-sm w-full text-xs">
                            <thead>
                                <tr class="opacity-60 uppercase text-[10px] tracking-wider border-b border-base-200 bg-base-200/50">
                                    <th class="py-3 pl-3">Product Name</th>
                                    <th>Unit Price</th>
                                    <th class="text-center w-36">Order Quantity</th>
                                    <th class="text-right">Line Total (₦)</th>
                                    <th class="text-center w-16 pr-3">Action</th>
                                </tr>
                            </thead>
                            <tbody id="basketTableBody" class="divide-y divide-base-200">
                                <!-- Dynamic basket rows will be rendered here by JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Empty Basket Prompt -->
                    <div id="emptyBasketAlert" class="alert alert-info shadow-xs rounded-2xl text-xs py-4 flex items-center gap-3">
                        <i class="fa-solid fa-circle-info text-base"></i>
                        <span><strong>No loaves in basket yet.</strong> Select a bread product above and click <strong>"+ Add to Basket"</strong> to build the order ticket.</span>
                    </div>

                </div>
            </div>

            <!-- Card 3: Payment Channel & Settlement -->
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
                <div class="card-body p-6 space-y-5">
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-7 h-7 rounded-lg bg-primary text-primary-content flex items-center justify-center text-xs font-bold shadow-xs">
                                <i class="fa-solid fa-credit-card"></i>
                            </div>
                            <span>Payment Channel & Settlement</span>
                        </div>
                        <span class="badge badge-success badge-xs font-bold">Ledger Split</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Payment Method <span class="text-error">*</span>
                                </span>
                            </label>
                            <select asp-for="OrderInput.PaymentMethod" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-semibold focus:bg-base-100 focus:border-primary">
                                <option value="Cash">Cash Account (Till Drawer)</option>
                                <option value="BankTransfer">Bank Transfer (FirstBank Corporate)</option>
                                <option value="PosBank">POS Terminal (Moniepoint Card Swipe)</option>
                                <option value="CreditOwing">Customer Credit Ledger (7 Days Net)</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Discount Allowed (₦)</span>
                            </label>
                            <input type="number" step="100" min="0" asp-for="OrderInput.Discount" id="discountInput" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-bold" value="0" oninput="calculateTotal()" />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Amount Tendered / Paid (₦) <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="number" step="100" min="0" asp-for="OrderInput.AmountPaid" id="amountPaidInput" class="input input-bordered input-sm w-full font-mono font-bold bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary text-success" value="0" oninput="calculateTotal()" required />
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Right Sticky Summary & Dispatch Ticket Card (4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            
            <!-- Order Settlement Summary Card -->
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <h2 class="font-black text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-receipt text-primary"></i> Order Settlement Summary
                    </h2>
                    <span class="badge badge-neutral badge-xs font-bold uppercase">Dispatch Ticket</span>
                </div>

                <!-- 4 Live Calculation Metrics -->
                <div class="space-y-2.5 text-xs font-mono">
                    <div class="p-3 rounded-xl bg-base-200 border border-base-300 flex items-center justify-between">
                        <span class="font-sans opacity-70">Subtotal:</span>
                        <span class="font-bold text-base-content" id="displaySubtotal">₦0.00</span>
                    </div>

                    <div class="p-3 rounded-xl bg-base-200 border border-base-300 flex items-center justify-between">
                        <span class="font-sans opacity-70">Discount:</span>
                        <span class="font-bold text-error" id="displayDiscount">-₦0.00</span>
                    </div>

                    <div class="p-4 rounded-xl bg-primary text-primary-content flex items-center justify-between font-black text-sm shadow-xs">
                        <span class="font-sans text-xs uppercase tracking-wider">Net Order Total:</span>
                        <span class="text-lg font-mono" id="displayNetTotal">₦0.00</span>
                    </div>

                    <div class="p-3 rounded-xl bg-base-200 border border-base-300 flex items-center justify-between">
                        <span class="font-sans opacity-70">Balance Due / Credit:</span>
                        <span class="font-bold text-error font-mono" id="displayBalanceDue">₦0.00</span>
                    </div>
                </div>

                <p class="text-[11px] opacity-70 leading-relaxed">
                    Completing this order will generate a printable 80mm thermal loading slip for vehicle dispatch verification.
                </p>

                <div class="space-y-2 pt-2 border-t border-base-200">
                    <button type="submit" class="btn btn-neutral w-full rounded-xl font-bold py-2.5 text-xs shadow-xs gap-2">
                        <i class="fa-solid fa-print text-xs"></i> Process Sale & Generate Slip
                    </button>

                    <a asp-page="/Sales/Orders/Index" class="btn btn-ghost w-full rounded-xl text-xs font-semibold">
                        Cancel
                    </a>
                </div>
            </div>

            <!-- Print-to-Load Compliance Card -->
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-5 text-xs space-y-2">
                <div class="font-bold text-base-content flex items-center gap-2">
                    <i class="fa-solid fa-shield-check text-success"></i> Print-to-Load Rule
                </div>
                <p class="text-[11px] opacity-70 leading-relaxed">
                    Orders can only be loaded onto delivery vehicles once the physical loading pass is printed and stamped at the dispatch gate.
                </p>
            </div>

        </div>
    </form>
</div>

@section Scripts {
<script>
    // In-memory basket list
    let basket = [];

    function addProductToBasket() {
        const select = document.getElementById('productPickerSelect');
        const qtyInput = document.getElementById('productPickerQty');
        
        const selectedOpt = select.options[select.selectedIndex];
        const recipeId = parseInt(select.value);
        const qty = parseInt(qtyInput.value) || 20;

        if (!recipeId) {
            alert('Please select a bread product from the dropdown.');
            return;
        }

        if (qty <= 0) {
            alert('Please specify a quantity greater than 0.');
            return;
        }

        const name = selectedOpt.getAttribute('data-name');
        const code = selectedOpt.getAttribute('data-code');
        const price = parseFloat(selectedOpt.getAttribute('data-price')) || 0;

        // Check if item already in basket
        const existing = basket.find(item => item.recipeId === recipeId);
        if (existing) {
            existing.quantity += qty;
        } else {
            basket.push({
                recipeId: recipeId,
                name: name,
                code: code,
                unitPrice: price,
                quantity: qty
            });
        }

        // Reset picker
        select.value = "";
        qtyInput.value = "20";

        renderBasket();
    }

    function removeBasketItem(index) {
        basket.splice(index, 1);
        renderBasket();
    }

    function stepQuantity(index, delta) {
        if (basket[index]) {
            basket[index].quantity += delta;
            if (basket[index].quantity <= 0) {
                basket.splice(index, 1);
            }
            renderBasket();
        }
    }

    function updateItemQuantity(index, newQty) {
        const val = parseInt(newQty) || 0;
        if (val <= 0) {
            basket.splice(index, 1);
        } else {
            basket[index].quantity = val;
        }
        renderBasket();
    }

    function renderBasket() {
        const tbody = document.getElementById('basketTableBody');
        const emptyAlert = document.getElementById('emptyBasketAlert');
        const itemCountBadge = document.getElementById('itemCountBadge');

        tbody.innerHTML = '';

        if (basket.length === 0) {
            emptyAlert.classList.remove('hidden');
            itemCountBadge.innerText = '0 Loaf Types';
        } else {
            emptyAlert.classList.add('hidden');
            itemCountBadge.innerText = `${basket.length} Loaf Type${basket.length > 1 ? 's' : ''}`;

            basket.forEach((item, i) => {
                const lineTotal = item.unitPrice * item.quantity;
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-base-200/60 transition-colors';
                tr.innerHTML = `
                    <td class="py-2.5 pl-3">
                        <input type="hidden" name="OrderInput.Items[${i}].RecipeId" value="${item.recipeId}" />
                        <input type="hidden" name="OrderInput.Items[${i}].ProductName" value="${item.name}" />
                        <input type="hidden" name="OrderInput.Items[${i}].UnitPrice" value="${item.unitPrice}" />
                        <div class="font-bold text-xs text-base-content">${item.name}</div>
                        <span class="badge badge-neutral badge-xs font-mono font-bold">${item.code}</span>
                    </td>
                    <td class="font-mono text-base-content font-bold py-2.5">
                        ₦${item.unitPrice.toLocaleString('en-US')}
                    </td>
                    <td class="py-2.5 text-center">
                        <div class="join inline-flex shadow-2xs">
                            <button type="button" class="btn btn-xs btn-neutral join-item" onclick="stepQuantity(${i}, -5)">-5</button>
                            <button type="button" class="btn btn-xs btn-neutral join-item" onclick="stepQuantity(${i}, -1)">-</button>
                            <input type="number" min="1" 
                                   name="OrderInput.Items[${i}].Quantity" 
                                   value="${item.quantity}" 
                                   class="input input-xs input-bordered w-16 text-center font-mono font-black text-xs join-item bg-base-100 border-base-300" 
                                   onchange="updateItemQuantity(${i}, this.value)" />
                            <button type="button" class="btn btn-xs btn-neutral join-item" onclick="stepQuantity(${i}, 1)">+</button>
                            <button type="button" class="btn btn-xs btn-neutral join-item" onclick="stepQuantity(${i}, 5)">+5</button>
                        </div>
                    </td>
                    <td class="text-right font-mono font-black text-base-content py-2.5">
                        ₦${lineTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
                    </td>
                    <td class="text-center pr-3 py-2.5">
                        <button type="button" onclick="removeBasketItem(${i})" class="btn btn-xs btn-ghost text-error" title="Remove item">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        calculateTotal();
    }

    function calculateTotal() {
        let subtotal = 0;
        basket.forEach(item => {
            subtotal += (item.unitPrice * item.quantity);
        });

        const discount = parseFloat(document.getElementById('discountInput').value) || 0;
        const netTotal = Math.max(0, subtotal - discount);
        const amountPaidInput = document.getElementById('amountPaidInput');
        
        // If amount paid is 0 or unedited, auto-sync to netTotal for cash/POS convenience
        if (parseFloat(amountPaidInput.value) === 0 || amountPaidInput.getAttribute('data-auto') === 'true') {
            amountPaidInput.value = netTotal;
            amountPaidInput.setAttribute('data-auto', 'true');
        }

        const amountPaid = parseFloat(amountPaidInput.value) || 0;
        const balanceDue = Math.max(0, netTotal - amountPaid);

        document.getElementById('displaySubtotal').innerText = '₦' + subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('displayDiscount').innerText = '-₦' + discount.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('displayNetTotal').innerText = '₦' + netTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        document.getElementById('displayBalanceDue').innerText = '₦' + balanceDue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    // Allow Enter key on productPickerQty to add item immediately
    document.addEventListener('DOMContentLoaded', () => {
        const pickerQty = document.getElementById('productPickerQty');
        if (pickerQty) {
            pickerQty.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addProductToBasket();
                }
            });
        }

        // Render initial empty basket
        renderBasket();
    });
</script>
}
