@page "{id:int}"
@model Manufacture.Pages.Sales.Orders.ReceiptModel
@{
    ViewData["Title"] = $"Slip - {Model.Order.OrderNumber}";
}

<!-- No-Print Action Bar -->
<div class="no-print space-y-4 max-w-xl mx-auto mb-6">
    <div class="flex items-center justify-between">
        <a asp-page="/Sales/Orders/Index" class="btn btn-sm btn-ghost gap-1">
            <i class="fa-solid fa-arrow-left"></i> Back to Orders
        </a>
        <div class="flex gap-2">
            <button onclick="window.print()" class="btn btn-sm btn-primary gap-2">
                <i class="fa-solid fa-print"></i> Print Slip (Thermal 80mm)
            </button>
        </div>
    </div>

    <!-- Print-to-Load Compliance Banner -->
    @if (!Model.Order.IsPrintedForLoading)
    {
        <div class="alert alert-warning py-3 text-xs flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-triangle-exclamation text-lg"></i>
                <span><strong>Loading Rule:</strong> Goods cannot be loaded or released until this slip is printed and signed!</span>
            </div>
            <form method="post" asp-page-handler="MarkPrinted" asp-route-id="@Model.Order.Id">
                <button type="submit" class="btn btn-xs btn-neutral">Mark as Printed</button>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-success py-2 text-xs flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-circle-check text-lg"></i>
                <span>Order form printed at @Model.Order.PrintedAt?.ToString("HH:mm - yyyy-MM-dd"). Authorized for loading.</span>
            </div>
        </div>
    }

    <!-- Loader Verification & Dispatch Action -->
    @if (Model.Order.Status != OrderStatus.Dispatched)
    {
        <div class="card bg-base-100 border border-base-300 shadow-xs">
            <div class="card-body p-4">
                <h3 class="font-bold text-xs uppercase tracking-wider text-base-content/60 mb-2">Store Loader Sign-Off & Dispatch</h3>
                <form method="post" asp-page-handler="DispatchOrder" asp-route-id="@Model.Order.Id" class="flex gap-2">
                    <input type="text" name="LoaderName" class="input input-sm input-bordered flex-1" placeholder="Loader's Full Name (e.g. Kelechi Nnamdi)" required />
                    <button type="submit" class="btn btn-sm btn-success text-white gap-1" @(Model.Order.IsPrintedForLoading ? "" : "disabled")>
                        <i class="fa-solid fa-truck-fast"></i> Verify & Dispatch
                    </button>
                </form>
                @if (!Model.Order.IsPrintedForLoading)
                {
                    <span class="text-[11px] text-error">Print slip first before loader can confirm dispatch.</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card bg-base-100 border border-success/30 bg-success/5 shadow-xs p-4 text-xs flex justify-between items-center">
            <div>
                <span class="font-bold text-success"><i class="fa-solid fa-circle-check"></i> Dispatched & Released</span>
                <div class="text-base-content/70">Verified by Loader: <strong>@Model.Order.VerifiedByLoaderName</strong> at @Model.Order.LoadedAt?.ToString("HH:mm - yyyy-MM-dd")</div>
            </div>
            <span class="badge badge-success font-bold">COMPLETED</span>
        </div>
    }
</div>

<!-- 80mm Thermal Receipt / Loading Form Layout -->
<div class="max-w-xs mx-auto bg-white text-black p-5 border border-gray-300 shadow-md font-mono text-xs rounded-sm">
    <!-- Header -->
    <div class="text-center border-b border-dashed border-gray-400 pb-3 mb-3">
        <div class="text-base font-black uppercase tracking-wider">BAKEFLOW BAKERY</div>
        <div class="text-[10px] text-gray-600">Factory: 14 Industrial Avenue, Lagos</div>
        <div class="text-[10px] text-gray-600">Tel: +234 800-BAKERY (225379)</div>
        <div class="mt-2 text-xs font-bold bg-gray-100 py-1 uppercase">
            @(Model.Order.Type == OrderType.PreOrder ? "★ ADVANCE PRE-ORDER SLIP ★" : "★ DISPATCH & LOADING SLIP ★")
        </div>
    </div>

    <!-- Order Info -->
    <div class="space-y-1 text-[11px] border-b border-dashed border-gray-400 pb-2 mb-2">
        <div class="flex justify-between">
            <span class="text-gray-600">SLIP NO:</span>
            <span class="font-bold">@Model.Order.OrderNumber</span>
        </div>
        <div class="flex justify-between">
            <span class="text-gray-600">DATE:</span>
            <span>@Model.Order.OrderDate.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        <div class="flex justify-between">
            <span class="text-gray-600">DELIVERY:</span>
            <span class="font-bold">@Model.Order.TargetDeliveryDate.ToString("yyyy-MM-dd")</span>
        </div>
        <div class="flex justify-between">
            <span class="text-gray-600">POS / REP:</span>
            <span>@Model.Order.PosTerminalCode (@(Model.Order.SalesRepName ?? "Rep"))</span>
        </div>
        <div class="flex justify-between">
            <span class="text-gray-600">CLIENT:</span>
            <span class="font-bold uppercase truncate max-w-[140px]">@Model.Order.CustomerName</span>
        </div>
        <div class="flex justify-between">
            <span class="text-gray-600">CATEGORY:</span>
            <span>@Model.Order.CustomerCategory</span>
        </div>
    </div>

    <!-- Items Table -->
    <div class="border-b border-dashed border-gray-400 pb-2 mb-2">
        <div class="font-bold text-[10px] uppercase flex justify-between border-b border-gray-300 pb-1 mb-1">
            <span>ITEM DESCRIPTION</span>
            <span>QTY x PRICE</span>
            <span class="text-right">TOTAL</span>
        </div>

        @foreach (var item in Model.Order.Items)
        {
            <div class="flex justify-between py-0.5 text-[11px]">
                <div class="truncate max-w-[110px] font-bold">@item.ProductName</div>
                <div>@item.Quantity x @item.UnitPrice.ToString("N0")</div>
                <div class="text-right font-bold">₦@item.TotalPrice.ToString("N0")</div>
            </div>
        }
    </div>

    <!-- Totals & Payment -->
    <div class="space-y-1 text-[11px] border-b border-dashed border-gray-400 pb-2 mb-3">
        <div class="flex justify-between">
            <span>SUBTOTAL:</span>
            <span>₦@Model.Order.SubTotal.ToString("N0")</span>
        </div>
        @if (Model.Order.Discount > 0)
        {
            <div class="flex justify-between text-red-600">
                <span>DISCOUNT:</span>
                <span>-₦@Model.Order.Discount.ToString("N0")</span>
            </div>
        }
        <div class="flex justify-between font-black text-sm border-t border-gray-300 pt-1">
            <span>NET TOTAL:</span>
            <span>₦@Model.Order.TotalAmount.ToString("N0")</span>
        </div>
        <div class="flex justify-between font-bold">
            <span>PAID (@Model.Order.PaymentMethod.ToString().ToUpper()):</span>
            <span>₦@Model.Order.AmountPaid.ToString("N0")</span>
        </div>
        @if (Model.Order.BalanceDue > 0)
        {
            <div class="flex justify-between font-black text-red-600">
                <span>BALANCE OWING:</span>
                <span>₦@Model.Order.BalanceDue.ToString("N0")</span>
            </div>
        }
    </div>

    <!-- Mandatory Verification & Signature Section for Loaders -->
    <div class="border border-gray-400 p-2 text-[10px] space-y-2 bg-gray-50 mb-3">
        <div class="font-bold uppercase text-center border-b border-gray-300 pb-1">
            LOADER VERIFICATION & SIGN-OFF
        </div>
        <div class="text-[9px] text-gray-700 leading-tight">
            RULE: Loaders must physically recount loaves and sign before releasing goods from factory floor.
        </div>
        <div class="pt-2 flex justify-between">
            <span>Records Clerk: ________________</span>
        </div>
        <div class="pt-2 flex justify-between">
            <span>Loader Sign: ___________________</span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Order.VerifiedByLoaderName))
        {
            <div class="text-green-700 font-bold mt-1 text-[9px]">
                ✓ VERIFIED BY: @Model.Order.VerifiedByLoaderName.ToUpper()
            </div>
        }
    </div>

    <!-- Barcode / Footer -->
    <div class="text-center text-[9px] text-gray-500 pt-1">
        <div class="font-mono tracking-widest text-xs font-bold mb-1">|||||||||||||||||||||||||||||||||</div>
        <div>Thank you for your business!</div>
        <div>Quality Freshly Baked Every Day</div>
    </div>
</div>
