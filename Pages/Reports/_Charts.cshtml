@model Manufacture.Pages.Reports.IndexModel
@using Manufacture.Models.DTOs

@{ var lifecycle = Model.Result.Charts.Lifecycle; }

<div class="space-y-6">

    <!-- 1. Grouped lifecycle comparison -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
        <div class="card-body p-5 space-y-3">
            <div class="flex items-start justify-between gap-3 flex-wrap">
                <div>
                    <h2 class="font-bold text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-layer-group text-primary"></i> Lifecycle Reconciliation
                    </h2>
                    <p class="text-[10px] opacity-60 mt-0.5">
                        Requested, loaded, sold, returned and damaged units grouped by @lifecycle.GroupByLabel.
                    </p>
                </div>
                <span class="badge badge-soft badge-xs font-bold">@lifecycle.Categories.Count groups</span>
            </div>

            @if (!string.IsNullOrEmpty(lifecycle.EmptyMessage))
            {
                <div class="alert rounded-xl text-[11px] py-3">
                    <i class="fa-solid fa-circle-info"></i><span>@lifecycle.EmptyMessage</span>
                </div>
            }
            else
            {
                <div class="relative h-72 sm:h-80 w-full">
                    <canvas id="chart-lifecycle" role="img"
                            aria-label="Grouped bar chart comparing requested, loaded, sold, returned and damaged units by @lifecycle.GroupByLabel"></canvas>
                </div>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

        <!-- 2. Revenue vs collections -->
        <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl xl:col-span-2">
            <div class="card-body p-5 space-y-3">
                <div class="flex items-start justify-between gap-3 flex-wrap">
                    <div>
                        <h2 class="font-bold text-sm text-base-content flex items-center gap-2">
                            <i class="fa-solid fa-chart-line text-primary"></i> Revenue vs Collections
                        </h2>
                        <p class="text-[10px] opacity-60 mt-0.5">
                            Expected revenue against what was actually settled, by @(Model.Result.Query.BucketLabel.ToLowerInvariant()).
                        </p>
                    </div>
                    <div class="text-right">
                        <div class="text-[9px] font-bold uppercase opacity-50">Collection rate</div>
                        <div class="font-mono font-black text-sm @(Model.Result.GrandTotals.CollectionRatePercent < 92m ? "text-error" : "text-success")">
                            @Model.Result.GrandTotals.CollectionRatePercent.ToString("0.#")%
                        </div>
                    </div>
                </div>
                <div class="relative h-64 sm:h-72 w-full">
                    <canvas id="chart-revenue" role="img" aria-label="Line chart of expected revenue against cash and transfer collections"></canvas>
                </div>
            </div>
        </div>

        <!-- 3. Product volume distribution -->
        <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
            <div class="card-body p-5 space-y-3">
                <div>
                    <h2 class="font-bold text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-primary"></i> Volume Mix
                    </h2>
                    <p class="text-[10px] opacity-60 mt-0.5">Share of units sold in the selected scope.</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Result.Charts.Volume.EmptyMessage))
                {
                    <div class="alert rounded-xl text-[11px] py-3">
                        <i class="fa-solid fa-circle-info"></i><span>@Model.Result.Charts.Volume.EmptyMessage</span>
                    </div>
                }
                else
                {
                    <div class="relative h-64 w-full">
                        <canvas id="chart-volume" role="img" aria-label="Doughnut chart of sales volume by product"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 4. Rep performance ranking -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
        <div class="card-body p-5 space-y-3">
            <div class="flex items-start justify-between gap-3 flex-wrap">
                <div>
                    <h2 class="font-bold text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-ranking-star text-primary"></i> Rep Performance Ranking
                    </h2>
                    <p class="text-[10px] opacity-60 mt-0.5">
                        Units sold per rep, with cash held against the 32% plan. A positive variance is cash still in the rep's hands.
                    </p>
                </div>
                <a asp-page="/Reports/Index"
                   asp-route-group_by="SalesRep"
                   asp-route-module="@Model.Result.Module"
                   asp-route-timeframe="@Model.Result.Query.Timeframe"
                   class="btn btn-xs btn-outline border-base-300 rounded-xl font-bold gap-1.5">
                    <i class="fa-solid fa-table-list text-[10px]"></i> Open as table
                </a>
            </div>

            @if (Model.Result.Charts.RepPerformance.Rows.Count == 0)
            {
                <div class="alert rounded-xl text-[11px] py-3">
                    <i class="fa-solid fa-circle-info"></i><span>No reps match the active filters.</span>
                </div>
            }
            else
            {
                <div class="relative h-80 w-full">
                    <canvas id="chart-reps" role="img" aria-label="Horizontal bar chart ranking sales reps by units sold, with cash balance variance"></canvas>
                </div>

                <!-- Companion table so the ranking is readable without hovering. -->
                <div class="overflow-x-auto">
                    <table class="table table-xs w-full text-[11px]">
                        <thead>
                            <tr class="uppercase text-[9px] tracking-wider border-b border-base-300 opacity-70">
                                <th class="text-left py-2">#</th>
                                <th class="text-left">Sales Rep</th>
                                <th class="text-left">Route</th>
                                <th class="text-right">Units Sold</th>
                                <th class="text-right">Volume Share</th>
                                <th class="text-right">Expected</th>
                                <th class="text-right">Collected</th>
                                <th class="text-right">Outstanding</th>
                                <th class="text-right">Cash Variance</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-base-200">
                            @{
                                var rank = 0;
                            }
                            @foreach (var rep in Model.Result.Charts.RepPerformance.Rows)
                            {
                                rank++;
                                <tr class="hover:bg-base-200/60 transition-colors">
                                    <td class="py-1.5 font-mono font-bold opacity-50">@rank</td>
                                    <td class="font-semibold">@rep.RepName</td>
                                    <td class="opacity-70 truncate max-w-40">@rep.Route</td>
                                    <td class="text-right font-mono font-bold">@rep.SoldUnits.ToString("N0")</td>
                                    <td class="text-right font-mono">@rep.VolumeSharePercent.ToString("0.#")%</td>
                                    <td class="text-right font-mono opacity-80">@ReportColumnCatalog.FormatMoney(rep.ExpectedRevenue)</td>
                                    <td class="text-right font-mono opacity-80">@ReportColumnCatalog.FormatMoney(rep.Collected)</td>
                                    <td class="text-right font-mono font-bold @(rep.OutstandingBalance > 0 ? "text-error" : "text-success")">
                                        @ReportColumnCatalog.FormatMoney(rep.OutstandingBalance)
                                    </td>
                                    <td class="text-right font-mono font-bold @(rep.VarianceAmount >= 0 ? "text-warning" : "text-success")">
                                        @ReportColumnCatalog.FormatMoney(rep.VarianceAmount)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- 5. Logistics & fleet (only meaningful when the fleet is in scope) -->
    @if (Model.Result.Charts.Logistics.Rows.Count > 0)
    {
        <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
            <div class="card-body p-5 space-y-3">
                <div>
                    <h2 class="font-bold text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-truck-moving text-primary"></i> Fleet Cost &amp; Delivery Efficiency
                    </h2>
                    <p class="text-[10px] opacity-60 mt-0.5">
                        Fuel, maintenance and trip expenditure per vehicle against units delivered per 100 km.
                    </p>
                </div>
                <div class="relative h-72 w-full">
                    <canvas id="chart-logistics" role="img" aria-label="Stacked bar chart of vehicle fuel, maintenance and trip costs with a delivery efficiency line"></canvas>
                </div>
            </div>
        </div>
    }

    <div class="flex items-center justify-between gap-3 flex-wrap">
        <a href="@Model.ViewUrl("table")" class="btn btn-sm btn-outline border-base-300 rounded-xl font-bold text-xs gap-2">
            <i class="fa-solid fa-table-list text-xs"></i> Switch to Table View
        </a>
        <div class="flex items-center gap-2">
            <a href="@Model.ExportPdfUrl" class="btn btn-sm btn-primary rounded-xl font-bold text-xs gap-2 shadow-xs">
                <i class="fa-solid fa-file-pdf text-xs"></i> Export PDF
            </a>
            <a href="@Model.ExportCsvUrl" class="btn btn-sm btn-outline border-base-300 rounded-xl font-bold text-xs gap-2">
                <i class="fa-solid fa-file-csv text-success text-xs"></i> Export CSV
            </a>
        </div>
    </div>
</div>
