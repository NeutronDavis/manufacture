@model Manufacture.Pages.Dashboard.IndexModel
@using Manufacture.Models.DTOs
@using Manufacture.Models.Entities

@{
    var overview = Model.Overview;

    // "Today" is the landing view; every other window is revealed by the switcher.
    var defaultPeriod = overview.Periods.First();

    string Money(decimal value) => ReportColumnCatalog.FormatMoney(value);

    // The operational week is always Sunday to Saturday, so say so on the toggle.
    string TimeframeLabel(KpiPeriodCardDto period) =>
        period.Key == "This Week" ? "This Week (Sun–Sat)" : period.Label;

    // All six stages in strict funnel order.
    var stageColumns = new (string Label, Func<LifecycleTotalsDto, int> Select, string Subtitle, string Tone, string BgTone, string BorderTone)[]
    {
        ("Orders Placed",        t => t.OrdersPlaced, "Requested by reps",       "text-info",      "bg-info/10",      "border-info/30"),
        ("Produced",             t => t.Produced,     "Plant manufactured",      "text-primary",   "bg-primary/10",   "border-primary/30"),
        ("Loaded / Distributed", t => t.Loaded,       "Physical truck loading",  "text-secondary", "bg-secondary/10", "border-secondary/30"),
        ("Sold",                 t => t.Sold,         "Route verified volume",   "text-success",   "bg-success/10",   "border-success/30"),
        ("Returned",             t => t.Returned,     "Unsold return stock",     "text-warning",   "bg-warning/10",   "border-warning/30"),
        ("Damaged",              t => t.Damaged,      "Reconciliation loss",     "text-error",     "bg-error/10",     "border-error/30")
    };

    int StageValue(LifecycleTotalsDto totals, LifecycleMetric metric) => metric switch
    {
        LifecycleMetric.OrdersPlaced => totals.OrdersPlaced,
        LifecycleMetric.Produced => totals.Produced,
        LifecycleMetric.Loaded => totals.Loaded,
        LifecycleMetric.Sold => totals.Sold,
        LifecycleMetric.Returned => totals.Returned,
        _ => totals.Damaged
    };

    decimal FillRate(LifecycleTotalsDto t) => t.OrdersPlaced <= 0 ? 0m : Math.Round(t.Loaded / (decimal)t.OrdersPlaced * 100m, 1);
    decimal SellThrough(LifecycleTotalsDto t) => t.Loaded <= 0 ? 0m : Math.Round(t.Sold / (decimal)t.Loaded * 100m, 1);
    decimal DamageRate(LifecycleTotalsDto t) => t.Loaded <= 0 ? 0m : Math.Round(t.Damaged / (decimal)t.Loaded * 100m, 1);
    decimal CollectionRate(LifecycleTotalsDto t) => t.ExpectedRevenue <= 0 ? 0m : Math.Round(t.Collected / t.ExpectedRevenue * 100m, 1);

    @* string HealthTone(decimal value, decimal good, decimal warn) =>
        value >= good ? "text-success" : value >= warn ? "text-warning" : "text-error"; *@

    IReadOnlyList<string> LineSkus(ProductLineBreakdownDto line) => line.Line switch
    {
        ProductType.Bread => new[] { "Jumbo Bread", "Medium Bread", "Family Loaf", "Round Bread", "6-in-1" },
        ProductType.Water => new[] { "18.9L Dispenser Bottles", "Pure Water Packs" },
        ProductType.Popcorn => new[] { "Standard Pot Runs", "40g Rack Packages" },
        _ => line.SkuNames
    };

    @* decimal TenderPct(decimal amount, decimal total) =>
        total <= 0 ? 0m : Math.Round(amount / total * 100m, 1); *@
}

<div class="space-y-6" id="exec-overview">   
    @* One panel per window. The switcher reveals the selected panel instantaneously. *@
    @foreach (var period in overview.Periods)
    {
        var totals = period.Totals;
        var lines = overview.ProductLinesByPeriod.GetValueOrDefault(period.Key) ?? new List<ProductLineBreakdownDto>();
        var tender = overview.TenderByPeriod.GetValueOrDefault(period.Key) ?? new TenderSplitDto();
        var alerts = overview.AlertsByPeriod.GetValueOrDefault(period.Key) ?? new List<ExecutiveAlertDto>();
        var isDefault = period.Key == defaultPeriod.Key;

        var fillRateVal = FillRate(totals);
        var sellThroughVal = SellThrough(totals);
        var damageRateVal = DamageRate(totals);
        var collectionRateVal = CollectionRate(totals);

        var tenderSum = tender.Total + tender.Outstanding;
        if (tenderSum <= 0) { tenderSum = totals.ExpectedRevenue > 0 ? totals.ExpectedRevenue : 1m; }

        <div class="exec-period-panel space-y-6 @(isDefault ? "" : "hidden")" data-period-panel="@period.Key">

            <!-- ============ B. Daily Lifecycle Flow Pipeline ============ -->
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
                <div class="card-body p-5 space-y-4">
                    <div class="flex items-center justify-between flex-wrap gap-3 pb-1 border-b border-base-200">
                        <div>
                            <h2 class="font-black text-sm text-base-content flex items-center gap-2">
                                <i class="fa-solid fa-arrows-split-up-and-left text-primary"></i> Lifecycle Flow &bull; @TimeframeLabel(period)
                            </h2>
                            <p class="text-[11px] opacity-65 mt-0.5">
                                Strict 6-stage operational pipeline from initial rep request to return reconciliation. Click any KPI stage to view product orders.
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="badge badge-primary badge-soft badge-sm font-bold">@period.RepCount Sales Reps Active</span>
                            <span class="badge badge-neutral badge-soft badge-sm font-mono font-bold">@totals.TicketCount Tickets</span>
                        </div>
                    </div>

                    <!-- 6-Stage Sequential Pipeline Cards: Clicking ANY stage opens the Product Orders Side Bar Drawer! -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3">
                        @for (int i = 0; i < Model.Stages.Count; i++)
                        {
                            var stage = Model.Stages[i];
                            var stageCol = stageColumns[i];
                            var stageVal = StageValue(totals, stage.Metric);
                            var stageNum = i + 1;

                            <div class="relative group cursor-pointer"
                                 onclick="openDrill('all', '@period.Key', '@stage.Metric', 'products')">
                                <div class="card bg-base-100 border border-base-300 rounded-xl hover:border-primary hover:shadow-md transition-all duration-200 h-full p-3.5 space-y-2 flex flex-col justify-between group-hover:-translate-y-0.5">
                                    @* <div class="flex items-center justify-between">
                                        <span class="w-5 h-5 rounded-full @stageCol.BgTone @stageCol.Tone flex items-center justify-center text-[10px] font-black font-mono border @stageCol.BorderTone">
                                            @stageNum
                                        </span>
                                        <i class="@stage.IconClass text-sm @stageCol.Tone"></i>
                                    </div> *@
                                    <div>
                                        <div class="text-[10px] font-bold uppercase tracking-wider opacity-60">@stageCol.Label</div>
                                        <div class="font-mono font-black text-2xl text-base-content tracking-tight mt-0.5">
                                            @stageVal.ToString("N0")
                                        </div>
                                    </div>
                                    <div class="pt-1.5 border-t border-base-200/80 flex items-center justify-between text-[10px] opacity-60">
                                        <span class="truncate">@stageCol.Subtitle</span>
                                        <i class="fa-solid fa-arrow-right text-[8px] opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all text-primary"></i>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- ============ C. Side-by-Side Product Category Cards ============ -->
            <div>
                <div class="flex items-center justify-between mb-3">
                    <h3 class="font-bold text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-boxes-stacked text-primary"></i> Product Line Performance &bull; @TimeframeLabel(period)
                    </h3>
                    <span class="text-[11px] opacity-60">Segmented multi-product yield & reconciliation</span>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                    @foreach (var line in lines)
                    {
                        var t = line.Totals;
                        var skus = LineSkus(line);

                        <div class="card bg-base-100 border border-base-300 shadow-xs hover:border-primary/70 hover:shadow-md transition-all duration-200 rounded-2xl flex flex-col justify-between">
                            <div class="card-body p-5 space-y-4 cursor-pointer"
                                 onclick="openDrill('@line.Line', '@period.Key', null, 'products')">
                                <!-- Card Header -->
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-lg shadow-xs">
                                            <i class="@line.IconClass"></i>
                                        </div>
                                        <div>
                                            <h4 class="font-black text-base tracking-tight text-base-content">@line.LineLabel Line</h4>
                                            <p class="text-[10px] opacity-60">@skus.Count active SKUs</p>
                                        </div>
                                    </div>
                                    @* <span class="badge badge-primary badge-soft font-mono font-bold text-xs px-2.5 py-2">
                                        @line.ShareOfVolumePercent.ToString("0.#")% Share
                                    </span> *@
                                </div>

                                <!-- Cumulative Sold & Revenue Highlights -->
                                <div class="grid grid-cols-2 gap-2 p-3 rounded-xl bg-base-200/60 border border-base-300">
                                    <div>
                                        <div class="text-[9px] font-bold uppercase tracking-wider opacity-60">Units Sold</div>
                                        <div class="font-mono font-black text-xl text-success mt-0.5">@t.Sold.ToString("N0")</div>
                                    </div>
                                    <div>
                                        <div class="text-[9px] font-bold uppercase tracking-wider opacity-60">Gross Revenue</div>
                                        <div class="font-mono font-black text-sm text-base-content mt-1">@Money(t.ExpectedRevenue)</div>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between text-xs px-1">
                                    <span class="font-medium opacity-65">Outstanding Rep Balance:</span>
                                    <span class="font-mono font-bold @(t.OutstandingBalance > 0 ? "text-error" : "text-success")">
                                        @Money(t.OutstandingBalance)
                                    </span>
                                </div>

                                <!-- Micro-Lifecycle Breakdown (6 Stages) -->
                                <div>
                                    <div class="text-[10px] font-bold uppercase tracking-wider opacity-50 mb-2">Micro-Lifecycle Breakdown</div>
                                    <div class="grid grid-cols-3 gap-2 p-2.5 rounded-xl bg-base-200/40 border border-base-300 text-center">
                                        <div>
                                            <div class="text-[8px] font-bold uppercase opacity-55">Orders</div>
                                            <div class="font-mono font-bold text-xs text-info mt-0.5">@t.OrdersPlaced.ToString("N0")</div>
                                        </div>
                                        <div>
                                            <div class="text-[8px] font-bold uppercase opacity-55">Produced</div>
                                            <div class="font-mono font-bold text-xs text-primary mt-0.5">@t.Produced.ToString("N0")</div>
                                        </div>
                                        <div>
                                            <div class="text-[8px] font-bold uppercase opacity-55">Loaded</div>
                                            <div class="font-mono font-bold text-xs text-secondary mt-0.5">@t.Loaded.ToString("N0")</div>
                                        </div>
                                        <div>
                                            <div class="text-[8px] font-bold uppercase opacity-55">Sold</div>
                                            <div class="font-mono font-black text-xs text-success mt-0.5">@t.Sold.ToString("N0")</div>
                                        </div>
                                        <div>
                                            <div class="text-[8px] font-bold uppercase opacity-55">Returned</div>
                                            <div class="font-mono font-bold text-xs text-warning mt-0.5">@t.Returned.ToString("N0")</div>
                                        </div>
                                        <div>
                                            <div class="text-[8px] font-bold uppercase opacity-55">Damaged</div>
                                            <div class="font-mono font-bold text-xs @(t.Damaged > 0 ? "text-error" : "opacity-40") mt-0.5">@t.Damaged.ToString("N0")</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- SKU Breakdown Badges -->
                                <div>
                                    <div class="text-[10px] font-bold uppercase tracking-wider opacity-50 mb-1.5">SKU Breakdown</div>
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var sku in skus)
                                        {
                                            <span class="badge badge-sm badge-ghost bg-base-200 border border-base-300 text-[10px] font-medium py-1">
                                                @sku
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Interactive Card Footer CTA -->
                            <div class="px-5 py-3 bg-base-200/40 border-t border-base-200 rounded-b-2xl flex items-center justify-between">
                                <span class="text-[10px] opacity-60 font-medium">Detailed sales route breakdown</span>
                                <button type="button"
                                        onclick="openDrill('@line.Line', '@period.Key', null, 'reps')"
                                        class="btn btn-xs btn-primary font-bold gap-1.5 rounded-lg shadow-xs hover:gap-2 transition-all">
                                    Rep detail <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    }
</div>

<!-- ============ Interactive Side Bar Slide-Over Drawer ============ -->
<!-- Backdrop Overlay -->
<div id="drill-backdrop"
     class="fixed inset-0 bg-neutral-900/60 backdrop-blur-xs z-50 opacity-0 pointer-events-none transition-opacity duration-300 ease-out"
     onclick="closeDrillDrawer()"></div>

<!-- Drawer Body (Slide-in from Right Edge, Full Screen Height) -->
<aside id="drill-drawer"
       class="fixed top-0 right-0 bottom-0 z-50 w-full max-w-4xl bg-base-100 shadow-2xl border-l border-base-300 flex flex-col h-screen transform translate-x-full transition-transform duration-300 ease-in-out"
       role="dialog" aria-modal="true" aria-labelledby="drill-header-title">

    <!-- Drawer Top Header -->
    <div class="bg-base-100 border-b border-base-300 px-6 py-4 flex items-center justify-between shrink-0">
        <div class="space-y-1">
            <div class="flex items-center gap-2">
                <span id="drill-stage-badge" class="badge badge-primary font-bold text-[10px] uppercase tracking-wider">
                    Orders Placed
                </span>
                <span id="drill-scope-badge" class="badge badge-ghost border border-base-300 font-bold text-[10px]">
                    All Product Lines
                </span>
            </div>
            <h3 class="font-black text-lg text-base-content tracking-tight flex items-center gap-2" id="drill-header-title">
                Today's Product Orders & Allocations
            </h3>
            <p class="text-xs opacity-60" id="drill-caption">
                Showing all product SKU line orders for today.
            </p>
        </div>
        <button type="button"
                onclick="closeDrillDrawer()"
                class="btn btn-sm btn-circle btn-ghost hover:bg-base-200 transition-colors"
                aria-label="Close side bar drawer">
            <i class="fa-solid fa-xmark text-base"></i>
        </button>
    </div>

    <!-- Hidden State Inputs -->
    <input type="hidden" id="drill-metric" value="OrdersPlaced" />
    <input type="hidden" id="drill-period" value="@defaultPeriod.Key" />
    <input type="hidden" id="drill-scope" value="all" />
    <input type="hidden" id="drill-view-mode" value="products" />

    <!-- Drawer Body -->
    <div class="p-6 space-y-5 overflow-y-auto flex-1">
        <!-- Navigation Tabs: Product Orders (SKU List) vs Sales Rep Allocations -->
        <div class="flex items-center justify-between border-b border-base-300 pb-2 flex-wrap gap-2">
            <div class="tabs tabs-boxed bg-base-200/60 p-1 rounded-xl">
                <button type="button"
                        id="tab-btn-products"
                        class="tab tab-sm font-bold text-xs tab-active rounded-lg transition-all"
                        onclick="switchDrillTab('products')">
                    <i class="fa-solid fa-box-open mr-1.5 text-xs"></i> Product Orders (SKU List)
                </button>
                <button type="button"
                        id="tab-btn-reps"
                        class="tab tab-sm font-bold text-xs rounded-lg transition-all"
                        onclick="switchDrillTab('reps')">
                    <i class="fa-solid fa-users mr-1.5 text-xs"></i> Sales Rep Allocations
                </button>
            </div>

            <!-- Instant Search Bar -->
            <div class="relative">
                <i class="fa-solid fa-magnifying-glass text-[10px] opacity-40 absolute left-2.5 top-2.5"></i>
                <input type="text" id="drill-search-input" placeholder="Search product or rep..."
                       class="input input-xs input-bordered pl-7 rounded-xl text-xs w-44 sm:w-56 focus:w-64 transition-all" />
            </div>
        </div>

        <!-- Secondary Filter Controls: Scope & Timeframe Chips -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <!-- Product Scope Switcher -->
            <div class="flex flex-wrap gap-1.5" role="tablist" aria-label="Product scope">
                @foreach (var scope in overview.DrillDownScopes)
                {
                    <button type="button"
                            class="btn btn-xs rounded-xl font-bold text-[11px] drill-scope-btn"
                            data-scope="@scope.ScopeKey"
                            onclick="selectDrillScope(this)">
                        <i class="fa-solid @(scope.ScopeKey == "all" ? "fa-layer-group" : "fa-box") text-[10px]"></i>
                        @scope.ScopeLabel
                    </button>
                }
            </div>

            <!-- Period Switcher (Default: Today) -->
            <div class="join border border-base-300 rounded-xl overflow-hidden p-0.5 bg-base-200/50" role="tablist" aria-label="Period">
                @foreach (var period in overview.Periods)
                {
                    <button type="button"
                            class="btn btn-xs join-item font-bold text-[10px] drill-period-btn @(period.Key == defaultPeriod.Key ? "btn-neutral" : "btn-ghost")"
                            data-period="@period.Key"
                            onclick="selectDrillPeriod(this)">
                        @period.Label
                    </button>
                }
            </div>
        </div>

        <!-- VIEW 1: Product Orders (SKU List) Table -->
        <div id="drill-product-container" class="rounded-xl border border-base-200 bg-base-100 overflow-x-auto shadow-xs">
            <table class="table table-sm w-full text-xs">
                <thead class="bg-base-200/60">
                    <tr class="uppercase text-[10px] tracking-wider border-b border-base-300 opacity-70">
                        <th class="text-left py-2.5">Product / SKU</th>
                        <th class="text-left">Category</th>
                        <th class="text-right">Unit Price</th>
                        <th class="text-right bg-primary/10 text-primary font-black" id="th-product-active-metric">Orders Placed</th>
                        <th class="text-center">Lifecycle Funnel (Ord &rarr; Prod &rarr; Load &rarr; Sold)</th>
                        <th class="text-right">Total Value</th>
                        <th class="text-right w-24">Share</th>
                    </tr>
                </thead>
                <tbody id="drill-product-body" class="divide-y divide-base-200 font-medium">
                    <!-- Dynamic Product Order Rows Rendered via JS -->
                </tbody>
            </table>
        </div>

        <!-- VIEW 2: Sales Rep Allocations Table -->
        <div id="drill-rep-container" class="rounded-xl border border-base-200 bg-base-100 overflow-x-auto shadow-xs hidden">
            <table class="table table-sm w-full text-xs">
                <thead class="bg-base-200/60">
                    <tr class="uppercase text-[10px] tracking-wider border-b border-base-300 opacity-70">
                        <th class="text-left py-2.5">Rep Name</th>
                        <th class="text-left">Vehicle / Route</th>
                        <th class="text-right">Requested<br />Qty</th>
                        <th class="text-right">Loaded<br />Qty</th>
                        <th class="text-right">Sold<br />Qty</th>
                        <th class="text-right">Returned<br />Qty</th>
                        <th class="text-right">Damaged<br />Qty</th>
                        <th class="text-right">Expected<br />Revenue</th>
                        <th class="text-right">Cash<br />Collected</th>
                        <th class="text-right">Outstanding<br />Balance</th>
                    </tr>
                </thead>
                <tbody id="drill-rep-body" class="divide-y divide-base-200 font-medium">
                    <!-- Dynamic Rep Rows Rendered via JS -->
                </tbody>
            </table>
        </div>

    </div>

    <!-- Drawer Sticky Footer -->
    <div class="bg-base-100 border-t border-base-300 px-6 py-3.5 flex items-center justify-between shrink-0 flex-wrap gap-3">
        <div class="text-xs opacity-60 font-medium" id="drill-footer-summary">
            Showing records for Today
        </div>
        <div class="flex items-center gap-2">
            <a id="drill-reports-link" asp-page="/Reports/Index" asp-route-view="table" asp-route-module="Operational"
               asp-route-timeframe="@defaultPeriod.ReportsTimeframe"
               class="btn btn-sm btn-primary rounded-xl font-bold text-xs gap-2 shadow-xs">
                <i class="fa-solid fa-chart-column text-xs"></i> Open in Full Reports
            </a>
            <button type="button"
                    onclick="closeDrillDrawer()"
                    class="btn btn-sm btn-ghost rounded-xl font-bold text-xs">
                Close
            </button>
        </div>
    </div>
</aside>
