@page
@model Manufacture.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In - Main Bakery Terminal";
}
<!DOCTYPE html>
<html lang="en" data-theme="corporate">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- daisyUI 5 + Tailwind CSS 4 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    
    <!-- Artisan ERP Central Theme Stylesheet -->
    <link rel="stylesheet" href="~/css/artisan-erp.css" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Immediate Theme Application from LocalStorage -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('erp_theme') || 'corporate';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body class="bg-base-200 text-base-content min-h-screen flex flex-col justify-between font-sans antialiased select-none">

    <!-- Top Status Bar -->
    <header class="w-full bg-base-100 border-b border-base-300 px-6 py-3 flex justify-between items-center text-xs shadow-xs">
        <!-- Left: Bakery Facility & Shift Pill -->
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-base-200 border border-base-300 flex items-center justify-center text-base-content text-xs font-bold shadow-xs">
                <i class="fa-solid fa-wheat-awn"></i>
            </div>
            <div>
                <span class="font-bold text-base-content text-sm">Industrial Ops - North Plant</span>
            </div>
            <div class="hidden sm:flex items-center gap-1.5 badge badge-warning badge-sm font-semibold">
                <i class="fa-regular fa-sun text-[10px]"></i>
                <span>Morning Shift</span>
            </div>
        </div>

        <!-- Right: Terminal Identifier & Live Connectivity Status -->
        <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
                <div class="font-semibold text-base-content text-[11px]">Terminal POS-04</div>
                <div class="text-[10px] opacity-60">Status: <span class="text-success font-semibold">Online</span></div>
            </div>
            <div class="flex items-center gap-2 opacity-60 text-sm">
                <i class="fa-solid fa-wifi text-xs" title="Connected"></i>
                <i class="fa-regular fa-clock text-xs" title="Sync Time"></i>
            </div>
        </div>
    </header>

    <!-- Main Sign-In Center View -->
    <main class="flex-1 flex flex-col items-center justify-center p-6">
        
        <div class="w-full max-w-sm space-y-6">
            
            <!-- Circular User Avatar Placeholder -->
            <div class="text-center">
                <div class="w-16 h-16 rounded-full bg-base-100 border border-base-300 flex items-center justify-center text-base-content text-2xl mx-auto shadow-xs">
                    <i class="fa-regular fa-user"></i>
                </div>
                <h1 class="text-2xl font-black text-base-content mt-3 tracking-tight">Sign In</h1>
                <p class="text-xs opacity-60 mt-0.5">Access your terminal account</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-error text-xs py-2.5 rounded-xl flex items-center gap-2 shadow-xs">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <!-- Auth Mode 1: Standard Username / Email & Password (Default) -->
            <div id="passwordAuthSection" class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-4">
                <form method="post" asp-page-handler="PasswordLogin" class="space-y-4">
                    
                    <div class="space-y-1.5">
                        <label class="text-xs font-bold text-base-content">Username or Email</label>
                        <input type="text" name="Email" class="input input-sm input-bordered w-full bg-base-200 border-base-300 rounded-xl text-xs py-2.5 px-3 focus:bg-base-100 focus:border-primary" placeholder="Enter username" value="admin@bakery.com" required />
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-xs font-bold text-base-content">Password</label>
                        <div class="relative">
                            <input type="password" id="passwordInput" name="Password" class="input input-sm input-bordered w-full bg-base-200 border-base-300 rounded-xl text-xs py-2.5 px-3 pr-10 focus:bg-base-100 focus:border-primary" placeholder="Enter password" value="Password123!" required />
                            <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 pr-3 flex items-center opacity-60 hover:opacity-100">
                                <i id="passwordEyeIcon" class="fa-regular fa-eye text-xs"></i>
                            </button>
                        </div>
                        <div class="text-right">
                            <a href="javascript:void(0)" onclick="alert('Contact the Super Admin to reset your terminal passcode.');" class="text-[11px] opacity-70 hover:underline">Forgot Password?</a>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-neutral w-full rounded-xl font-bold py-2.5 text-xs shadow-xs">
                        Login
                    </button>
                </form>

                <div class="text-center pt-1">
                    <button type="button" onclick="toggleAuthMode('pin')" class="text-xs text-primary hover:underline font-bold">
                        Sign in with POS PIN instead
                    </button>
                </div>
            </div>

            <!-- Auth Mode 2: 6-Digit PIN Keypad Mode -->
            <div id="pinAuthSection" class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-4 hidden">
                <form method="post" asp-page-handler="PinLogin" class="space-y-4">
                    <div class="space-y-1.5 text-center">
                        <label class="text-xs font-bold text-base-content">Enter 6-Digit Numeric POS PIN</label>
                        <input type="password" id="pinInput" name="PinCode" maxlength="6" class="input input-bordered w-full bg-base-200 border-base-300 rounded-xl text-center text-2xl font-mono tracking-widest font-bold py-2 focus:bg-base-100 focus:border-primary" placeholder="••••••" required />
                    </div>

                    <!-- Touch Keypad Grid -->
                    <div class="grid grid-cols-3 gap-2 py-1">
                        @for (int i = 1; i <= 9; i++)
                        {
                            var num = i;
                            <button type="button" onclick="appendPin('@num')" class="btn btn-outline border-base-300 hover:bg-base-200 rounded-xl font-bold text-lg py-2">@num</button>
                        }
                        <button type="button" onclick="clearPin()" class="btn btn-ghost rounded-xl font-bold text-xs">CLR</button>
                        <button type="button" onclick="appendPin('0')" class="btn btn-outline border-base-300 hover:bg-base-200 rounded-xl font-bold text-lg py-2">0</button>
                        <button type="button" onclick="backspacePin()" class="btn btn-ghost text-error rounded-xl"><i class="fa-solid fa-delete-left text-sm"></i></button>
                    </div>

                    <button type="submit" class="btn btn-primary w-full rounded-xl font-bold py-2.5 text-xs shadow-xs">
                        <i class="fa-solid fa-right-to-bracket mr-1"></i> Verify PIN
                    </button>
                </form>

                <div class="text-center pt-1">
                    <button type="button" onclick="toggleAuthMode('password')" class="text-xs text-primary hover:underline font-bold">
                        Sign in with Password instead
                    </button>
                </div>
            </div>

        </div>
    </main>

    <!-- Bottom System Status Footer -->
    <footer class="w-full bg-base-100 border-t border-base-300 px-6 py-2.5 flex flex-col sm:flex-row justify-between items-center text-[11px] opacity-70 gap-2">
        <div>
            <span>BakeryFlow ERP v4.2.0 | Station: MAIN-01</span>
        </div>

        <div class="flex items-center gap-4 font-semibold">
            <a href="javascript:void(0)" onclick="alert('Help Desk Support: Contact IT on internal extension #401');" class="hover:underline">Help Desk</a>
            <span class="opacity-30">&bull;</span>
            <span class="cursor-pointer" title="Local cache ready">Offline Cache</span>
            <span class="opacity-30">&bull;</span>
            
            <!-- Switch User / Quick Role Test Dropdown -->
            <div class="dropdown dropdown-top dropdown-end">
                <div tabindex="0" role="button" class="text-primary font-bold flex items-center gap-1 cursor-pointer hover:underline">
                    <i class="fa-solid fa-users text-[10px]"></i> Quick Test Roles
                </div>
                <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-2xl z-50 w-56 p-2 shadow-xl border border-base-300 text-xs mb-2">
                    <li class="menu-title text-[10px] uppercase font-bold opacity-60">Quick Test Any Role:</li>
                    <li><a asp-page-handler="SwitchRole" asp-route-role="SuperAdmin" class="rounded-xl"><i class="fa-solid fa-crown text-amber-500"></i> Super Admin</a></li>
                    <li><a asp-page-handler="SwitchRole" asp-route-role="ProductionManager" class="rounded-xl"><i class="fa-solid fa-industry text-blue-500"></i> Production Mgr</a></li>
                    <li><a asp-page-handler="SwitchRole" asp-route-role="StoreManager" class="rounded-xl"><i class="fa-solid fa-warehouse text-emerald-500"></i> Store Keeper</a></li>
                    <li><a asp-page-handler="SwitchRole" asp-route-role="SalesRep" class="rounded-xl"><i class="fa-solid fa-cash-register text-purple-500"></i> Sales Rep (POS)</a></li>
                    <li><a asp-page-handler="SwitchRole" asp-route-role="Vendor" class="rounded-xl"><i class="fa-solid fa-store text-orange-500"></i> Vendor / Client</a></li>
                    <li><a asp-page-handler="SwitchRole" asp-route-role="HrPayrollManager" class="rounded-xl"><i class="fa-solid fa-users text-rose-500"></i> HR & Payroll</a></li>
                </ul>
            </div>
        </div>
    </footer>

    <script>
        function setErpTheme(themeName) {
            localStorage.setItem('erp_theme', themeName);
            document.documentElement.setAttribute('data-theme', themeName);
            const text = document.getElementById('loginThemeText');
            if (text) text.innerText = themeName;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const currentTheme = localStorage.getItem('erp_theme') || 'corporate';
            const text = document.getElementById('loginThemeText');
            if (text) text.innerText = currentTheme;
        });

        function togglePasswordVisibility() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('passwordEyeIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        function toggleAuthMode(mode) {
            const passSec = document.getElementById('passwordAuthSection');
            const pinSec = document.getElementById('pinAuthSection');
            if (mode === 'pin') {
                passSec.classList.add('hidden');
                pinSec.classList.remove('hidden');
                document.getElementById('pinInput').focus();
            } else {
                pinSec.classList.add('hidden');
                passSec.classList.remove('hidden');
            }
        }

        function appendPin(digit) {
            const input = document.getElementById('pinInput');
            if (input.value.length < 6) {
                input.value += digit;
            }
        }

        function clearPin() {
            document.getElementById('pinInput').value = '';
        }

        function backspacePin() {
            const input = document.getElementById('pinInput');
            input.value = input.value.slice(0, -1);
        }
    </script>
</body>
</html>
