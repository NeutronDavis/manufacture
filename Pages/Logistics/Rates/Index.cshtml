@page
@model Manufacture.Pages.Logistics.Rates.IndexModel
@{
    ViewData["Title"] = "360° Statewide Route Rate Matrix";
}

<div class="space-y-6">
    <!-- Breadcrumbs & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs breadcrumbs p-0 mb-1">
                <ul>
                    <li><a asp-page="/Dashboard/Index" class="opacity-60">Dashboard</a></li>
                    <li><a asp-page="/Logistics/Index" class="opacity-60">Logistics & Fleet</a></li>
                    <li class="font-bold text-base-content">Route Pricing Matrix</li>
                </ul>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-black text-lg">
                    <i class="fa-solid fa-map-location-dot"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-base-content tracking-tight">360° Statewide Route Pricing Matrix</h1>
                    <p class="text-xs text-base-content/60">Standardized interstate haulage and VIP escort rates across Nigeria (With Fuel vs. Without Fuel)</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <a asp-page="/Logistics/Charter/Create" class="btn btn-outline btn-sm rounded-xl gap-2 font-bold text-xs">
                <i class="fa-solid fa-calculator"></i> Book Charter / Quote
            </a>
            <a asp-page="/Logistics/Rates/Create" class="btn btn-neutral btn-sm rounded-xl gap-2 font-bold text-xs shadow-xs">
                <i class="fa-solid fa-plus"></i> Add Route Rate
            </a>
        </div>
    </div>

    <!-- Metric KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Configured Lanes</div>
                <div class="w-8 h-8 rounded-xl bg-base-200 flex items-center justify-center text-xs font-bold text-base-content">
                    <i class="fa-solid fa-route"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-base-content">@Model.TotalRoutesCount</div>
            <div class="text-[11px] text-base-content/50 mt-1">@Model.ActiveLanesCount active operational corridors</div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Avg. Rate (With Fuel)</div>
                <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-gas-pump"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-emerald-600">₦@Model.AvgRateWithFuel.ToString("N0")</div>
            <div class="text-[11px] text-base-content/50 mt-1">Full-service company fueled trips</div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Avg. Rate (Freight Only)</div>
                <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-blue-600">₦@Model.AvgRateWithoutFuel.ToString("N0")</div>
            <div class="text-[11px] text-base-content/50 mt-1">Client supplies diesel for run</div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Fuel Surcharge Spread</div>
                <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-amber-600">₦@((Model.AvgRateWithFuel - Model.AvgRateWithoutFuel).ToString("N0"))</div>
            <div class="text-[11px] text-base-content/50 mt-1">Average diesel budget allowance</div>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
        <form method="get" class="flex flex-col md:flex-row items-center gap-3 justify-between">
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                <div class="relative w-full sm:w-80">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-xs text-base-content/40"></i>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Search origin, destination or truck..." 
                           class="input input-sm input-bordered w-full pl-9 rounded-xl text-xs" />
                </div>

                <select name="VehicleFilter" class="select select-sm select-bordered w-full sm:w-56 rounded-xl text-xs" onchange="this.form.submit()">
                    <option value="">All Vehicle Classes</option>
                    @foreach (var type in Model.AvailableVehicleTypes)
                    {
                        <option value="@type" selected="@(Model.VehicleFilter == type)">@type</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2 w-full md:w-auto justify-end">
                <button type="submit" class="btn btn-sm btn-neutral rounded-xl text-xs px-4">
                    <i class="fa-solid fa-filter"></i> Filter
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.VehicleFilter))
                {
                    <a asp-page="/Logistics/Rates/Index" class="btn btn-sm btn-ghost rounded-xl text-xs">
                        Clear
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Rate Matrix Data Table -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="table table-sm text-xs">
                <thead>
                    <tr class="bg-base-200/60 text-base-content font-bold border-b border-base-300">
                        <th class="py-3 px-4">Route Corridor</th>
                        <th class="py-3 px-4">Vehicle Category</th>
                        <th class="py-3 px-4 text-right">With Fuel Rate (₦)</th>
                        <th class="py-3 px-4 text-right">Without Fuel Rate (₦)</th>
                        <th class="py-3 px-4 text-center">Transit Est.</th>
                        <th class="py-3 px-4 text-center">Status</th>
                        <th class="py-3 px-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-base-200">
                    @if (!Model.Rates.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-12 text-base-content/50">
                                <div class="flex flex-col items-center justify-center gap-2">
                                    <i class="fa-solid fa-route text-3xl opacity-30"></i>
                                    <a asp-page="/Logistics/Rates/Create" class="btn btn-xs btn-neutral rounded-lg mt-2 font-bold">
                                        Add Route Rate
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var rate in Model.Rates)
                        {
                            <tr class="hover:bg-base-200/30 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-2 font-bold text-base-content">
                                        <span>@rate.OriginState</span>
                                        <i class="fa-solid fa-arrow-right text-[10px] text-base-content/40"></i>
                                        <span class="text-primary font-black">@rate.DestinationState</span>
                                    </div>
                                    <div class="text-[10px] text-base-content/50">Interstate Commercial Freight Lane</div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="badge badge-sm badge-neutral border-0 font-medium whitespace-nowrap">
                                        @rate.VehicleTypeRequired
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-right font-black text-emerald-600">
                                    ₦@rate.RateWithFuel.ToString("N0")
                                    <div class="text-[10px] font-normal text-emerald-600/70">Company diesel provided</div>
                                </td>
                                <td class="py-3 px-4 text-right font-black text-blue-600">
                                    ₦@rate.RateWithoutFuel.ToString("N0")
                                    <div class="text-[10px] font-normal text-blue-600/70">Client fuels vehicle</div>
                                </td>
                                <td class="py-3 px-4 text-center font-semibold text-base-content/70">
                                    <span class="inline-flex items-center gap-1">
                                        <i class="fa-regular fa-clock text-[10px] opacity-60"></i>
                                        ~@rate.EstimatedHours hrs
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@rate.Id" class="inline">
                                        <button type="submit" class="badge badge-sm @(rate.IsActive ? "badge-success" : "badge-ghost opacity-60") font-bold cursor-pointer hover:opacity-80 transition-opacity">
                                            @(rate.IsActive ? "Active Lane" : "Inactive")
                                        </button>
                                    </form>
                                </td>
                                <td class="py-3 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <a asp-page="/Logistics/Rates/Edit" asp-route-id="@rate.Id"
                                           class="btn btn-ghost btn-xs btn-square text-base-content/70 hover:text-base-content rounded-lg"
                                           title="Edit Rate">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <form method="post" asp-page-handler="DeleteRate" asp-route-id="@rate.Id" class="inline" onsubmit="return confirm('Are you sure you want to delete this route rate?');">
                                            <button type="submit" class="btn btn-ghost btn-xs btn-square text-error hover:bg-error/10 rounded-lg" title="Delete Rate">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

