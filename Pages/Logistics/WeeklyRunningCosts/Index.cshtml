@page
@model Manufacture.Pages.Logistics.WeeklyRunningCosts.IndexModel
@{
    ViewData["Title"] = "Weekly Fleet Fuel & Maintenance Ledger";
    var prevWeek = Model.OperatingWeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.OperatingWeekStart.AddDays(7).ToString("yyyy-MM-dd");
}

<div class="space-y-6">
    <!-- Breadcrumbs & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="text-xs breadcrumbs p-0 mb-1">
                <ul>
                    <li><a asp-page="/Dashboard/Index" class="opacity-60">Dashboard</a></li>
                    <li><a asp-page="/Logistics/Index" class="opacity-60">Logistics & Fleet</a></li>
                    <li class="font-bold text-base-content">Weekly Running Costs</li>
                </ul>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl bg-neutral text-neutral-content flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-calendar-week"></i>
                </div>
                <div>
                    <h1 class="text-xl font-black text-base-content tracking-tight">Weekly Fleet Fuel & Maintenance Ledger</h1>
                    <p class="text-xs text-base-content/60">Sunday-to-Saturday operating week reconciliation of diesel, servicing, and road incidentals</p>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <a asp-page="/Logistics/FuelLogs/Create" asp-route-returnUrl="/Logistics/WeeklyRunningCosts/Index" class="btn btn-outline btn-sm rounded-xl font-bold text-xs gap-1.5">
                <i class="fa-solid fa-gas-pump"></i> Record Fuel Purchase
            </a>
            <a asp-page="/Logistics/Maintenance/Create" asp-route-returnUrl="/Logistics/WeeklyRunningCosts/Index" class="btn btn-neutral btn-sm rounded-xl font-bold text-xs gap-1.5 shadow-xs">
                <i class="fa-solid fa-wrench"></i> Record Maintenance
            </a>
        </div>
    </div>

    <!-- Operating Week Selector Toolbar -->
    <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
            <a asp-page="/Logistics/WeeklyRunningCosts/Index" asp-route-WeekDate="@prevWeek" class="btn btn-sm btn-ghost rounded-xl text-xs gap-1">
                <i class="fa-solid fa-chevron-left text-[10px]"></i> Previous Week
            </a>
            
            <div class="badge badge-neutral badge-lg py-3 px-4 font-black text-xs gap-2 rounded-xl">
                <i class="fa-regular fa-calendar-check"></i>
                <span>Operating Week: @Model.OperatingWeekStart.ToString("ddd, dd MMM") — @Model.OperatingWeekEnd.ToString("ddd, dd MMM yyyy")</span>
            </div>

            <a asp-page="/Logistics/WeeklyRunningCosts/Index" asp-route-WeekDate="@nextWeek" class="btn btn-sm btn-ghost rounded-xl text-xs gap-1">
                Next Week <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </a>
        </div>

        <!-- Custom Date Picker -->
        <form method="get" class="flex items-center gap-2 w-full md:w-auto">
            <label class="text-xs font-bold text-base-content/60 whitespace-nowrap">Jump to Date:</label>
            <input type="date" name="WeekDate" value="@Model.WeekDate" class="input input-sm input-bordered rounded-xl text-xs" onchange="this.form.submit()" />
            <button type="submit" class="btn btn-sm btn-neutral rounded-xl text-xs">Go</button>
            <a asp-page="/Logistics/WeeklyRunningCosts/Index" class="btn btn-sm btn-ghost rounded-xl text-xs">Current Week</a>
        </form>
    </div>

    <!-- KPI Metric Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Weekly Fuel Incurred</div>
                <div class="w-8 h-8 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-gas-pump"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-emerald-600">₦@Model.TotalWeeklyFuel.ToString("N0")</div>
            <div class="text-[11px] text-base-content/50 mt-1">Dispensed at pumps & depots</div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Servicing & Repairs</div>
                <div class="w-8 h-8 rounded-xl bg-blue-500/10 text-blue-600 flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-wrench"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-blue-600">₦@Model.TotalWeeklyMaintenance.ToString("N0")</div>
            <div class="text-[11px] text-base-content/50 mt-1">Workshops, parts & oil changes</div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Trip Incidentals</div>
                <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-road"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-amber-600">₦@Model.TotalWeeklyIncidentals.ToString("N0")</div>
            <div class="text-[11px] text-base-content/50 mt-1">Tolls, driver food & security</div>
        </div>

        <div class="card bg-base-100 border border-base-300 shadow-xs p-4 rounded-2xl">
            <div class="flex items-center justify-between">
                <div class="text-xs font-semibold text-base-content/60">Total Fleet Running Cost</div>
                <div class="w-8 h-8 rounded-xl bg-neutral text-neutral-content flex items-center justify-center text-xs font-bold">
                    <i class="fa-solid fa-receipt"></i>
                </div>
            </div>
            <div class="mt-2 text-2xl font-black text-base-content">₦@Model.GrandTotalWeeklyCost.ToString("N0")</div>
            <div class="text-[11px] text-base-content/50 mt-1">Weekly corporate logistics overhead</div>
        </div>
    </div>

    <!-- Vehicle Expense Matrix Table -->
    <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl overflow-hidden">
        <div class="p-4 border-b border-base-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
            <div>
                <h2 class="text-sm font-black text-base-content">Vehicle Weekly Expense Breakdown</h2>
                <p class="text-[11px] text-base-content/60">Operating week @Model.OperatingWeekStart.ToString("dd MMM") to @Model.OperatingWeekEnd.ToString("dd MMM yyyy")</p>
            </div>
            <span class="badge badge-sm badge-neutral font-bold">@Model.FleetExpenses.Count Fleet Units</span>
        </div>

        <div class="overflow-x-auto">
            <table class="table table-sm text-xs">
                <thead>
                    <tr class="bg-base-200/60 text-base-content font-bold border-b border-base-300">
                        <th class="py-3 px-4">Vehicle Reg</th>
                        <th class="py-3 px-4">Primary Driver</th>
                        <th class="py-3 px-4 text-right">Weekly Fuel Logged (₦)</th>
                        <th class="py-3 px-4 text-right">Servicing & Repairs (₦)</th>
                        <th class="py-3 px-4 text-right">Trip Incidentals (₦)</th>
                        <th class="py-3 px-4 text-right">Total Weekly Running Cost (₦)</th>
                        <th class="py-3 px-4 text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-base-200">
                    @foreach (var exp in Model.FleetExpenses)
                    {
                        var vehicle = Model.AllVehicles.FirstOrDefault(v => v.Id == exp.VehicleId);
                        <tr class="hover:bg-base-200/30 transition-colors">
                            <td class="py-3 px-4">
                                <div class="font-black text-base-content">@exp.VehicleRegNumber</div>
                                <div class="text-[10px] text-base-content/50">
                                    @(vehicle?.MakeAndModel ?? "Fleet Unit") (@(vehicle?.Type ?? "Vehicle"))
                                </div>
                            </td>
                            <td class="py-3 px-4">
                                <div class="font-bold text-base-content">@exp.DriverName</div>
                                <div class="text-[10px] text-base-content/50">
                                    @(vehicle?.DriverPhoneNumber ?? "N/A")
                                </div>
                            </td>
                            <td class="py-3 px-4 text-right font-black @(exp.FuelExpenseTotal > 0 ? "text-emerald-600" : "text-base-content/40")">
                                ₦@exp.FuelExpenseTotal.ToString("N0")
                            </td>
                            <td class="py-3 px-4 text-right font-black @(exp.MaintenanceExpenseTotal > 0 ? "text-blue-600" : "text-base-content/40")">
                                ₦@exp.MaintenanceExpenseTotal.ToString("N0")
                            </td>
                            <td class="py-3 px-4 text-right font-black @(exp.IncidentalsTotal > 0 ? "text-amber-600" : "text-base-content/40")">
                                ₦@exp.IncidentalsTotal.ToString("N0")
                            </td>
                            <td class="py-3 px-4 text-right font-black text-sm text-base-content">
                                ₦@exp.TotalWeeklyRunningCost.ToString("N0")
                            </td>
                            <td class="py-3 px-4 text-center">
                                @if (exp.TotalWeeklyRunningCost > 0)
                                {
                                    <span class="badge badge-xs badge-success font-bold text-[9px]">Active Spend</span>
                                }
                                else
                                {
                                    <span class="badge badge-xs badge-ghost text-base-content/40 text-[9px]">Zero Incurred</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="border-t border-base-300 font-bold bg-base-200/50">
                        <td colspan="2" class="py-3 px-4 text-xs font-black">Corporate Fleet Weekly Totals:</td>
                        <td class="py-3 px-4 text-right text-emerald-600 font-black">₦@Model.TotalWeeklyFuel.ToString("N0")</td>
                        <td class="py-3 px-4 text-right text-blue-600 font-black">₦@Model.TotalWeeklyMaintenance.ToString("N0")</td>
                        <td class="py-3 px-4 text-right text-amber-600 font-black">₦@Model.TotalWeeklyIncidentals.ToString("N0")</td>
                        <td class="py-3 px-4 text-right text-sm font-black text-base-content">₦@Model.GrandTotalWeeklyCost.ToString("N0")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

