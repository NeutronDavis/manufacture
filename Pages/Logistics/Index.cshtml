@page
@model Manufacture.Pages.Logistics.IndexModel
@{
    ViewData["Title"] = "Logistics & Fleet Management";
}

<div class="space-y-6 w-full">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-truck-moving text-stone-900"></i> Fleet & Delivery Logistics
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">
                Delivery vans, truck haulage, daily fuel consumption logs, and maintenance tracking
            </p>
        </div>
        <div class="flex gap-2">
            <a asp-page="/Logistics/FuelLogs/Create" class="btn btn-sm btn-outline border-slate-300 text-slate-700 hover:bg-slate-100 rounded-xl gap-2 font-semibold px-3.5 text-xs">
                <i class="fa-solid fa-gas-pump text-xs"></i> Log Fuel Expense
            </a>
            <a asp-page="/Logistics/Vehicles/Create" class="btn btn-sm btn-neutral bg-stone-900 hover:bg-black text-white border-0 rounded-xl gap-2 font-bold px-4 text-xs shadow-xs">
                <i class="fa-solid fa-plus text-xs"></i> Add Vehicle
            </a>
        </div>
    </div>

    <!-- Fleet Status Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="card bg-white border border-slate-200 shadow-xs rounded-2xl">
            <div class="card-body p-5">
                <div class="text-[10px] uppercase font-bold text-slate-400">Total Delivery Vehicles</div>
                <div class="text-2xl font-black text-slate-900 font-mono mt-1">@Model.Vehicles.Count</div>
                <div class="text-xs text-slate-500 mt-1">Active delivery vans & trucks</div>
            </div>
        </div>
        <div class="card bg-white border border-slate-200 shadow-xs rounded-2xl">
            <div class="card-body p-5">
                <div class="text-[10px] uppercase font-bold text-slate-400">Total Fuel Dispensed</div>
                <div class="text-2xl font-black text-slate-900 font-mono mt-1">@Model.FuelLogs.Sum(f => f.LitresDispensed) Litres</div>
                <div class="text-xs text-slate-500 mt-1">PMS & AGO volume tracked</div>
            </div>
        </div>
        <div class="card bg-white border border-slate-200 shadow-xs rounded-2xl">
            <div class="card-body p-5">
                <div class="text-[10px] uppercase font-bold text-slate-400">Total Fleet Fuel Spend</div>
                <div class="text-2xl font-black text-emerald-700 font-mono mt-1">₦@Model.FuelLogs.Sum(f => f.TotalCost).ToString("N0")</div>
                <div class="text-xs text-slate-500 mt-1">Cumulative fuel expense</div>
            </div>
        </div>
    </div>

    <!-- Vehicles List -->
    <div class="card bg-white border border-slate-200 shadow-xs rounded-2xl overflow-hidden">
        <div class="card-body p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h2 class="font-bold text-sm text-slate-900 flex items-center gap-2">
                    <i class="fa-solid fa-van-shuttle text-slate-500"></i> Company Delivery Vehicles
                </h2>
                <a asp-page="/Logistics/Vehicles/Index" class="btn btn-xs btn-outline border-slate-200 text-slate-700 rounded-xl">View All &rarr;</a>
            </div>

            <div class="overflow-x-auto">
                <table class="table table-sm w-full text-xs">
                    <thead>
                        <tr class="text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-100 bg-slate-50/50">
                            <th>Plate Number</th>
                            <th>Make & Model</th>
                            <th>Vehicle Type</th>
                            <th>Assigned Driver</th>
                            <th>Phone Number</th>
                            <th>Odometer</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var v in Model.Vehicles)
                        {
                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <td class="font-mono text-xs font-bold text-slate-900">@v.RegistrationNumber</td>
                                <td class="font-bold text-slate-900">@v.MakeAndModel</td>
                                <td><span class="badge bg-slate-100 text-slate-700 border-0 text-[10px] font-semibold">@v.Type</span></td>
                                <td class="font-semibold text-slate-800">@v.AssignedDriverName</td>
                                <td class="font-mono text-slate-500">@v.DriverPhoneNumber</td>
                                <td class="font-mono text-slate-700 font-medium">@v.CurrentOdometerKm.ToString("N0") KM</td>
                                <td>
                                    <span class="badge bg-emerald-50 text-emerald-700 border-0 text-[10px] font-bold px-2 py-0.5">● @v.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
