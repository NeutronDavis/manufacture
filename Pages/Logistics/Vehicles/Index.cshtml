@page
@model Manufacture.Pages.Logistics.Vehicles.IndexModel
@{
    ViewData["Title"] = "Delivery Vehicles";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs breadcrumbs mb-1">
                <ul>
                    <li><a asp-page="/Dashboard/Index">Dashboard</a></li>
                    <li><a asp-page="/Logistics/Index">Logistics</a></li>
                    <li class="font-semibold text-primary">Vehicles</li>
                </ul>
            </div>
            <h1 class="text-2xl font-black text-base-content flex items-center gap-2">
                <i class="fa-solid fa-van-shuttle text-primary"></i> Company Delivery Vehicles
            </h1>
            <p class="text-sm text-base-content/60">Manage delivery vans, assigned drivers, and service schedules</p>
        </div>
        <a asp-page="/Logistics/Vehicles/Create" class="btn btn-primary gap-2">
            <i class="fa-solid fa-plus"></i> Register Vehicle
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        @foreach (var v in Model.Vehicles)
        {
            <div class="card bg-base-100 border border-base-300 shadow-xs">
                <div class="card-body p-5 space-y-3">
                    <div class="flex justify-between items-start">
                        <div>
                            <span class="badge badge-primary font-mono font-bold">@v.RegistrationNumber</span>
                            <h2 class="font-bold text-base mt-1">@v.MakeAndModel</h2>
                        </div>
                        <span class="badge @(v.Status == "Active" ? "badge-success" : "badge-warning") badge-xs font-semibold">@v.Status</span>
                    </div>

                    <div class="space-y-2 text-xs text-base-content/80">
                        <div class="flex justify-between">
                            <span class="text-base-content/60">Vehicle Type:</span>
                            <span class="font-bold">@v.Type</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-base-content/60">Assigned Driver:</span>
                            <span class="font-bold">@v.AssignedDriverName</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-base-content/60">Driver Phone:</span>
                            <span class="font-mono">@v.DriverPhoneNumber</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-base-content/60">Fuel Type / Tank:</span>
                            <span>@v.FuelType (@v.TankCapacityLitres L)</span>
                        </div>
                        <div class="flex justify-between font-mono">
                            <span class="text-base-content/60">Odometer:</span>
                            <span class="font-bold">@v.CurrentOdometerKm.ToString("N0") km</span>
                        </div>
                    </div>

                    <div class="pt-3 border-t border-base-200 flex justify-between items-center text-xs">
                        <a asp-page="/Logistics/FuelLogs/Create" asp-route-vehicleId="@v.Id" class="btn btn-xs btn-outline btn-warning">
                            <i class="fa-solid fa-gas-pump"></i> Log Fuel
                        </a>
                        <span class="text-base-content/50">Serviced: @v.LastServiceDate.ToString("yyyy-MM-dd")</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
