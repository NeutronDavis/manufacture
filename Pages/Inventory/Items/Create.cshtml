@page
@model Manufacture.Pages.Inventory.Items.CreateModel
@{
    ViewData["Title"] = "Add Inventory Item";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-slate-400 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:text-slate-600">Home</a>
                <span>&gt;</span>
                <a asp-page="/Inventory/Index" class="hover:text-slate-600">Store Inventory</a>
                <span>&gt;</span>
                <span class="text-slate-700">Add Stock Item</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-plus text-stone-900"></i> Add Stock Item / Raw Material
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">
                Configure warehouse material specifications, cost pricing, and low stock threshold alerts
            </p>
        </div>
        <div>
            <a asp-page="/Inventory/Index" class="text-xs text-slate-500 hover:text-slate-900 font-semibold flex items-center gap-1.5">
                <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to Inventory
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        
        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            <div class="erp-card p-6 space-y-4">
                <div class="flex items-center gap-2 font-bold text-slate-900 text-sm border-b border-slate-100 pb-3">
                    <div class="w-6 h-6 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-box"></i>
                    </div>
                    <span>Item Specifications & Cost Details</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="erp-label">Material / Item Name <span class="text-rose-500">*</span></label>
                        <input type="text" asp-for="ItemInput.Name" class="erp-input" placeholder="e.g. Pure Vegetable Bakery Shortening" required />
                    </div>

                    <div>
                        <label class="erp-label">Item Code <span class="text-rose-500">*</span></label>
                        <input type="text" asp-for="ItemInput.ItemCode" class="erp-input font-mono uppercase" placeholder="e.g. RAW-FAT-02" required />
                    </div>

                    <div>
                        <label class="erp-label">Category</label>
                        <select asp-for="ItemInput.Category" class="erp-select">
                            <option value="Raw Materials">Raw Materials (Flour, Sugar, Yeast)</option>
                            <option value="Packaging">Packaging (Nylon, Clips, Boxes)</option>
                            <option value="Additives">Additives & Flavors</option>
                            <option value="Fuel & Utility">Fuel & Utility</option>
                        </select>
                    </div>

                    <div>
                        <label class="erp-label">Unit of Measurement <span class="text-rose-500">*</span></label>
                        <input type="text" asp-for="ItemInput.Unit" class="erp-input" placeholder="e.g. Bags (50kg), kg, Litres" required />
                    </div>

                    <div>
                        <label class="erp-label">Unit Cost Price (₦) <span class="text-rose-500">*</span></label>
                        <input type="number" step="100" min="0" asp-for="ItemInput.UnitCostPrice" class="erp-input font-mono font-bold" placeholder="e.g. 55000" required />
                    </div>

                    <div>
                        <label class="erp-label">Opening Stock Quantity</label>
                        <input type="number" step="0.1" min="0" asp-for="ItemInput.QuantityInStock" class="erp-input font-mono" value="20" required />
                    </div>

                    <div>
                        <label class="erp-label">Reorder Threshold (Low Stock Alert)</label>
                        <input type="number" step="0.1" min="0" asp-for="ItemInput.ReorderThreshold" class="erp-input font-mono" value="8" required />
                    </div>

                    <div class="sm:col-span-2">
                        <label class="erp-label">Preferred Supplier</label>
                        <select asp-for="ItemInput.PreferredSupplierId" class="erp-select">
                            <option value="">-- Select Preferred Supplier --</option>
                            @foreach (var s in Model.Suppliers)
                            {
                                <option value="@s.Id">@s.Name (@s.SupplyCategory)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Sticky Section (~30% width, 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            <div class="erp-card p-6 space-y-4">
                <div class="font-bold text-slate-900 text-sm">Actions</div>
                <p class="text-xs text-slate-500 leading-relaxed">
                    This material will immediately become available for formulation in Recipe Costing and Store Material Requisitions.
                </p>

                <button type="submit" class="btn-obsidian w-full py-2.5">
                    <i class="fa-solid fa-check text-xs"></i> Save Stock Item
                </button>

                <div class="text-center pt-1">
                    <a asp-page="/Inventory/Index" class="text-xs text-slate-500 hover:text-slate-900 font-medium">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>
