@page
@model Manufacture.Pages.Inventory.Items.CreateModel
@{
    ViewData["Title"] = "Add Inventory Item";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs opacity-60 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:underline">Dashboard</a>
                <span>&gt;</span>
                <a asp-page="/Inventory/Index" class="hover:underline">Store Inventory</a>
                <span>&gt;</span>
                <span class="text-primary font-bold">Add Stock Item</span>
            </div>
            <h1 class="text-2xl font-black text-base-content tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-box-open text-primary"></i> Add Stock Item / Raw Material
            </h1>
            <p class="text-xs opacity-70 mt-0.5">
                Configure warehouse material specifications, cost pricing, and low stock threshold alerts.
            </p>
        </div>
        <div>
            <a asp-page="/Inventory/Index" class="btn btn-sm btn-outline border-base-300 rounded-xl text-xs gap-1.5 font-semibold">
                <i class="fa-solid fa-arrow-left text-xs"></i> Back to Inventory
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        
        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl">
                <div class="card-body p-6 space-y-5">
                    
                    <div class="flex items-center justify-between border-b border-base-200 pb-3">
                        <div class="flex items-center gap-2.5 font-bold text-base-content text-sm">
                            <div class="w-7 h-7 rounded-lg bg-primary text-primary-content flex items-center justify-center text-xs font-bold shadow-xs">
                                <i class="fa-solid fa-box"></i>
                            </div>
                            <span>Item Specifications & Cost Details</span>
                        </div>
                        <span class="badge badge-neutral badge-xs font-bold uppercase tracking-wider">Warehouse SKU</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Material / Item Name <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="ItemInput.Name" class="input input-bordered input-sm w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-medium" placeholder="e.g. Pure Vegetable Bakery Shortening" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Item Code <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="ItemInput.ItemCode" class="input input-bordered input-sm w-full font-mono uppercase bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-bold" placeholder="e.g. RAW-FAT-02" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Category</span>
                            </label>
                            <select asp-for="ItemInput.Category" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-semibold focus:bg-base-100 focus:border-primary">
                                <option value="Raw Materials">Raw Materials (Flour, Sugar, Yeast)</option>
                                <option value="Packaging">Packaging (Nylon, Clips, Tags)</option>
                                <option value="Additives">Additives & Flavors</option>
                                <option value="Fuel & Utility">Fuel & Utility (Oven Gas, Diesel)</option>
                            </select>
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Unit of Measurement <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="text" asp-for="ItemInput.Unit" class="input input-bordered input-sm w-full bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="e.g. Bags (50kg), kg, Litres, Pieces" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">
                                    Unit Cost Price (₦) <span class="text-error">*</span>
                                </span>
                            </label>
                            <input type="number" step="100" min="0" asp-for="ItemInput.UnitCostPrice" class="input input-bordered input-sm w-full font-mono font-bold bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary" placeholder="e.g. 55000" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Opening Stock Quantity</span>
                            </label>
                            <input type="number" step="0.1" min="0" asp-for="ItemInput.QuantityInStock" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary font-bold" value="20" required />
                        </div>

                        <div class="form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Reorder Threshold (Low Stock Alert)</span>
                            </label>
                            <input type="number" step="0.1" min="0" asp-for="ItemInput.ReorderThreshold" class="input input-bordered input-sm w-full font-mono bg-base-200 border-base-300 rounded-xl text-xs focus:bg-base-100 focus:border-primary text-warning font-bold" value="8" required />
                        </div>

                        <div class="sm:col-span-2 form-control w-full">
                            <label class="label pb-1.5">
                                <span class="label-text font-bold text-xs text-base-content">Preferred Supplier</span>
                            </label>
                            <select asp-for="ItemInput.PreferredSupplierId" class="select select-bordered select-sm w-full bg-base-200 border-base-300 rounded-xl text-xs font-medium focus:bg-base-100 focus:border-primary">
                                <option value="">-- Select Preferred Supplier --</option>
                                @foreach (var s in Model.Suppliers)
                                {
                                    <option value="@s.Id">@s.Name (@s.SupplyCategory)</option>
                                }
                            </select>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Right Sticky Section (~30% width, 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            
            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-6 space-y-5">
                <div class="flex items-center justify-between border-b border-base-200 pb-3">
                    <h2 class="font-black text-sm text-base-content flex items-center gap-2">
                        <i class="fa-solid fa-warehouse text-primary"></i> Stock Tracking
                    </h2>
                    <span class="badge badge-success badge-xs font-bold">Active</span>
                </div>

                <p class="text-[11px] opacity-70 leading-relaxed">
                    Adding this material registers it into the warehouse ledger, allowing production managers to include it in recipe formulation and issue requisitions.
                </p>

                <div class="space-y-2 pt-2 border-t border-base-200">
                    <button type="submit" class="btn btn-neutral w-full rounded-xl font-bold py-2.5 text-xs shadow-xs gap-2">
                        <i class="fa-solid fa-circle-check text-success text-xs"></i> Save Stock Item
                    </button>

                    <a asp-page="/Inventory/Index" class="btn btn-ghost w-full rounded-xl text-xs font-semibold">
                        Cancel
                    </a>
                </div>
            </div>

            <div class="card bg-base-100 border border-base-300 shadow-xs rounded-2xl p-5 text-xs space-y-2">
                <div class="font-bold text-base-content flex items-center gap-2">
                    <i class="fa-solid fa-bell text-warning"></i> Reorder Threshold Alert
                </div>
                <p class="text-[11px] opacity-70 leading-relaxed">
                    When warehouse stock dips below the reorder threshold, automated restock alerts will trigger on the dashboard and inventory overview.
                </p>
            </div>

        </div>
    </form>
</div>
