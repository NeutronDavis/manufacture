@page
@model Manufacture.Pages.Inventory.Suppliers.CreateModel
@{
    ViewData["Title"] = "Register Supplier";
}

<div class="space-y-6 w-full">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="text-xs text-slate-400 mb-1 flex items-center gap-1.5 font-medium">
                <a asp-page="/Dashboard/Index" class="hover:text-slate-600">Home</a>
                <span>&gt;</span>
                <a asp-page="/Inventory/Suppliers/Index" class="hover:text-slate-600">Suppliers</a>
                <span>&gt;</span>
                <span class="text-slate-700">Add Supplier</span>
            </div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-handshake text-stone-900"></i> Register Supplier / Vendor
            </h1>
            <p class="text-xs text-slate-500 mt-0.5">
                Register raw material mills, packaging printers, and equipment suppliers
            </p>
        </div>
        <div>
            <a asp-page="/Inventory/Suppliers/Index" class="text-xs text-slate-500 hover:text-slate-900 font-semibold flex items-center gap-1.5">
                <i class="fa-solid fa-arrow-left text-[10px]"></i> Back to Suppliers
            </a>
        </div>
    </div>

    <!-- Standard 2-Column Full-Width Form Layout -->
    <form method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start w-full">
        
        <!-- Left Section (~70% width, 8 Cols) -->
        <div class="lg:col-span-8 space-y-6">
            <div class="erp-card p-6 space-y-4">
                <div class="flex items-center gap-2 font-bold text-slate-900 text-sm border-b border-slate-100 pb-3">
                    <div class="w-6 h-6 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center text-xs">
                        <i class="fa-solid fa-building"></i>
                    </div>
                    <span>Supplier Company & Representative Details</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="erp-label">Supplier / Company Name <span class="text-rose-500">*</span></label>
                        <input type="text" asp-for="SupplierInput.Name" class="erp-input" placeholder="e.g. Flour Mills of Nigeria PLC" required />
                    </div>

                    <div>
                        <label class="erp-label">Contact Person <span class="text-rose-500">*</span></label>
                        <input type="text" asp-for="SupplierInput.ContactPerson" class="erp-input" placeholder="e.g. Alhaji Shehu Garba" required />
                    </div>

                    <div>
                        <label class="erp-label">Supply Category</label>
                        <select asp-for="SupplierInput.SupplyCategory" class="erp-select">
                            <option value="Flour & Grains">Flour & Grains</option>
                            <option value="Packaging (Nylon & Tags)">Packaging (Nylon & Tags)</option>
                            <option value="Sweeteners & Yeast">Sweeteners & Yeast</option>
                            <option value="Fats & Oils">Fats & Oils</option>
                            <option value="Equipment & Maintenance">Equipment & Maintenance</option>
                        </select>
                    </div>

                    <div>
                        <label class="erp-label">Phone Number <span class="text-rose-500">*</span></label>
                        <input type="tel" asp-for="SupplierInput.PhoneNumber" class="erp-input" placeholder="+234 80..." required />
                    </div>

                    <div>
                        <label class="erp-label">Email Address</label>
                        <input type="email" asp-for="SupplierInput.Email" class="erp-input" placeholder="sales@supplier.com" />
                    </div>

                    <div class="sm:col-span-2">
                        <label class="erp-label">Office / Warehouse Address</label>
                        <textarea asp-for="SupplierInput.Address" class="erp-textarea" rows="2" placeholder="Warehouse address, port or depot"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Sticky Section (~30% width, 4 Cols) -->
        <div class="lg:col-span-4 space-y-6 lg:sticky lg:top-20">
            <div class="erp-card p-6 space-y-4">
                <div class="font-bold text-slate-900 text-sm">Actions</div>
                <p class="text-xs text-slate-500 leading-relaxed">
                    Supplier will be listed in preferred vendor directories and linked to purchase orders.
                </p>

                <button type="submit" class="btn-obsidian w-full py-2.5">
                    <i class="fa-solid fa-check text-xs"></i> Save Supplier Profile
                </button>

                <div class="text-center pt-1">
                    <a asp-page="/Inventory/Suppliers/Index" class="text-xs text-slate-500 hover:text-slate-900 font-medium">Cancel</a>
                </div>
            </div>
        </div>
    </form>
</div>
